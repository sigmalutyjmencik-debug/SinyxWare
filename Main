    local btnGui = CG:FindFirstChild("SinyxWareMobileButtons")
    if not btnGui then
        btnGui = Instance.new("ScreenGui")
        btnGui.Name = "SinyxWareMobileButtons"
        btnGui.ResetOnSpawn = false
        btnGui.Parent = CG
    end
    mobileButton = Instance.new("ImageButton")
    mobileButton.Size = UDim2.new(0, 50, 0, 50)
    mobileButton.Position = UDim2.new(1, -60, 0.5, -25)
    mobileButton.Image = "rbxassetid://73073995075962"
    mobileButton.BackgroundTransparency = 1
    mobileButton.Parent = btnGui
    mobileButton.ZIndex = 999
    local dragMob = {active=false, start=nil, offset=nil}
    mobileButton.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch then
            dragMob.active = true; dragMob.start = input.Position; dragMob.offset = mobileButton.Position
        end
    end)
    mobileButton.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch then dragMob.active = false end
    end)
    UIS.InputChanged:Connect(function(input)
        if dragMob.active and input.UserInputType == Enum.UserInputType.Touch then
            local delta = input.Position - dragMob.start
            mobileButton.Position = UDim2.new(dragMob.offset.X.Scale, dragMob.offset.X.Offset + delta.X, dragMob.offset.Y.Scale, dragMob.offset.Y.Offset + delta.Y)
        end
    end)
    local function toggleGUI()
        visible = not visible
        Outer.Visible = visible
        -- РљСЂСѓР¶РѕРє Р°РёРјР±РѕС‚Р°, РјРѕР±РёР»СЊРЅР°СЏ РєРЅРѕРїРєР° Рё РєРЅРѕРїРєР° Р°РёРјР° РќР• СЃРєСЂС‹РІР°СЋС‚СЃСЏ
    end
    mobileButton.MouseButton1Click:Connect(toggleGUI)
    mobileButton.TouchTap:Connect(toggleGUI)
end

