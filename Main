local function setTab(name)
    curTab=name
    for n,t in pairs(TabBtns) do
        local on=n==name
        t.bar.BackgroundTransparency=on and 0 or 1
        t.ico.TextColor3=on and Color3.fromRGB(255,120,210) or Color3.fromRGB(120,90,115)
        t.lbl.TextColor3=on and Color3.fromRGB(240,220,235) or Color3.fromRGB(120,90,115)
        TS:Create(t.bg,TweenInfo.new(0.15),{BackgroundTransparency=on and 0.82 or 1}):Play()
    end
    for n,f in pairs(TabContent) do f.Visible=n==name end
end

for i,tab in ipairs(TABS) do
    local tH = MOBILE and 46 or 36
    local btn=Instance.new("TextButton",navF)
