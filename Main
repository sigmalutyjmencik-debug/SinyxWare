    local btn = Instance.new("TextButton", TabContainer)
    btn.Size = UDim2.new(0.25, 0, 1, 0)
    btn.BackgroundTransparency = 1
    btn.BorderSizePixel = 0
    btn.Text = tab.icon .. " " .. tab.name
    btn.TextColor3 = i == 1 and Pink.medium or Pink.textDim
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 14
    btn.AutoButtonColor = false
    btn.ZIndex = 2
    
    local underline = Instance.new("Frame", btn)
    underline.Size = UDim2.new(0.6, 0, 0, 2)
    underline.Position = UDim2.new(0.2, 0, 1, -2)
    underline.BackgroundColor3 = Pink.medium
    underline.BorderSizePixel = 0
    underline.BackgroundTransparency = i == 1 and 0 or 1
    Instance.new("UICorner", underline).CornerRadius = UDim.new(1, 0)
    
    TabBtns[tab.name] = {btn = btn, underline = underline}
    
    btn.MouseButton1Click:Connect(function()
        for n, t in pairs(TabBtns) do
            t.underline.BackgroundTransparency = 1
            t.btn.TextColor3 = Pink.textDim
        end
        underline.BackgroundTransparency = 0
        btn.TextColor3 = Pink.medium
        activeTab = tab.name
        for n, f in pairs(TabFrames) do
            f.Visible = n == tab.name
        end
    end)
    btn.TouchTap:Connect(function()
        for n, t in pairs(TabBtns) do
            t.underline.BackgroundTransparency = 1
            t.btn.TextColor3 = Pink.textDim
        end
        underline.BackgroundTransparency = 0
        btn.TextColor3 = Pink.medium
        activeTab = tab.name
        for n, f in pairs(TabFrames) do
            f.Visible = n == tab.name
        end
    end)
end

