    local mobileSection = mkSection(CL, "Mobile Controls", 2)
    mkToggle(mobileSection, "Aim Button", false, function(val)
        snowButtonEnabled = val
        if val then
            if snowButtonObj then snowButtonObj:Destroy() end
            local btnGui = CG:FindFirstChild("SinyxWareMobileButtons")
            if not btnGui then
                btnGui = Instance.new("ScreenGui")
                btnGui.Name = "SinyxWareMobileButtons"
                btnGui.ResetOnSpawn = false
                btnGui.Parent = CG
            end
            snowButtonObj = Instance.new("ImageButton")
            snowButtonObj.Size = UDim2.new(0,55,0,55)
            snowButtonObj.Position = UDim2.new(0.1,0,0.5,-27)
            snowButtonObj.Image = "rbxassetid://73073995075962"
            snowButtonObj.BackgroundColor3 = aimbotEnabled and C.green or C.red
            snowButtonObj.BackgroundTransparency = 0.3
            snowButtonObj.Parent = btnGui
            snowButtonObj.ZIndex = 999
            corner(snowButtonObj, 27)
            -- РџРµСЂРµС‚Р°СЃРєРёРІР°РЅРёРµ СЃ Р±Р»РѕРєРёСЂРѕРІРєРѕР№ РїСЂРё lockButtonEnabled
            local dragSnow = {active=false, start=nil, offset=nil}
            snowButtonObj.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.Touch then
                    if lockButtonEnabled then return end -- Р·Р°РїСЂРµС‚ РїРµСЂРµС‚Р°СЃРєРёРІР°РЅРёСЏ
                    dragSnow.active = true
                    dragSnow.start = input.Position
                    dragSnow.offset = snowButtonObj.Position
                end
            end)
            snowButtonObj.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.Touch then dragSnow.active = false end
            end)
            UIS.InputChanged:Connect(function(input)
                if dragSnow.active and input.UserInputType == Enum.UserInputType.Touch then
                    local delta = input.Position - dragSnow.start
                    snowButtonObj.Position = UDim2.new(dragSnow.offset.X.Scale, dragSnow.offset.X.Offset + delta.X, dragSnow.offset.Y.Scale, dragSnow.offset.Y.Offset + delta.Y)
                end
            end)
            -- РњРіРЅРѕРІРµРЅРЅРѕРµ СЃСЂР°Р±Р°С‚С‹РІР°РЅРёРµ РїРѕ РЅР°Р¶Р°С‚РёСЋ (MouseButton1Down / TouchBegan)
            local function onPress()
                aimbotEnabled = not aimbotEnabled
                if lockButtonEnabled then
                    -- РџСЂРё Р»РѕРєРµ: РЅРµ СЃР±СЂР°СЃС‹РІР°РµРј С†РµР»СЊ РїСЂРё РІС‹РєР»СЋС‡РµРЅРёРё
                    snowButtonObj.BackgroundColor3 = aimbotEnabled and C.yellow or Color3.fromRGB(180, 60, 60)
                else
                    snowButtonObj.BackgroundColor3 = aimbotEnabled and C.green or C.red
                    if not aimbotEnabled then lockTarget = nil end
                end
            end
            snowButtonObj.MouseButton1Down:Connect(onPress)
            snowButtonObj.TouchBegan:Connect(onPress)
        else
            if snowButtonObj then snowButtonObj:Destroy(); snowButtonObj = nil end
        end
    end)
    mkToggle(mobileSection, "Lock Button", false, function(val)
        lockButtonEnabled = val
        if snowButtonObj then
            -- Р’РёР·СѓР°Р»СЊРЅРѕ РїРѕРєР°Р·С‹РІР°РµРј С‡С‚Рѕ РєРЅРѕРїРєР° Р·Р°Р»РѕС‡РµРЅР°
            snowButtonObj.BackgroundColor3 = val and C.yellow or (aimbotEnabled and C.green or C.red)
            -- Р—Р°РїСЂРµС‚ РїРµСЂРµС‚Р°СЃРєРёРІР°РЅРёСЏ СѓР¶Рµ СЂРµР°Р»РёР·РѕРІР°РЅ С‡РµСЂРµР· if lockButtonEnabled then return end РІ InputBegan
        end
        if not val then lockTarget = nil end
    end)
end

