    local mobileButton = Instance.new("ImageButton")
    mobileButton.Size = UDim2.new(0, 50, 0, 50)
    mobileButton.Position = UDim2.new(1, -60, 0.5, -25)
    mobileButton.Image = "rbxassetid://73073995075962"
    mobileButton.BackgroundTransparency = 1
    mobileButton.Parent = btnGui
    mobileButton.ZIndex = 999

    local btnDrag = {active = false, start = nil, offset = nil}
    mobileButton.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.Touch then
            btnDrag.active = true
            btnDrag.start = i.Position
            btnDrag.offset = mobileButton.Position
        end
    end)
    mobileButton.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.Touch then btnDrag.active = false end
    end)
    UIS.InputChanged:Connect(function(i)
        if btnDrag.active and i.UserInputType == Enum.UserInputType.Touch then
            local delta = i.Position - btnDrag.start
            mobileButton.Position = UDim2.new(
                btnDrag.offset.X.Scale, btnDrag.offset.X.Offset + delta.X,
                btnDrag.offset.Y.Scale, btnDrag.offset.Y.Offset + delta.Y
            )
        end
    end)

    local function toggleGUI()
        Root.Enabled = not Root.Enabled
        circle.Visible = Root.Enabled and cfg.showCircle
    end
    mobileButton.MouseButton1Click:Connect(toggleGUI)
    mobileButton.TouchTap:Connect(toggleGUI)
end

-- ================================================================
--  ХОТКЕИ (ПК)
-- ================================================================
UIS.InputBegan:Connect(function(i, gpe)
    if gpe then return end
    if i.KeyCode == Enum.KeyCode.Insert then
        Root.Enabled = not Root.Enabled
        circle.Visible = Root.Enabled and cfg.showCircle
    end
end)

Root.Enabled = true
print("SinyxWare v8.0 loaded. Press Insert to toggle GUI.")
