-- РўРѕРіРіР»
local function mkTog(parent,label,def,cb)
    local rH=MOBILE and 44 or 28
    local row=Instance.new("Frame",parent)
    row.Size=UDim2.new(1,0,0,rH); row.BackgroundTransparency=1

    local lbl=Instance.new("TextLabel",row)
    lbl.Size=UDim2.new(1,-44,1,0); lbl.Position=UDim2.new(0,10,0,0)
    lbl.BackgroundTransparency=1; lbl.Text=label
    lbl.TextColor3=Color3.fromRGB(220,200,218)
    lbl.Font=Enum.Font.Gotham
    lbl.TextSize=MOBILE and 12 or 9
    lbl.TextXAlignment=Enum.TextXAlignment.Left

    local pill=Instance.new("TextButton",row)
    pill.Size=UDim2.new(0,34,0,18); pill.Position=UDim2.new(1,-40,0.5,-9)
    pill.BackgroundColor3=def and Color3.fromRGB(200,60,170) or Color3.fromRGB(55,30,60)
    pill.BorderSizePixel=0; pill.Text=""; pill.AutoButtonColor=false; crn(pill,9)
    if def then
        local pg=Instance.new("UIGradient",pill)
        pg.Color=ColorSequence.new({
            ColorSequenceKeypoint.new(0,Color3.fromRGB(255,130,220)),
            ColorSequenceKeypoint.new(1,Color3.fromRGB(170,40,140)),
        })
    end

    local knob=Instance.new("Frame",pill)
    knob.Size=UDim2.new(0,12,0,12)
    knob.Position=def and UDim2.new(1,-14,0.5,-6) or UDim2.new(0,2,0.5,-6)
    knob.BackgroundColor3=Color3.fromRGB(255,255,255); knob.BorderSizePixel=0; crn(knob,6)

    local val=def
    local function tog()
        val=not val
        TS:Create(pill,TweenInfo.new(0.2,Enum.EasingStyle.Quad),{
            BackgroundColor3=val and Color3.fromRGB(200,60,170) or Color3.fromRGB(55,30,60)
        }):Play()
        TS:Create(knob,TweenInfo.new(0.2,Enum.EasingStyle.Quad),{
            Position=val and UDim2.new(1,-14,0.5,-6) or UDim2.new(0,2,0.5,-6)
        }):Play()
        if cb then cb(val) end
    end
    pill.MouseButton1Click:Connect(tog)
    pill.TouchTap:Connect(tog)
    return row
end

-- РЎР»Р°Р№РґРµСЂ
local function mkSlider(parent,label,mn,mx,def,cb)
    local rH=MOBILE and 52 or 38
    local w=Instance.new("Frame",parent)
    w.Size=UDim2.new(1,0,0,rH); w.BackgroundTransparency=1

    local lbl=Instance.new("TextLabel",w)
    lbl.Size=UDim2.new(1,-10,0,MOBILE and 18 or 14); lbl.Position=UDim2.new(0,10,0,3)
    lbl.BackgroundTransparency=1; lbl.Text=label
    lbl.TextColor3=Color3.fromRGB(220,200,218)
    lbl.Font=Enum.Font.Gotham
    lbl.TextSize=MOBILE and 12 or 9
    lbl.TextXAlignment=Enum.TextXAlignment.Left

    local trkH=MOBILE and 20 or 14
    local trkY=MOBILE and 22 or 18
    local trk=Instance.new("TextButton",w)
    trk.Size=UDim2.new(1,-20,0,trkH); trk.Position=UDim2.new(0,10,0,trkY)
    trk.BackgroundColor3=Color3.fromRGB(50,20,65); trk.BorderSizePixel=0
    trk.Text=""; trk.AutoButtonColor=false; crn(trk,4)

    local fill=Instance.new("Frame",trk)
    fill.Size=UDim2.new((def-mn)/(mx-mn),0,1,0)
    fill.BackgroundColor3=Color3.fromRGB(200,60,170); fill.BorderSizePixel=0; crn(fill,4)
    local fg=Instance.new("UIGradient",fill)
    fg.Color=ColorSequence.new({
        ColorSequenceKeypoint.new(0,Color3.fromRGB(255,140,225)),
        ColorSequenceKeypoint.new(1,Color3.fromRGB(160,35,130)),
    })

    local vL=Instance.new("TextLabel",trk)
    vL.Size=UDim2.new(1,0,1,0); vL.BackgroundTransparency=1
    vL.Text=("%g/%g"):format(def,mx)
    vL.TextColor3=Color3.fromRGB(255,255,255)
    vL.Font=Enum.Font.GothamBold
    vL.TextSize=MOBILE and 10 or 8; vL.ZIndex=3

    local kn=Instance.new("Frame",fill)
    kn.Size=UDim2.new(0,trkH,0,trkH); kn.AnchorPoint=Vector2.new(1,0.5)
    kn.Position=UDim2.new(1,0,0.5,0)
    kn.BackgroundColor3=Color3.fromRGB(255,255,255); kn.BorderSizePixel=0; crn(kn,trkH/2)

    local val=def; local sliding=false
    local function upd(ax)
        local rx=math.clamp(ax-trk.AbsolutePosition.X,0,trk.AbsoluteSize.X)
        local pct=rx/trk.AbsoluteSize.X
        val=math.floor(mn+(mx-mn)*pct+0.5)
        fill.Size=UDim2.new(pct,0,1,0)
        vL.Text=("%g/%g"):format(val,mx)
        if cb then cb(val) end
    end
    trk.InputBegan:Connect(function(i)
        if i.UserInputType==Enum.UserInputType.MouseButton1
        or i.UserInputType==Enum.UserInputType.Touch then sliding=true; upd(i.Position.X) end
    end)
    UIS.InputChanged:Connect(function(i)
        if sliding and (i.UserInputType==Enum.UserInputType.MouseMovement
        or i.UserInputType==Enum.UserInputType.Touch) then upd(i.Position.X) end
    end)
    UIS.InputEnded:Connect(function(i)
        if i.UserInputType==Enum.UserInputType.MouseButton1
        or i.UserInputType==Enum.UserInputType.Touch then sliding=false end
    end)
    return w
end

