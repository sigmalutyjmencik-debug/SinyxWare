-- ================================================================
--  DRAG
-- ================================================================
local dragData = {active = false, start = nil, offset = nil}
Main.InputBegan:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
        dragData.active = true
        dragData.start = i.Position
        dragData.offset = Outer.Position
    end
end)
Main.InputEnded:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
        dragData.active = false
    end
end)
UIS.InputChanged:Connect(function(i)
    if dragData.active and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
        local delta = i.Position - dragData.start
        Outer.Position = UDim2.new(
            dragData.offset.X.Scale, dragData.offset.X.Offset + delta.X,
            dragData.offset.Y.Scale, dragData.offset.Y.Offset + delta.Y
        )
    end
end)

