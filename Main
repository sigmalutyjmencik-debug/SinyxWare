local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UIS = game:GetService("UserInputService")
local CG = game:GetService("CoreGui")
local LP = Players.LocalPlayer
local Camera = workspace.CurrentCamera
local HttpService = game:GetService("HttpService")

if not Drawing then return warn("Drawing not supported") end

-- ============================================================
--  НАСТРОЙКИ (сохраняются)
-- ============================================================
local cfg = {
    aimbot = false,
    aimKey = "Q",
    fovSize = 80,
    smooth = 50,
    predict = false,
    predictMs = 14,
    snowFov = true,
    espEnabled = true,
    showBoxes = true,
    showNames = true,
    showHealth = true,
    speedHack = false,
    speedValue = 50,
    infiniteJump = false,
}

local function saveCfg()
    local json = HttpService:JSONEncode(cfg)
    writefile("SinyxWare.json", json)
end

local function loadCfg()
    if isfile("SinyxWare.json") then
        local data = HttpService:JSONDecode(readfile("SinyxWare.json"))
        for k, v in pairs(data) do cfg[k] = v end
    end
end

-- ============================================================
--  GUI СОЗДАНИЕ
-- ============================================================
pcall(function() CG:FindFirstChild("SinyxWare"):Destroy() end)
local gui = Instance.new("ScreenGui")
gui.Name = "SinyxWare"
gui.Parent = CG

local main = Instance.new("Frame", gui)
main.Size = UDim2.new(0, 468, 0, 324)
main.Position = UDim2.new(0.5, -234, 0.5, -162)
main.BackgroundColor3 = Color3.fromRGB(18,12,12)
main.BorderSizePixel = 0
Instance.new("UICorner", main).CornerRadius = UDim.new(0,4)

-- Заголовок
local title = Instance.new("TextLabel", main)
title.Size = UDim2.new(1,0,0,30)
title.BackgroundColor3 = Color3.fromRGB(30,20,20)
title.Text = "SinyxWare"
title.TextColor3 = Color3.fromRGB(0,191,255)
title.TextScaled = true
title.Font = Enum.Font.GothamBold
title.BorderSizePixel = 0

-- Табы
local tabs = {"Aimbot", "Visuals", "Misc", "Config"}
local tabBtns = {}
local tabFrames = {}

for i, name in ipairs(tabs) do
    local btn = Instance.new("TextButton", main)
    btn.Size = UDim2.new(0.25,0,0,25)
    btn.Position = UDim2.new((i-1)*0.25,0,0,30)
    btn.BackgroundColor3 = Color3.fromRGB(40,30,30)
    btn.Text = name
    btn.TextColor3 = Color3.fromRGB(255,255,255)
    btn.TextSize = 14
    btn.BorderSizePixel = 0
    tabBtns[name] = btn
    
    local frame = Instance.new("ScrollingFrame", main)
    frame.Size = UDim2.new(1,0,1,-55)
    frame.Position = UDim2.new(0,0,0,55)
    frame.BackgroundColor3 = Color3.fromRGB(25,18,18)
    frame.BorderSizePixel = 0
    frame.Visible = (i==1)
    frame.CanvasSize = UDim2.new(0,0,0,0)
    frame.AutomaticCanvasSize = Enum.AutomaticSize.Y
    frame.ScrollBarThickness = 4
    tabFrames[name] = frame
    
    btn.MouseButton1Click:Connect(function()
        for _, f in pairs(tabFrames) do f.Visible = false end
        frame.Visible = true
        for _, b in pairs(tabBtns) do b.BackgroundColor3 = Color3.fromRGB(40,30,30) end
        btn.BackgroundColor3 = Color3.fromRGB(60,40,40)
    end)
    btn.TouchTap:Connect(function()
        for _, f in pairs(tabFrames) do f.Visible = false end
        frame.Visible = true
        for _, b in pairs(tabBtns) do b.BackgroundColor3 = Color3.fromRGB(40,30,30) end
        btn.BackgroundColor3 = Color3.fromRGB(60,40,40)
    end)
end

-- Хелперы для элементов
local function addToggle(parent, label, key)
    local row = Instance.new("Frame", parent)
    row.Size = UDim2.new(1,0,0,25)
    row.BackgroundTransparency = 1
    
    local lbl = Instance.new("TextLabel", row)
    lbl.Size = UDim2.new(0.7,0,1,0)
    lbl.Text = label
    lbl.TextColor3 = Color3.fromRGB(220,220,220)
    lbl.TextSize = 14
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.BackgroundTransparency = 1
    
    local btn = Instance.new("TextButton", row)
    btn.Size = UDim2.new(0.2,0,0.7,0)
    btn.Position = UDim2.new(0.75,0,0.15,0)
    btn.BackgroundColor3 = cfg[key] and Color3.fromRGB(200,40,40) or Color3.fromRGB(60,50,50)
    btn.Text = cfg[key] and "ON" or "OFF"
    btn.TextColor3 = Color3.fromRGB(255,255,255)
    btn.TextSize = 12
    btn.BorderSizePixel = 0
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0,4)
    
    btn.MouseButton1Click:Connect(function()
        cfg[key] = not cfg[key]
        btn.BackgroundColor3 = cfg[key] and Color3.fromRGB(200,40,40) or Color3.fromRGB(60,50,50)
        btn.Text = cfg[key] and "ON" or "OFF"
        saveCfg()
    end)
    btn.TouchTap:Connect(function()
        cfg[key] = not cfg[key]
        btn.BackgroundColor3 = cfg[key] and Color3.fromRGB(200,40,40) or Color3.fromRGB(60,50,50)
        btn.Text = cfg[key] and "ON" or "OFF"
        saveCfg()
    end)
    return row
end

local function addSlider(parent, label, key, min, max, step)
    local row = Instance.new("Frame", parent)
    row.Size = UDim2.new(1,0,0,35)
    row.BackgroundTransparency = 1
    
    local lbl = Instance.new("TextLabel", row)
    lbl.Size = UDim2.new(0.5,0,0.5,0)
    lbl.Text = label
    lbl.TextColor3 = Color3.fromRGB(220,220,220)
    lbl.TextSize = 14
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.BackgroundTransparency = 1
    
    local valLbl = Instance.new("TextLabel", row)
    valLbl.Size = UDim2.new(0.2,0,0.5,0)
    valLbl.Position = UDim2.new(0.8,0,0,0)
    valLbl.Text = tostring(cfg[key])
    valLbl.TextColor3 = Color3.fromRGB(255,255,255)
    valLbl.TextSize = 14
    valLbl.BackgroundTransparency = 1
    
    local slider = Instance.new("Frame", row)
    slider.Size = UDim2.new(0.7,0,0.3,0)
    slider.Position = UDim2.new(0.05,0,0.6,0)
    slider.BackgroundColor3 = Color3.fromRGB(60,40,40)
    slider.BorderSizePixel = 0
    Instance.new("UICorner", slider).CornerRadius = UDim.new(0,4)
    
    local fill = Instance.new("Frame", slider)
    fill.Size = UDim2.new((cfg[key]-min)/(max-min),0,1,0)
    fill.BackgroundColor3 = Color3.fromRGB(200,40,40)
    fill.BorderSizePixel = 0
    Instance.new("UICorner", fill).CornerRadius = UDim.new(0,4)
    
    local dragging = false
    local function update(pos)
        local rel = (pos.X - slider.AbsolutePosition.X) / slider.AbsoluteSize.X
        rel = math.clamp(rel, 0, 1)
        local val = math.round((min + (max-min)*rel) / step) * step
        val = math.clamp(val, min, max)
        cfg[key] = val
        fill.Size = UDim2.new((val-min)/(max-min),0,1,0)
        valLbl.Text = tostring(val)
        saveCfg()
    end
    
    slider.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            update(i.Position)
        end
    end)
    UIS.InputChanged:Connect(function(i)
        if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
            update(i.Position)
        end
    end)
    UIS.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
    return row
end

