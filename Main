local function DetectExecutor()
    if identifyexecutor then
        local n,v = identifyexecutor()
        return tostring(n)..(v and (" "..tostring(v)) or "")
    end
    local g = getgenv and getgenv() or _G
    if g.wave or g.Wave then return "Wave"
    elseif g.solara or g.Solara then return "Solara"
    elseif g.syn or g.synapse then return "Synapse X"
    elseif g.KRNL_LOADED then return "Krnl"
    elseif g.fluxus then return "Fluxus"
    end
    if checkclosure then return "Advanced Executor" end
    return "Unknown"
end
local EXECUTOR = DetectExecutor()
local DEVICE   = MOBILE and "Mobile" or "PC"
local PLACE    = tostring(game.PlaceId)

-- ================================================================
--  РђРРњР‘РћРў
-- ================================================================
local AIM = {Enabled=false, FOV=120}

local function getTarget()
    local best,bd = nil, AIM.FOV
    local vp = Camera.ViewportSize
    local c  = Vector2.new(vp.X/2, vp.Y/2)
    for _,p in ipairs(Players:GetPlayers()) do
        if p==LP then continue end
        local ch = p.Character; if not ch then continue end
        local hum = ch:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health<=0 then continue end
        local part = ch:FindFirstChild("Head"); if not part then continue end
        local pos,vis = Camera:WorldToViewportPoint(part.Position)
        if not vis then continue end
        local d = (Vector2.new(pos.X,pos.Y)-c).Magnitude
        if d<bd then bd=d; best=part end
    end
    return best
end

