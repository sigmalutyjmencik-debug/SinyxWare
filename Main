    local barGrad = Instance.new("UIGradient", bar)
    barGrad.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromRGB(255,150,230)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(180,40,140)),
    })
    barGrad.Rotation = 90

    -- РРєРѕРЅРєР°
    local ico = Instance.new("TextLabel", btn)
    ico.Size = UDim2.new(0, 22, 1, 0)
    ico.Position = UDim2.new(0, 8, 0, 0)
    ico.BackgroundTransparency = 1
