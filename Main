if isMobile() then
    local btnGui = Instance.new("ScreenGui")
    btnGui.Name = "SWMobileBtn"; btnGui.ResetOnSpawn = false; btnGui.Parent = CG

    local mBtn = Instance.new("TextButton", btnGui)
    mBtn.Size = UDim2.new(0, 44, 0, 44)
    mBtn.Position = UDim2.new(1, -54, 0.5, -22)
    mBtn.BackgroundColor3 = C.pink2
    mBtn.BorderSizePixel = 0; mBtn.Text = "SW"
    mBtn.TextColor3 = C.white; mBtn.Font = Enum.Font.GothamBold; mBtn.TextSize = 10
    mBtn.AutoButtonColor = false; mBtn.ZIndex = 999
    corner(mBtn, 22)

    local mBtnGrad = Instance.new("UIGradient", mBtn)
    mBtnGrad.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromRGB(255,120,210)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(160,30,120)),
    })
    mBtnGrad.Rotation = 135

    local stroke = Instance.new("UIStroke", mBtn)
    stroke.Color = C.pink1; stroke.Thickness = 1.5

    -- Drag РјРѕР±РёР»СЊРЅРѕР№ РєРЅРѕРїРєРё
    local mbDrag = {active=false, start=nil, offset=nil, moved=false}
    mBtn.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.Touch then
            mbDrag.active=true; mbDrag.start=i.Position
            mbDrag.offset=mBtn.Position; mbDrag.moved=false
        end
    end)
    mBtn.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.Touch then
            mbDrag.active=false
            if not mbDrag.moved then
                Root.Enabled = not Root.Enabled
            end
        end
    end)
    UIS.InputChanged:Connect(function(i)
        if mbDrag.active and i.UserInputType == Enum.UserInputType.Touch then
            local d = i.Position - mbDrag.start
            if d.Magnitude > 5 then mbDrag.moved = true end
            mBtn.Position = UDim2.new(
                mbDrag.offset.X.Scale, mbDrag.offset.X.Offset + d.X,
                mbDrag.offset.Y.Scale, mbDrag.offset.Y.Offset + d.Y
            )
        end
    end)
else
    -- РџРљ: Insert РґР»СЏ СЃРєСЂС‹С‚РёСЏ
    UIS.InputBegan:Connect(function(i, gpe)
        if gpe then return end
        if i.KeyCode == Enum.KeyCode.Insert then
            Root.Enabled = not Root.Enabled
        end
    end)
end

