                dragSnow.active = true
                dragSnow.start = input.Position
                dragSnow.offset = snowButtonObj.Position
            end
        end)
        snowButtonObj.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.Touch then
                dragSnow.active = false
            end
        end)
        UIS.InputChanged:Connect(function(input)
            if dragSnow.active and input.UserInputType == Enum.UserInputType.Touch then
                local delta = input.Position - dragSnow.start
                snowButtonObj.Position = UDim2.new(
                    dragSnow.offset.X.Scale,
                    dragSnow.offset.X.Offset + delta.X,
                    dragSnow.offset.Y.Scale,
                    dragSnow.offset.Y.Offset + delta.Y
                )
