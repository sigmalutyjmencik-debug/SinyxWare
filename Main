-- ============================================================
--  DRAG
-- ============================================================
local drag = {active=false, start=nil, offset=nil}
main.InputBegan:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
        drag.active = true
        drag.start = i.Position
        drag.offset = main.Position
    end
end)
main.InputEnded:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
        drag.active = false
    end
end)
UIS.InputChanged:Connect(function(i)
    if drag.active and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
        local delta = i.Position - drag.start
        main.Position = UDim2.new(
            drag.offset.X.Scale, drag.offset.X.Offset + delta.X,
            drag.offset.Y.Scale, drag.offset.Y.Offset + delta.Y
        )
    end
end)

-- ============================================================
--  КРУГ
-- ============================================================
local circle = Drawing.new("Circle")
circle.Thickness = 2
circle.NumSides = 32
circle.Filled = false
circle.Color = Color3.fromRGB(160,32,240)
circle.Radius = cfg.fovSize
circle.Visible = true
circle.Transparency = 0.5

-- ============================================================
--  ESP
-- ============================================================
local espObjects = {}

local function createESP(plr)
    if plr == LP or espObjects[plr] then return end
    local e = {
        Box = Drawing.new("Square"),
        Name = Drawing.new("Text"),
        Health = Drawing.new("Square"),
    }
    e.Box.Filled = false
    e.Box.Thickness = 1.5
    e.Box.Visible = false
    e.Name.Size = 12
    e.Name.Center = true
    e.Name.Outline = true
    e.Name.OutlineColor = Color3.fromRGB(0,0,0)
    e.Name.Font = 3
    e.Name.Visible = false
    e.Health.Filled = true
    e.Health.Thickness = 1
    e.Health.Visible = false
    espObjects[plr] = e
end

local function removeESP(plr)
    local e = espObjects[plr]
    if e then
        pcall(function()
            e.Box:Remove()
            e.Name:Remove()
            e.Health:Remove()
        end)
        espObjects[plr] = nil
    end
end

for _, plr in pairs(Players:GetPlayers()) do createESP(plr) end
Players.PlayerAdded:Connect(createESP)
Players.PlayerRemoving:Connect(removeESP)

-- ============================================================
--  ГЛАВНЫЙ ЦИКЛ
-- ============================================================
local rainbow = 0

RunService.RenderStepped:Connect(function()
    local center = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
    circle.Position = center
    circle.Radius = cfg.fovSize
    
    -- AIMBOT
    if cfg.aimbot then
        local target = nil
        local minDist = cfg.fovSize
        for _, plr in pairs(Players:GetPlayers()) do
            if plr == LP then continue end
            if not plr.Character or not plr.Character:FindFirstChild("Head") then continue end
            local pos, onScreen = Camera:WorldToViewportPoint(plr.Character.Head.Position)
            if not onScreen then continue end
            local dist = (Vector2.new(pos.X, pos.Y) - center).Magnitude
            if dist < minDist then
                minDist = dist
                target = plr
            end
        end
        
        local keyPressed = false
        if cfg.aimKey ~= "" then
            local k = Enum.KeyCode[cfg.aimKey]
            if k then keyPressed = UIS:IsKeyDown(k) end
        end
        
        if target and (keyPressed or not cfg.snowFov) then
            if (not cfg.snowFov) or (cfg.snowFov and minDist <= cfg.fovSize) then
                local head = target.Character.Head
                local targetPos = head.Position
                if cfg.predict then
                    local root = target.Character:FindFirstChild("HumanoidRootPart")
                    if root and root.AssemblyLinearVelocity then
                        targetPos = targetPos + root.AssemblyLinearVelocity * (cfg.predictMs/1000)
                    end
                end
                local smooth = math.clamp(cfg.smooth/100, 0.01, 1)
                local current = Camera.CFrame
                local targetCF = CFrame.new(current.Position, targetPos)
                Camera.CFrame = current:Lerp(targetCF, smooth)
                circle.Color = Color3.fromRGB(0,255,0)
            else
                circle.Color = Color3.fromRGB(255,255,0)
            end
        else
            circle.Color = Color3.fromRGB(255,0,0)
        end
    else
        circle.Color = Color3.fromRGB(160,32,240)
    end
    
    -- ESP
    if cfg.espEnabled then
        rainbow = (rainbow + 0.005) % 1
        local col = Color3.fromHSV(rainbow, 1, 1)
        for plr, e in pairs(espObjects) do
            local char = plr.Character
            if not char or not char.Parent then
                e.Box.Visible = false
                e.Name.Visible = false
                e.Health.Visible = false
                continue
            end
            local root = char:FindFirstChild("HumanoidRootPart")
            local head = char:FindFirstChild("Head")
            if not root or not head then
                e.Box.Visible = false
                e.Name.Visible = false
                e.Health.Visible = false
                continue
            end
            local top = head.Position + Vector3.new(0, head.Size.Y/2, 0)
            local bottom = root.Position - Vector3.new(0, root.Size.Y/2, 0)
            local right = root.Position + root.CFrame:VectorToWorldSpace(Vector3.new(root.Size.X/2,0,0))
            local left = root.Position + root.CFrame:VectorToWorldSpace(Vector3.new(-root.Size.X/2,0,0))
            
            local topV = Camera:WorldToViewportPoint(top)
            local bottomV = Camera:WorldToViewportPoint(bottom)
            local rightV = Camera:WorldToViewportPoint(right)
            local leftV = Camera:WorldToViewportPoint(left)
            
            if not (topV[2] or bottomV[2] or rightV[2] or leftV[2]) then
                e.Box.Visible = false
                e.Name.Visible = false
                e.Health.Visible = false
                continue
            end
            
            local height = math.abs(topV.Y - bottomV.Y)
            local width = math.abs(rightV.X - leftV.X)
            if height < 5 then height = 5 end
            if width < 5 then width = 5 end
            local centerX = (leftV.X + rightV.X)/2
            local centerY = (topV.Y + bottomV.Y)/2
            
            if cfg.showBoxes then
                e.Box.Visible = true
                e.Box.Size = Vector2.new(width, height)
                e.Box.Position = Vector2.new(centerX - width/2, centerY - height/2)
                e.Box.Color = col
            else
                e.Box.Visible = false
            end
            
            if cfg.showNames then
                e.Name.Visible = true
                e.Name.Text = plr.Name
                e.Name.Position = Vector2.new(centerX, topV.Y - 15)
                e.Name.Color = col
            else
                e.Name.Visible = false
            end
            
            if cfg.showHealth then
                local hum = char:FindFirstChildOfClass("Humanoid")
                if hum and hum.MaxHealth > 0 then
                    local hp = math.clamp(hum.Health/hum.MaxHealth, 0, 1)
                    e.Health.Visible = true
                    e.Health.Size = Vector2.new(2, height * hp)
                    e.Health.Position = Vector2.new(centerX - width/2 - 4, centerY + height/2 - height*hp)
                    e.Health.Color = Color3.fromRGB(255*(1-hp), 255*hp, 0)
                else
                    e.Health.Visible = false
                end
            else
                e.Health.Visible = false
            end
        end
    else
        for _, e in pairs(espObjects) do
            e.Box.Visible = false
            e.Name.Visible = false
            e.Health.Visible = false
        end
    end
end)

-- ============================================================
--  MISC (Speed & Jump)
-- ============================================================
RunService.Heartbeat:Connect(function()
    if LP.Character then
        local hum = LP.Character:FindFirstChildOfClass("Humanoid")
        if hum then
            hum.WalkSpeed = cfg.speedHack and cfg.speedValue or 16
            if cfg.infiniteJump then
                hum.JumpPower = 50
                hum:SetStateEnabled(Enum.HumanoidStateType.Jumping, true)
            else
                hum.JumpPower = 50
            end
        end
    end
end)

UIS.InputBegan:Connect(function(i, gpe)
    if gpe then return end
    if i.KeyCode == Enum.KeyCode.Space and cfg.infiniteJump then
        local hum = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
        if hum then hum:ChangeState(Enum.HumanoidStateType.Jumping) end
    end
end)

-- ============================================================
--  HOTKEYS
-- ============================================================
UIS.InputBegan:Connect(function(i, gpe)
    if gpe then return end
    if i.KeyCode == Enum.KeyCode.Insert or i.KeyCode == Enum.KeyCode.LeftControl then
        gui.Enabled = not gui.Enabled
    end
end)

-- ============================================================
--  ЗАГРУЗКА КОНФИГА
-- ============================================================
loadCfg()

-- ============================================================
--  МОБИЛЬНАЯ КНОПКА
-- ============================================================
if UIS.TouchEnabled and not UIS.MouseEnabled then
    local btnGui = Instance.new("ScreenGui")
    btnGui.Name = "SinyxWareButton"
    btnGui.Parent = CG
    local btn = Instance.new("ImageButton", btnGui)
    btn.Size = UDim2.new(0,50,0,50)
    btn.Position = UDim2.new(1,-60,0.5,-25)
    btn.Image = "rbxassetid://73073995075962"
    btn.BackgroundTransparency = 1
    local dragB = {active=false, start=nil, offset=nil}
    btn.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.Touch then
            dragB.active = true
            dragB.start = i.Position
            dragB.offset = btn.Position
        end
    end)
    btn.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.Touch then dragB.active = false end
    end)
    UIS.InputChanged:Connect(function(i)
        if dragB.active and i.UserInputType == Enum.UserInputType.Touch then
            local delta = i.Position - dragB.start
            btn.Position = UDim2.new(
                dragB.offset.X.Scale, dragB.offset.X.Offset + delta.X,
                dragB.offset.Y.Scale, dragB.offset.Y.Offset + delta.Y
            )
        end
    end)
    btn.MouseButton1Click:Connect(function() gui.Enabled = not gui.Enabled end)
    btn.TouchTap:Connect(function() gui.Enabled = not gui.Enabled end)
end

print("SinyxWare v5.0 loaded. Press Insert or Ctrl to toggle GUI.")
