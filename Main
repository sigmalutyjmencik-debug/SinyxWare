-- ================================================================
--  ESP (исправлено смещение)
-- ================================================================
local function getRainbowColor(speed)
    local t = tick() * (speed or 2)
    return Color3.fromRGB(math.sin(t+0)*127+128, math.sin(t+2)*127+128, math.sin(t+4)*127+128)
end

local function checkVisibility(targetCharacter)
    local localCharacter = LP.Character
    if not localCharacter or not localCharacter:FindFirstChild("HumanoidRootPart") then return false end
    if not targetCharacter or not targetCharacter:FindFirstChild("HumanoidRootPart") then return false end
    local origin = Camera.CFrame.Position
    local destination = targetCharacter.HumanoidRootPart.Position
    local raycastParams = RaycastParams.new()
    raycastParams.FilterType = Enum.RaycastFilterType.Exclude
    raycastParams.FilterDescendantsInstances = {localCharacter, targetCharacter, Camera}
    local result = workspace:Raycast(origin, destination - origin, raycastParams)
    return result == nil
end

local espObjects = {}

function createESP(player)
    if not hasDrawing or player == LP or espObjects[player] then return end
    local box = Drawing.new("Square"); box.Thickness=1.5; box.Filled=false; box.Transparency=1; box.Visible=false
    local hpBg = Drawing.new("Square"); hpBg.Thickness=1; hpBg.Filled=true; hpBg.Color=Color3.fromRGB(0,0,0); hpBg.Transparency=1; hpBg.Visible=false
    local hpBar = Drawing.new("Square"); hpBar.Thickness=1; hpBar.Filled=true; hpBar.Color=Color3.fromRGB(0,255,0); hpBar.Transparency=1; hpBar.Visible=false
    local nameLabel = Drawing.new("Text"); nameLabel.Size=13; nameLabel.Center=true; nameLabel.Outline=true; nameLabel.Transparency=1; nameLabel.Visible=false
    local distLabel = Drawing.new("Text"); distLabel.Size=12; distLabel.Center=true; distLabel.Outline=true; distLabel.Transparency=1; distLabel.Visible=false
    local tracer = Drawing.new("Line"); tracer.Thickness=1.5; tracer.Transparency=1; tracer.Visible=false
    espObjects[player] = {box=box, hpBg=hpBg, hpBar=hpBar, nameLabel=nameLabel, distLabel=distLabel, tracer=tracer}
    local connection
    connection = RunService.RenderStepped:Connect(function()
        if not espEnabled or not player:IsDescendantOf(Players) then
            box.Visible=false; hpBg.Visible=false; hpBar.Visible=false; nameLabel.Visible=false; distLabel.Visible=false; tracer.Visible=false
            if not player:IsDescendantOf(Players) then
                box:Remove(); hpBg:Remove(); hpBar:Remove(); nameLabel:Remove(); distLabel:Remove(); tracer:Remove()
                connection:Disconnect(); espObjects[player] = nil
            end
            return
        end
        local character = player.Character
        if not character or not character:FindFirstChild("HumanoidRootPart") or not character:FindFirstChild("Humanoid") then
            box.Visible=false; hpBg.Visible=false; hpBar.Visible=false; nameLabel.Visible=false; distLabel.Visible=false; tracer.Visible=false
            return
        end
        local rootPart = character.HumanoidRootPart; local humanoid = character.Humanoid
        -- Используем CFrame для корректного позиционирования
        local headPos, headOn = Camera:WorldToViewportPoint((rootPart.CFrame * CFrame.new(0,3,0)).Position)
        local footPos, footOn = Camera:WorldToViewportPoint((rootPart.CFrame * CFrame.new(0,-3.5,0)).Position)
        local centerPos = Camera:WorldToViewportPoint(rootPart.Position)
        if headOn and footOn and humanoid.Health > 0 then
            local boxH = math.abs(headPos.Y - footPos.Y); local boxW = boxH * 0.6
            local boxX = headPos.X - boxW/2; local boxY = headPos.Y
            local rainbow = getRainbowColor(2)
            if espShowBox then box.Size=Vector2.new(boxW,boxH); box.Position=Vector2.new(boxX,boxY); box.Color=rainbow; box.Visible=true else box.Visible=false end
            if espShowName then nameLabel.Text=player.Name; nameLabel.Position=Vector2.new(centerPos.X, boxY-16); nameLabel.Color=rainbow; nameLabel.Visible=true else nameLabel.Visible=false end
            if espShowDist then
                local d = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart") and math.floor((rootPart.Position - LP.Character.HumanoidRootPart.Position).Magnitude) or "?"
                distLabel.Text = tostring(d) .. " studs"; distLabel.Position=Vector2.new(centerPos.X, boxY+boxH+4); distLabel.Color=rainbow; distLabel.Visible=true
            else distLabel.Visible=false end
            if espShowHP then
                local hpH = boxH * (humanoid.Health / humanoid.MaxHealth)
                hpBg.Size=Vector2.new(3,boxH); hpBg.Position=Vector2.new(boxX-6,boxY); hpBg.Visible=true
                hpBar.Size=Vector2.new(3,hpH); hpBar.Position=Vector2.new(boxX-6, boxY+(boxH-hpH)); hpBar.Visible=true
            else hpBg.Visible=false; hpBar.Visible=false end
            if espShowTracer then
                local isVis = checkVisibility(character)
                tracer.Color = isVis and Color3.fromRGB(0,255,0) or Color3.fromRGB(255,0,0)
                tracer.From = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y)
                tracer.To = Vector2.new(headPos.X, headPos.Y)
                tracer.Visible = true
            else tracer.Visible = false end
        else
            box.Visible=false; hpBg.Visible=false; hpBar.Visible=false; nameLabel.Visible=false; distLabel.Visible=false; tracer.Visible=false
        end
    end)
end

Players.PlayerAdded:Connect(function(player) if espEnabled and hasDrawing then createESP(player) end end)
for _,player in ipairs(Players:GetPlayers()) do if espEnabled and hasDrawing and player ~= LP then createESP(player) end end

-- ================================================================
--  АИМБОТ (круг не скрывается при закрытии GUI)
-- ================================================================
local function getTargetPart(character)
    if targetPart == "Head" then return character:FindFirstChild("Head")
    elseif targetPart == "Torso" then return character:FindFirstChild("Torso") or character:FindFirstChild("UpperTorso")
    else return character:FindFirstChild("HumanoidRootPart") end
end

local function wallCheckFunc(targetPos)
    if not wallCheckEnabled then return true end
    local char = LP.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return true end
    local origin = char.HumanoidRootPart.Position
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {char, Camera}
    local result = workspace:Raycast(origin, targetPos - origin, params)
    return result == nil
end

local function visibleCheckFunc(targetCharacter)
    if not visibleCheckEnabled then return true end
    return checkVisibility(targetCharacter)
end

local aimbotCircle = nil
RunService.RenderStepped:Connect(function()
    -- Круг видим независимо от visible
    if aimbotCircleEnabled and hasDrawing then
        if not aimbotCircle then
            aimbotCircle = Drawing.new("Circle")
            aimbotCircle.Thickness = 2
            aimbotCircle.Color = circleColor
            aimbotCircle.Transparency = 1
            aimbotCircle.Filled = false
            aimbotCircle.NumSides = 60
        end
        aimbotCircle.Radius = circleRadius
        aimbotCircle.Position = Camera.ViewportSize / 2
        aimbotCircle.Color = circleColor
        aimbotCircle.Visible = true
    else
        if aimbotCircle then aimbotCircle.Visible = false end
    end
    if not aimbotEnabled then return end
    local localChar = LP.Character
    if not localChar or not localChar:FindFirstChild("HumanoidRootPart") then return end
    local screenCenter = Camera.ViewportSize / 2
    local closestDist = circleRadius
    local closestPart = nil
    if lockButtonEnabled and lockTarget and lockTarget.Parent then
        local pos, onScreen = Camera:WorldToViewportPoint(lockTarget.Position)
        if onScreen and wallCheckFunc(lockTarget.Position) and visibleCheckFunc(lockTarget.Parent) then
            closestPart = lockTarget
        else
            lockTarget = nil
        end
    end
    if not closestPart then
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LP and player.Character then
                local char = player.Character
                local humanoid = char:FindFirstChild("Humanoid")
                if humanoid and humanoid.Health > 0 then
                    local part = getTargetPart(char)
                    if part then
                        local pos, onScreen = Camera:WorldToViewportPoint(part.Position)
                        if onScreen then
                            local dist = (Vector2.new(pos.X, pos.Y) - screenCenter).Magnitude
                            if dist < closestDist and dist < circleRadius and wallCheckFunc(part.Position) and visibleCheckFunc(char) then
                                closestDist = dist; closestPart = part
                            end
                        end
                    end
                end
            end
        end
    end
    if closestPart then
        local targetPos = closestPart.Position
        if prediction > 0 then
            local vel = closestPart.AssemblyLinearVelocity or Vector3.new()
            targetPos = targetPos + vel * prediction
        end
        local smoothFactor = smoothness / 100
        if aimMode == "Instant" then smoothFactor = 1 end
        if isMobile() then
            local lookCF = CFrame.new(Camera.CFrame.Position, targetPos)
            local alpha = math.clamp(smoothFactor * 0.4, 0.05, 1.0)
            Camera.CFrame = Camera.CFrame:Lerp(lookCF, alpha)
        else
            local screenPos, onScreen = Camera:WorldToViewportPoint(targetPos)
            if onScreen then
                pcall(function()
                    if smoothFactor >= 0.95 then
                        mousemoverel(screenPos.X - screenCenter.X, screenPos.Y - screenCenter.Y)
                    else
                        local currentMouse = UIS:GetMouseLocation()
                        local targetScreen = Vector2.new(screenPos.X, screenPos.Y)
                        local newMouse = currentMouse:Lerp(targetScreen, smoothFactor)
                        mousemoverel(newMouse.X - currentMouse.X, newMouse.Y - currentMouse.Y)
                    end
                end)
            end
        end
        if lockButtonEnabled then lockTarget = closestPart end
    end
end)

-- ================================================================
--  ФУНКЦИОНАЛЬНЫЙ ПОИСК
-- ================================================================
SearchBox:GetPropertyChangedSignal("Text"):Connect(function()
    local query = SearchBox.Text:lower()
    for _, f in pairs(TabContents) do
        if f.Visible then
            local allElements = {}
            for _,child in ipairs(f:GetDescendants()) do
                if child:IsA("TextLabel") or child:IsA("TextButton") then
                    local text = child.Text:lower()
                    if text and text ~= "" then
                        allElements[child] = true
                    end
                end
            end
            for child,_ in pairs(allElements) do
                local text = child.Text:lower()
                local show = query == "" or text:find(query, 1, true)
                child.Visible = show
            end
        end
    end
end)

-- ================================================================
--  MISC ЛОГИКА (Inf Jump)
-- ================================================================
LP.CharacterAdded:Connect(function(char)
    task.wait(0.5)
    if speedHackEnabled then local h = char:FindFirstChild("Humanoid"); if h then h.WalkSpeed = speedValue end end
    if infJumpEnabled then local h = char:FindFirstChild("Humanoid"); if h then h.JumpPower = 9999; h:SetStateEnabled(Enum.HumanoidStateType.Jumping, true) end end
    if noClipEnabled then for _,part in ipairs(char:GetDescendants()) do if part:IsA("BasePart") then part.CanCollide = false end end end
    if auraEnabled then setupAura() end
    if crosshairEnabled then createCrosshair() end
end)

UIS.InputBegan:Connect(function(input, gpe)
    if gpe then return end
    if infJumpEnabled and input.UserInputType == Enum.UserInputType.Keyboard then
        if input.KeyCode == Enum.KeyCode.Space then
            local char = LP.Character
            if char and char:FindFirstChild("Humanoid") then
                local humanoid = char.Humanoid
                if humanoid:GetState() == Enum.HumanoidStateType.Landed or humanoid:GetState() == Enum.HumanoidStateType.Jumping then
                    humanoid.Jump = true
                    task.wait(0.1)
                    humanoid.Jump = false
                end
            end
        end
    end
end)

RunService.RenderStepped:Connect(function()
    if noClipEnabled then
        local char = LP.Character
        if char then
            for _,part in ipairs(char:GetDescendants()) do
                if part:IsA("BasePart") then part.CanCollide = false end
            end
        end
    end
end)

-- ================================================================
--  МОБИЛЬНАЯ КНОПКА ОТКРЫТИЯ GUI
-- ================================================================
if isMobile() then
    local btnGui = CG:FindFirstChild("SinyxWareMobileButtons")
    if not btnGui then
        btnGui = Instance.new("ScreenGui")
        btnGui.Name = "SinyxWareMobileButtons"
        btnGui.ResetOnSpawn = false
        btnGui.Parent = CG
    end
    mobileButton = Instance.new("ImageButton")
    mobileButton.Size = UDim2.new(0, 50, 0, 50)
    mobileButton.Position = UDim2.new(1, -60, 0.5, -25)
    mobileButton.Image = "rbxassetid://73073995075962"
    mobileButton.BackgroundTransparency = 1
    mobileButton.Parent = btnGui
    mobileButton.ZIndex = 999
    local dragMob = {active=false, start=nil, offset=nil}
    mobileButton.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch then
            dragMob.active = true; dragMob.start = input.Position; dragMob.offset = mobileButton.Position
        end
    end)
    mobileButton.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch then dragMob.active = false end
    end)
    UIS.InputChanged:Connect(function(input)
        if dragMob.active and input.UserInputType == Enum.UserInputType.Touch then
            local delta = input.Position - dragMob.start
            mobileButton.Position = UDim2.new(dragMob.offset.X.Scale, dragMob.offset.X.Offset + delta.X, dragMob.offset.Y.Scale, dragMob.offset.Y.Offset + delta.Y)
        end
    end)
    local function toggleGUI()
        visible = not visible
        Outer.Visible = visible
        -- Не скрываем кнопки и круг
    end
    mobileButton.MouseButton1Click:Connect(toggleGUI)
    mobileButton.TouchTap:Connect(toggleGUI)
end

-- ================================================================
--  HIDE / SHOW (ТОЛЬКО GUI, кнопки и круг остаются)
-- ================================================================
UIS.InputBegan:Connect(function(i, gpe)
    if gpe then return end
    if i.KeyCode == Enum.KeyCode.Insert then
        visible = not visible
        Outer.Visible = visible
        -- Не трогаем снежную кнопку, мобильную кнопку и круг
    end
end)

