-- ================================================================
--  АИМБОТ ЛОГИКА (С WALL CHECK И ФИКСАМИ)
-- ================================================================
local function getTargetPart(character)
    if targetPart == "Head" then
        return character:FindFirstChild("Head")
    elseif targetPart == "Torso" then
        return character:FindFirstChild("Torso") or character:FindFirstChild("UpperTorso")
    else
        return character:FindFirstChild("HumanoidRootPart")
    end
end

local function wallCheck(targetPos)
    if not wallCheckEnabled then return true end
    local char = LP.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return true end
    
    local origin = char.HumanoidRootPart.Position
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {char, Camera}
    
    local result = workspace:Raycast(origin, targetPos - origin, params)
    return result == nil
end

local aimbotCircle = nil

RunService.RenderStepped:Connect(function()
    -- Circle draw
    if aimbotCircleEnabled and visible and hasDrawing then
        if not aimbotCircle then
            aimbotCircle = Drawing.new("Circle")
            aimbotCircle.Thickness = 2
            aimbotCircle.Color = Color3.fromRGB(220, 50, 100)
            aimbotCircle.Transparency = 1
            aimbotCircle.Filled = false
            aimbotCircle.NumSides = 60
        end
        aimbotCircle.Radius = circleRadius
        aimbotCircle.Position = Camera.ViewportSize / 2
        aimbotCircle.Visible = true
    else
        if aimbotCircle then aimbotCircle.Visible = false end
    end

    if not aimbotEnabled or not visible then return end

    local localChar = LP.Character
    if not localChar or not localChar:FindFirstChild("HumanoidRootPart") then return end

    local screenCenter = Camera.ViewportSize / 2
    local closestDist = circleRadius
    local closestPart = nil
    local closestPlayer = nil

    -- Locked target
    if lockButtonEnabled and lockTarget and lockTarget.Parent then
        local pos, onScreen = Camera:WorldToViewportPoint(lockTarget.Position)
        if onScreen and wallCheck(lockTarget.Position) then
            closestPart = lockTarget
            closestPlayer = lockTarget.Parent
        else
            lockTarget = nil
        end
    end

    -- Find closest target in circle
    if not closestPart then
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LP and player.Character then
                local char = player.Character
                local humanoid = char:FindFirstChild("Humanoid")
                if humanoid and humanoid.Health > 0 then
                    local part = getTargetPart(char)
                    if part then
                        local pos, onScreen = Camera:WorldToViewportPoint(part.Position)
                        if onScreen then
                            local dist = (Vector2.new(pos.X, pos.Y) - screenCenter).Magnitude
                            if dist < closestDist and dist < circleRadius then
                                -- Wall check
                                if wallCheck(part.Position) then
                                    closestDist = dist
                                    closestPart = part
                                    closestPlayer = player
                                end
                            end
                        end
                    end
                end
            end
        end
    end

    if closestPart and closestPlayer then
        local targetPos = closestPart.Position
        if prediction > 0 then
            local vel = closestPart.AssemblyLinearVelocity or Vector3.new()
            targetPos = targetPos + vel * prediction
        end

        local smoothFactor = smoothness / 100

        if isMobile() then
            -- Mobile aimbot
            local lookCF = CFrame.new(Camera.CFrame.Position, targetPos)
            local alpha = math.clamp(smoothFactor * 0.4, 0.05, 1.0)
            Camera.CFrame = Camera.CFrame:Lerp(lookCF, alpha)
        else
            -- PC aimbot
            local screenPos, onScreen = Camera:WorldToViewportPoint(targetPos)
            if onScreen then
                pcall(function()
                    if smoothFactor >= 0.95 then
                        mousemoverel(screenPos.X - screenCenter.X, screenPos.Y - screenCenter.Y)
                    else
                        local currentMouse = UIS:GetMouseLocation()
                        local targetScreen = Vector2.new(screenPos.X, screenPos.Y)
                        local newMouse = currentMouse:Lerp(targetScreen, smoothFactor)
                        mousemoverel(newMouse.X - currentMouse.X, newMouse.Y - currentMouse.Y)
                    end
                end)
            end
        end

        if lockButtonEnabled then
            lockTarget = closestPart
        end
    end
end)

