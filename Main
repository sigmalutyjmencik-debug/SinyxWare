local function toggleAim()
    cfg.aimbot = not cfg.aimbot
    pillAim.BackgroundColor3 = cfg.aimbot and C.red or C.togOff
    knobAim.Position = cfg.aimbot and UDim2.new(1, -(10 * 1.2), 0.5, -(4 * 1.2)) or UDim2.new(0, 2 * 1.2, 0.5, -(4 * 1.2))
    saveCfg()
end
pillAim.MouseButton1Click:Connect(toggleAim)
pillAim.TouchTap:Connect(toggleAim)

local keyAwait = false
