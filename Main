LP.CharacterAdded:Connect(function(char)
    task.wait(0.5)
    if speedHackEnabled then
        local h = char:FindFirstChild("Humanoid")
        if h then h.WalkSpeed = speedValue end
    end
    if infJumpEnabled then
        local h = char:FindFirstChild("Humanoid")
        if h then h.JumpPower = 9999 end
    end
    if noClipEnabled then
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") then part.CanCollide = false end
        end
    end
    if auraEnabled then
        setupAura()
    end
end)

RunService.RenderStepped:Connect(function()
    if noClipEnabled then
        local char = LP.Character
        if char then
            for _, part in ipairs(char:GetDescendants()) do
                if part:IsA("BasePart") then part.CanCollide = false end
            end
        end
    end
end)

-- Infinite jump handler
UIS.InputBegan:Connect(function(input, gpe)
    if gpe then return end
    if infJumpEnabled and input.UserInputType == Enum.UserInputType.Keyboard then
        if input.KeyCode == Enum.KeyCode.Space then
            local char = LP.Character
            if char and char:FindFirstChild("Humanoid") then
                local humanoid = char.Humanoid
                if humanoid:GetState() == Enum.HumanoidStateType.Landed then
                    humanoid.Jump = true
                    task.wait(0.1)
                    humanoid.Jump = false
                end
            end
        end
    end
end)

-- ================================================================
--  МОБИЛЬНЫЕ КНОПКИ (ФИКС - ТОЛЬКО 1 КНОПКА)
-- ================================================================
function createSnowButton()
    if snowButtonObj then snowButtonObj:Destroy() end
    local btnGui = CG:FindFirstChild("SinyxWareMobileButtons")
    if not btnGui then
        btnGui = Instance.new("ScreenGui")
        btnGui.Name = "SinyxWareMobileButtons"
        btnGui.ResetOnSpawn = false
        btnGui.Parent = CG
    end
    snowButtonObj = Instance.new("ImageButton")
    snowButtonObj.Size = UDim2.new(0, 55, 0, 55)
    snowButtonObj.Position = UDim2.new(0.1, 0, 0.5, -27)
    snowButtonObj.Image = "rbxassetid://73073995075962"
    snowButtonObj.BackgroundColor3 = aimbotEnabled and C.green or C.red
    snowButtonObj.BackgroundTransparency = 0.3
    snowButtonObj.Parent = btnGui
    snowButtonObj.ZIndex = 999
    corner(snowButtonObj, 27)

    local dragSnow = {active=false, start=nil, offset=nil}
    snowButtonObj.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch then
            dragSnow.active = true
            dragSnow.start = input.Position
            dragSnow.offset = snowButtonObj.Position
        end
    end)
    snowButtonObj.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch then
            dragSnow.active = false
        end
    end)
    UIS.InputChanged:Connect(function(input)
        if dragSnow.active and input.UserInputType == Enum.UserInputType.Touch then
            local delta = input.Position - dragSnow.start
            snowButtonObj.Position = UDim2.new(
                dragSnow.offset.X.Scale, dragSnow.offset.X.Offset + delta.X,
                dragSnow.offset.Y.Scale, dragSnow.offset.Y.Offset + delta.Y
            )
        end
    end)

    local function toggleAimBtn()
        aimbotEnabled = not aimbotEnabled
        snowButtonObj.BackgroundColor3 = aimbotEnabled and C.green or C.red
        if not aimbotEnabled then lockTarget = nil end
    end
    snowButtonObj.MouseButton1Click:Connect(toggleAimBtn)
    snowButtonObj.TouchTap:Connect(toggleAimBtn)
end

