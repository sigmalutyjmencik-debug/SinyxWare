aimKeyBox.TextColor3 = C.white
aimKeyBox.Font = Enum.Font.GothamBold
aimKeyBox.TextSize = 7 * 1.2
aimKeyBox.BorderSizePixel = 0
corner(aimKeyBox, 2)

local keyAwait = false
aimKeyBox.MouseButton1Click:Connect(function()
    keyAwait = true
    aimKeyBox.Text = "..."
end)
aimKeyBox.TouchTap:Connect(function()
    keyAwait = true
    aimKeyBox.Text = "..."
end)

UIS.InputBegan:Connect(function(i, gpe)
    if gpe then return end
    if keyAwait then
        if i.KeyCode ~= Enum.KeyCode.Unknown then
            aimKey = tostring(i.KeyCode):gsub("Enum.KeyCode.", "")
            aimKeyBox.Text = aimKey
            keyAwait = false
        end
    end
end)

