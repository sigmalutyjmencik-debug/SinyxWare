-- Функция тоггла
local function toggleAim()
    cfg.aimbot = not cfg.aimbot
    TS:Create(TogBg, TweenInfo.new(0.2), {
        BackgroundColor3 = cfg.aimbot and Pink.medium or Pink.toggleOff
    }):Play()
    TS:Create(Knob, TweenInfo.new(0.2), {
        Position = cfg.aimbot and UDim2.new(1, -18, 0.5, -8) or UDim2.new(0, 2, 0.5, -8)
    }):Play()
end

TogBg.MouseButton1Click:Connect(toggleAim)
TogBg.TouchTap:Connect(toggleAim)

-- Назначение клавиши
