local winHubSection = mkSection(ML, "Win Hub Jump", 3)
local winHubEnabled = false
local winHubHeight = 5
local winHubSpeed = 50
local winHubConnection = nil

local function stopWinHub()
    if winHubConnection then
        winHubConnection:Disconnect()
        winHubConnection = nil
    end
end

local function startWinHub()
    stopWinHub()
    local hasBoosted = false
    winHubConnection = RunService.Heartbeat:Connect(function()
        if not winHubEnabled then stopWinHub() return end
        local char = LP.Character
        if not char then return end
        local hum = char:FindFirstChildOfClass("Humanoid")
        local root = char:FindFirstChild("HumanoidRootPart")
        if not hum or not root or hum.Health <= 0 then return end
        if hum.FloorMaterial == Enum.Material.Air then
            if not hasBoosted then
                root.CFrame = root.CFrame * CFrame.new(0, winHubHeight, 0)
                hum.WalkSpeed = winHubSpeed
                hasBoosted = true
            end
            local vel = root.AssemblyLinearVelocity
            root.AssemblyLinearVelocity = Vector3.new(vel.X, -3, vel.Z)
        else
            if hasBoosted then
                hum.WalkSpeed = 16
                hasBoosted = false
            end
        end
    end)
end

mkToggle(winHubSection, "Enable Win Hub Jump", false, function(val)
    winHubEnabled = val
    if val then startWinHub() else stopWinHub() end
end)
mkSlider(winHubSection, "Jump Height (studs)", 1, 7, 5, function(val)
    winHubHeight = val
end)
mkSlider(winHubSection, "Air Speed", 10, 200, 50, function(val)
    winHubSpeed = val
end)

