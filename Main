-- РўРѕРіРіР» СЃ Р°РЅРёРјР°С†РёРµР№
local function mkToggle(parent, label, default, cb)
    local row = Instance.new("Frame", parent)
    row.Size = UDim2.new(1,0,0,20); row.BackgroundTransparency = 1

    local lbl = Instance.new("TextLabel", row)
    lbl.Size = UDim2.new(1,-34,1,0); lbl.Position = UDim2.new(0,8,0,0)
    lbl.BackgroundTransparency = 1; lbl.Text = label
    lbl.TextColor3 = C.text; lbl.Font = Enum.Font.Gotham; lbl.TextSize = 8
    lbl.TextXAlignment = Enum.TextXAlignment.Left

    local pill = Instance.new("TextButton", row)
    pill.Size = UDim2.new(0,28,0,14); pill.Position = UDim2.new(1,-32,0.5,-7)
    pill.BackgroundColor3 = default and C.pink2 or C.togOff
    pill.BorderSizePixel = 0; pill.Text = ""; pill.AutoButtonColor = false
    corner(pill, 7)

    if default then
        local pg = Instance.new("UIGradient", pill)
        pg.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, Color3.fromRGB(255,120,210)),
            ColorSequenceKeypoint.new(1, Color3.fromRGB(180,40,140)),
        })
    end

    local knob = Instance.new("Frame", pill)
    knob.Size = UDim2.new(0,10,0,10)
    knob.Position = default and UDim2.new(1,-12,0.5,-5) or UDim2.new(0,2,0.5,-5)
    knob.BackgroundColor3 = C.white; knob.BorderSizePixel = 0
    corner(knob, 5)

    local val = default
    local function toggle()
        val = not val
        -- РђРЅРёРјР°С†РёСЏ РїРёР»Р»Р°
        TS:Create(pill, TweenInfo.new(0.18, Enum.EasingStyle.Quad), {
            BackgroundColor3 = val and C.pink2 or C.togOff
        }):Play()
        -- РђРЅРёРјР°С†РёСЏ СЂСѓС‡РєРё
        TS:Create(knob, TweenInfo.new(0.18, Enum.EasingStyle.Quad), {
            Position = val and UDim2.new(1,-12,0.5,-5) or UDim2.new(0,2,0.5,-5)
        }):Play()
        if cb then cb(val) end
    end

    pill.MouseButton1Click:Connect(toggle)
    pill.TouchTap:Connect(toggle)
    return row
end

-- РЎР»Р°Р№РґРµСЂ
local function mkSlider(parent, label, mn, mx, def, cb)
    local wrap = Instance.new("Frame", parent)
    wrap.Size = UDim2.new(1,0,0,32); wrap.BackgroundTransparency = 1

    local lbl = Instance.new("TextLabel", wrap)
    lbl.Size = UDim2.new(1,-8,0,13); lbl.Position = UDim2.new(0,8,0,2)
    lbl.BackgroundTransparency = 1; lbl.Text = label
    lbl.TextColor3 = C.text; lbl.Font = Enum.Font.Gotham; lbl.TextSize = 8
    lbl.TextXAlignment = Enum.TextXAlignment.Left

    local track = Instance.new("TextButton", wrap)
    track.Size = UDim2.new(1,-16,0,14); track.Position = UDim2.new(0,8,0,17)
    track.BackgroundColor3 = C.sliderBg
    track.BorderSizePixel = 0; track.Text = ""; track.AutoButtonColor = false
    corner(track, 3)

    local fill = Instance.new("Frame", track)
    fill.Size = UDim2.new((def-mn)/(mx-mn),0,1,0)
    fill.BackgroundColor3 = C.pink2; fill.BorderSizePixel = 0
    corner(fill, 3)

    local fGrad = Instance.new("UIGradient", fill)
    fGrad.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromRGB(255,140,220)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(170,40,130)),
    })

    local valLbl = Instance.new("TextLabel", track)
    valLbl.Size = UDim2.new(1,0,1,0); valLbl.BackgroundTransparency = 1
    valLbl.Text = ("%g/%g"):format(def, mx)
    valLbl.TextColor3 = C.white; valLbl.Font = Enum.Font.GothamBold; valLbl.TextSize = 7
    valLbl.ZIndex = 3

    -- Р СѓС‡РєР° СЃР»Р°Р№РґРµСЂР°
    local knob = Instance.new("Frame", fill)
    knob.Size = UDim2.new(0,8,0,8); knob.AnchorPoint = Vector2.new(0.5,0.5)
    knob.Position = UDim2.new(1,0,0.5,0)
    knob.BackgroundColor3 = C.white; knob.BorderSizePixel = 0
    corner(knob, 4)

    local val = def
    local sliding = false

    local function upd(ax)
        local rx = math.clamp(ax - track.AbsolutePosition.X, 0, track.AbsoluteSize.X)
        local pct = rx / track.AbsoluteSize.X
        val = math.floor(mn + (mx-mn)*pct + 0.5)
        fill.Size = UDim2.new(pct, 0, 1, 0)
        valLbl.Text = ("%g/%g"):format(val, mx)
        if cb then cb(val) end
    end

    track.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1
        or i.UserInputType == Enum.UserInputType.Touch then
            sliding = true; upd(i.Position.X)
        end
    end)
    UIS.InputChanged:Connect(function(i)
        if sliding and (i.UserInputType == Enum.UserInputType.MouseMovement
        or i.UserInputType == Enum.UserInputType.Touch) then upd(i.Position.X) end
    end)
    UIS.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1
        or i.UserInputType == Enum.UserInputType.Touch then sliding = false end
    end)

    return wrap
end

