local function mkInfoRow(parent, key, val, lo)
    local row = Instance.new("Frame", parent)
    row.Size = UDim2.new(1,0,0,16); row.BackgroundTransparency = 1; row.LayoutOrder = lo

    local kLbl = Instance.new("TextLabel", row)
    kLbl.Size = UDim2.new(0.35,0,1,0); kLbl.BackgroundTransparency = 1
    kLbl.Text = key; kLbl.TextColor3 = C.pink1
    kLbl.Font = Enum.Font.GothamBold; kLbl.TextSize = 8
    kLbl.TextXAlignment = Enum.TextXAlignment.Left

    local kGrad = Instance.new("UIGradient", kLbl)
    kGrad.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromRGB(255,140,220)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(180,60,150)),
    })

    local vLbl = Instance.new("TextLabel", row)
    vLbl.Size = UDim2.new(0.65,0,1,0); vLbl.Position = UDim2.new(0.35,0,0,0)
    vLbl.BackgroundTransparency = 1; vLbl.Text = val
    vLbl.TextColor3 = C.text; vLbl.Font = Enum.Font.Gotham; vLbl.TextSize = 8
    vLbl.TextXAlignment = Enum.TextXAlignment.Left

    return vLbl
end

