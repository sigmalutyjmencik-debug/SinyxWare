fovSG.Name="SW_FOV"; fovSG.IgnoreGuiInset=true; fovSG.ResetOnSpawn=false; fovSG.Parent=CG
local fovF = Instance.new("Frame",fovSG)
fovF.BackgroundTransparency=1; fovF.BorderSizePixel=0; fovF.Visible=false
Instance.new("UICorner",fovF).CornerRadius=UDim.new(1,0)
local fovStr = Instance.new("UIStroke",fovF)
fovStr.Color=Color3.fromRGB(255,100,200); fovStr.Thickness=1.5

RS.RenderStepped:Connect(function()
    local vp=Camera.ViewportSize; local r=AIM.FOV
    fovF.Size=UDim2.new(0,r*2,0,r*2)
    fovF.Position=UDim2.new(0,vp.X/2-r,0,vp.Y/2-r)
    fovF.Visible=AIM.Enabled
    if AIM.Enabled then
        local t=getTarget()
        if t then
            local cf=Camera.CFrame
            Camera.CFrame=CFrame.new(cf.Position,(t.Position-cf.Position).Unit+cf.Position)
        end
    end
end)

