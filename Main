-- Visuals
local auraEnabled = false
local skyboxEnabled = false
local particlesEnabled = false
local particleMultiplier = 5
local fogEnabled = false
local fogDistance = 500
local pulseEnabled = false
local pulseSize = 5
local activeEmitters = {}
local auraCharacter = LP.Character or LP.CharacterAdded:Wait()
