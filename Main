    infJumpEnabled = val
    local char = LP.Character
    if char and char:FindFirstChild("Humanoid") then
        if val then
            originalJumpPower = char.Humanoid.JumpPower
            char.Humanoid.JumpPower = 9999
        else
            char.Humanoid.JumpPower = originalJumpPower
        end
    end
end)

