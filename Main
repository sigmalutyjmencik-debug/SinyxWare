local function corner(f, r)
    Instance.new("UICorner", f).CornerRadius = UDim.new(0, r or 2)
end

local function mkToggle(parent, label, default, callback)
    local row = Instance.new("Frame", parent)
    row.Size = UDim2.new(1, 0, 0, 16)
    row.BackgroundTransparency = 1
    local lbl = Instance.new("TextLabel", row)
    lbl.Size = UDim2.new(1, -30, 1, 0)
    lbl.Position = UDim2.new(0, 5, 0, 0)
    lbl.BackgroundTransparency = 1
    lbl.Text = label
    lbl.TextColor3 = C.text
    lbl.Font = Enum.Font.Gotham
    lbl.TextSize = 7
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    local pill = Instance.new("TextButton", row)
    pill.Size = UDim2.new(0, 22, 0, 12)
    pill.Position = UDim2.new(1, -26, 0.5, -6)
    pill.BackgroundColor3 = default and C.red or C.togOff
    pill.BorderSizePixel = 0
    pill.Text = ""
    pill.AutoButtonColor = false
    corner(pill, 6)
    local knob = Instance.new("Frame", pill)
    knob.Size = UDim2.new(0, 8, 0, 8)
    knob.Position = default and UDim2.new(1, -10, 0.5, -4) or UDim2.new(0, 2, 0.5, -4)
    knob.BackgroundColor3 = C.white
    knob.BorderSizePixel = 0
    corner(knob, 4)
    local val = default
    local function toggle()
        val = not val
        TS:Create(pill, TweenInfo.new(0.12), { BackgroundColor3 = val and C.red or C.togOff }):Play()
        TS:Create(knob, TweenInfo.new(0.12), {
            Position = val and UDim2.new(1, -10, 0.5, -4) or UDim2.new(0, 2, 0.5, -4)
        }):Play()
        if callback then callback(val) end
        return val
    end
    pill.MouseButton1Click:Connect(toggle)
    return row, function() return val end, toggle
end

local function mkSlider(parent, label, mn, mx, def, callback)
    local wrap = Instance.new("Frame", parent)
    wrap.Size = UDim2.new(1, 0, 0, 26)
    wrap.BackgroundTransparency = 1
    local lbl = Instance.new("TextLabel", wrap)
    lbl.Size = UDim2.new(1, -5, 0, 11)
    lbl.Position = UDim2.new(0, 5, 0, 1)
    lbl.BackgroundTransparency = 1
    lbl.Text = label
    lbl.TextColor3 = C.text
    lbl.Font = Enum.Font.Gotham
    lbl.TextSize = 7
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    local track = Instance.new("TextButton", wrap)
    track.Size = UDim2.new(1, -10, 0, 12)
    track.Position = UDim2.new(0, 5, 0, 13)
    track.BackgroundColor3 = C.redDark
    track.BorderSizePixel = 0
    track.Text = ""
    track.AutoButtonColor = false
    corner(track, 2)
    local fill = Instance.new("Frame", track)
    fill.Size = UDim2.new((def - mn) / (mx - mn), 0, 1, 0)
    fill.BackgroundColor3 = C.red
    fill.BorderSizePixel = 0
    corner(fill, 2)
    local fillGrad = Instance.new("UIGradient", fill)
    fillGrad.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 100, 160)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(180, 30, 80)),
    })
    local valLbl = Instance.new("TextLabel", track)
    valLbl.Size = UDim2.new(1, 0, 1, 0)
    valLbl.BackgroundTransparency = 1
    valLbl.Text = tostring(def)
    valLbl.TextColor3 = C.white
    valLbl.Font = Enum.Font.GothamBold
    valLbl.TextSize = 7
    valLbl.ZIndex = 3
    local val = def
    local sliding = false
    local function upd(ax)
        local rx = math.clamp(ax - track.AbsolutePosition.X, 0, track.AbsoluteSize.X)
        local pct = rx / track.AbsoluteSize.X
        val = math.floor(mn + (mx - mn) * pct + 0.5)
        fill.Size = UDim2.new(pct, 0, 1, 0)
        valLbl.Text = tostring(val)
        if callback then callback(val) end
    end
    track.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            sliding = true; upd(i.Position.X)
        end
    end)
    UIS.InputChanged:Connect(function(i)
        if sliding and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
            upd(i.Position.X)
        end
    end)
    UIS.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            sliding = false
        end
    end)
    return wrap, function() return val end
end

-- Р“Р»РѕР±Р°Р»СЊРЅС‹Р№ С†РІРµС‚РѕРїРёРєРµСЂ GUI (РѕРґРёРЅ РЅР° РІРµСЃСЊ СЃРєСЂРёРїС‚)
local colorPickerGui = nil
local colorPickerCallback = nil
local colorPickerPreview = nil

local function openColorPicker(previewBtn, cb)
    colorPickerCallback = cb
    colorPickerPreview = previewBtn
    if colorPickerGui then colorPickerGui:Destroy() end

    local pg = LP:FindFirstChildOfClass("PlayerGui")
    if not pg then return end
    colorPickerGui = Instance.new("ScreenGui")
    colorPickerGui.Name = "SW_ColorPicker"
    colorPickerGui.ResetOnSpawn = false
    colorPickerGui.ZIndexBehavior = Enum.ZIndexBehavior.Global
    colorPickerGui.DisplayOrder = 9999
    colorPickerGui.Parent = pg

    -- Р—Р°С‚РµРјРЅС‘РЅРЅС‹Р№ С„РѕРЅ
    local overlay = Instance.new("TextButton", colorPickerGui)
    overlay.Size = UDim2.new(1,0,1,0)
    overlay.BackgroundColor3 = Color3.fromRGB(0,0,0)
    overlay.BackgroundTransparency = 0.5
    overlay.BorderSizePixel = 0
    overlay.Text = ""
    overlay.AutoButtonColor = false
    overlay.ZIndex = 1
    overlay.MouseButton1Click:Connect(function()
        colorPickerGui:Destroy(); colorPickerGui = nil
    end)

    -- РћРєРЅРѕ РїРёРєРµСЂР°
    local win = Instance.new("Frame", colorPickerGui)
    win.Size = UDim2.new(0, 200, 0, 240)
    win.Position = UDim2.new(0.5, -100, 0.5, -120)
    win.BackgroundColor3 = Color3.fromRGB(35, 18, 30)
    win.BorderSizePixel = 0
    win.ZIndex = 2
    corner(win, 8)
    local wg = Instance.new("UIGradient", win)
    wg.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromRGB(50, 22, 42)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(25, 12, 22)),
    })
    wg.Rotation = 135

    local titleL = Instance.new("TextLabel", win)
    titleL.Size = UDim2.new(1,0,0,26)
    titleL.BackgroundTransparency = 1
    titleL.Text = "Pick Color"
    titleL.TextColor3 = Color3.fromRGB(255,130,210)
    titleL.Font = Enum.Font.GothamBold
    titleL.TextSize = 11
    titleL.ZIndex = 3

    local closeBtn = Instance.new("TextButton", win)
    closeBtn.Size = UDim2.new(0,20,0,20)
    closeBtn.Position = UDim2.new(1,-24,0,3)
    closeBtn.BackgroundColor3 = Color3.fromRGB(180,30,70)
    closeBtn.Text = "вњ•"
    closeBtn.TextColor3 = Color3.fromRGB(255,255,255)
    closeBtn.Font = Enum.Font.GothamBold
    closeBtn.TextSize = 10
    closeBtn.BorderSizePixel = 0
    closeBtn.ZIndex = 4
    corner(closeBtn, 4)
    closeBtn.MouseButton1Click:Connect(function()
        colorPickerGui:Destroy(); colorPickerGui = nil
    end)

    -- РџР°Р»РёС‚СЂР° С†РІРµС‚РѕРІ (6x8 = 48 С†РІРµС‚РѕРІ)
    local palette = Instance.new("Frame", win)
    palette.Size = UDim2.new(1,-16,0,130)
    palette.Position = UDim2.new(0,8,0,30)
    palette.BackgroundTransparency = 1
    palette.ZIndex = 3

    local COLORS = {
        -- Reds
        Color3.fromRGB(255,0,0), Color3.fromRGB(220,50,50), Color3.fromRGB(255,80,80),
        Color3.fromRGB(180,0,0), Color3.fromRGB(255,120,120), Color3.fromRGB(140,0,0),
        -- Pinks
        Color3.fromRGB(255,0,150), Color3.fromRGB(255,60,180), Color3.fromRGB(220,50,120),
        Color3.fromRGB(255,130,200), Color3.fromRGB(200,0,100), Color3.fromRGB(255,180,220),
        -- Purples
        Color3.fromRGB(150,0,255), Color3.fromRGB(180,50,255), Color3.fromRGB(100,0,200),
        Color3.fromRGB(200,100,255), Color3.fromRGB(80,0,160), Color3.fromRGB(220,160,255),
        -- Blues
        Color3.fromRGB(0,100,255), Color3.fromRGB(50,150,255), Color3.fromRGB(0,50,200),
        Color3.fromRGB(100,180,255), Color3.fromRGB(0,200,255), Color3.fromRGB(150,220,255),
        -- Greens
        Color3.fromRGB(0,255,0), Color3.fromRGB(50,220,50), Color3.fromRGB(0,180,0),
        Color3.fromRGB(100,255,100), Color3.fromRGB(0,255,150), Color3.fromRGB(150,255,200),
        -- Yellows/Orange
        Color3.fromRGB(255,255,0), Color3.fromRGB(255,200,0), Color3.fromRGB(255,150,0),
        Color3.fromRGB(255,100,0), Color3.fromRGB(255,220,100), Color3.fromRGB(200,150,0),
        -- Whites/Grays
        Color3.fromRGB(255,255,255), Color3.fromRGB(200,200,200), Color3.fromRGB(150,150,150),
        Color3.fromRGB(100,100,100), Color3.fromRGB(50,50,50), Color3.fromRGB(0,0,0),
        -- Neons
        Color3.fromRGB(255,0,255), Color3.fromRGB(0,255,255), Color3.fromRGB(255,255,0),
        Color3.fromRGB(128,255,0), Color3.fromRGB(0,128,255), Color3.fromRGB(255,128,0),
    }

    local COLS = 6
    local btnSz = (palette.Size.X.Offset or 184) / COLS
    for i, col in ipairs(COLORS) do
        local row = math.floor((i-1) / COLS)
        local c   = (i-1) % COLS
        local btn = Instance.new("TextButton", palette)
        btn.Size = UDim2.new(0, 28, 0, 16)
        btn.Position = UDim2.new(0, c*31, 0, row*18)
        btn.BackgroundColor3 = col
