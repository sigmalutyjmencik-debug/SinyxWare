-- ================================================================
--  ВСТРОЕННЫЙ ESP (из твоего кода, с привязкой к тогглам)
-- ================================================================
local espData = {}
local rainbowOffset = 0

local function GetRainbowColor()
    rainbowOffset = (rainbowOffset + 0.005) % 1
    return Color3.fromHSV(rainbowOffset, 1, 1)
}

local function CreateESP(player)
    if player == LP or espData[player] then return end
    local e = {
        Box = Drawing.new("Square"),
        Name = Drawing.new("Text"),
        Health = Drawing.new("Square"),
        Dist = Drawing.new("Text"),
    }
    e.Box.Filled = false
    e.Box.Thickness = 1.5
    e.Box.Visible = false
    e.Name.Size = 12
    e.Name.Center = true
    e.Name.Outline = true
    e.Name.OutlineColor = Color3.fromRGB(0,0,0)
    e.Name.Font = 3
    e.Name.Visible = false
    e.Health.Filled = true
    e.Health.Thickness = 1
    e.Health.Visible = false
    e.Dist.Size = 10
    e.Dist.Center = true
    e.Dist.Outline = true
    e.Dist.OutlineColor = Color3.fromRGB(0,0,0)
    e.Dist.Font = 3
    e.Dist.Visible = false
    espData[player] = e
end

local function RemoveESP(player)
    local e = espData[player]
    if e then
        pcall(function()
            e.Box:Remove()
            e.Name:Remove()
            e.Health:Remove()
            e.Dist:Remove()
        end)
        espData[player] = nil
    end
end

for _, plr in pairs(Players:GetPlayers()) do CreateESP(plr) end
Players.PlayerAdded:Connect(CreateESP)
Players.PlayerRemoving:Connect(RemoveESP)

-- Получаем значения тогглов (костыль, но работает)
local function getToggleState(parent, label)
    for _, child in ipairs(parent:GetChildren()) do
        if child:IsA("Frame") then
            local lbl = child:FindFirstChildOfClass("TextLabel")
            if lbl and lbl.Text == label then
                local pill = child:FindFirstChildOfClass("TextButton")
                if pill then
                    return pill.BackgroundColor3 == C.red
                end
            end
        end
    end
    return false
end

RunService.RenderStepped:Connect(function()
    local enabled = getToggleState(VBody, "Players")
    local showBox = getToggleState(VBody, "Boxes")
    local showName = getToggleState(VBody, "Names")
    local showHealth = getToggleState(VBody, "Health")
    local showTracers = getToggleState(VBody, "Tracers")

    if not enabled then
        for _, e in pairs(espData) do
            e.Box.Visible = false
            e.Name.Visible = false
            e.Health.Visible = false
            e.Dist.Visible = false
        end
        return
    end

    local rainbow = GetRainbowColor()
    for plr, e in pairs(espData) do
        local char = plr.Character
        if not char or not char.Parent then
            e.Box.Visible = false
            e.Name.Visible = false
            e.Health.Visible = false
            e.Dist.Visible = false
            continue
        end

        local root = char:FindFirstChild("HumanoidRootPart")
        local head = char:FindFirstChild("Head")
        if not root or not head then
            e.Box.Visible = false
            e.Name.Visible = false
            e.Health.Visible = false
            e.Dist.Visible = false
            continue
        end

        local topPos = head.Position + Vector3.new(0, head.Size.Y/2, 0)
        local bottomPos = root.Position - Vector3.new(0, root.Size.Y/2, 0)
        local rightOffset = root.CFrame:VectorToWorldSpace(Vector3.new(root.Size.X/2, 0, 0))
        local leftOffset = root.CFrame:VectorToWorldSpace(Vector3.new(-root.Size.X/2, 0, 0))
        local rightPos = root.Position + rightOffset
        local leftPos = root.Position + leftOffset

        local topV, topOn = Camera:WorldToViewportPoint(topPos)
        local bottomV, bottomOn = Camera:WorldToViewportPoint(bottomPos)
        local rightV, rightOn = Camera:WorldToViewportPoint(rightPos)
        local leftV, leftOn = Camera:WorldToViewportPoint(leftPos)

        if not (topOn or bottomOn or rightOn or leftOn) then
            e.Box.Visible = false
            e.Name.Visible = false
            e.Health.Visible = false
            e.Dist.Visible = false
            continue
        end

        local height = math.abs(topV.Y - bottomV.Y)
        local width = math.abs(rightV.X - leftV.X)
        if height < 5 then height = 5 end
        if width < 5 then width = 5 end

        local centerX = (leftV.X + rightV.X) / 2
        local centerY = (topV.Y + bottomV.Y) / 2
        local dist = (Camera.CFrame.Position - root.Position).Magnitude

        if showBox then
            e.Box.Visible = true
            e.Box.Size = Vector2.new(width, height)
            e.Box.Position = Vector2.new(centerX - width/2, centerY - height/2)
            e.Box.Color = rainbow
        else
            e.Box.Visible = false
        end

        if showName then
            e.Name.Visible = true
            e.Name.Text = plr.Name
            e.Name.Position = Vector2.new(centerX, topV.Y - 15)
            e.Name.Color = rainbow
        else
            e.Name.Visible = false
        end

        if showHealth then
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum and hum.MaxHealth > 0 then
                local hp = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
                e.Health.Visible = true
                e.Health.Size = Vector2.new(2, height * hp)
                e.Health.Position = Vector2.new(centerX - width/2 - 4, centerY + height/2 - height*hp)
                e.Health.Color = Color3.fromRGB(255*(1-hp), 255*hp, 0)
            else
                e.Health.Visible = false
            end
        else
            e.Health.Visible = false
        end

        if showTracers then
            e.Dist.Visible = true
            e.Dist.Text = math.floor(dist) .. "m"
            e.Dist.Position = Vector2.new(centerX, bottomV.Y + 15)
            e.Dist.Color = rainbow
        else
            e.Dist.Visible = false
        end
    end
end)

-- ================================================================
--  HIDE / SHOW — Insert
-- ================================================================
local visible = true
UIS.InputBegan:Connect(function(i, gpe)
    if gpe then return end
    if i.KeyCode == Enum.KeyCode.Insert then
        visible = not visible
        Outer.Visible = visible
    end
end)

