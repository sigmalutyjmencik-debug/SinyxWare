-- ================================================================
--  АИМБОТ ЛОГИКА (через RenderStepped)
-- ================================================================
local function getTargetPart(character)
    if targetPart == "Head" then
        return character:FindFirstChild("Head")
    elseif targetPart == "Torso" then
        return character:FindFirstChild("Torso") or character:FindFirstChild("UpperTorso")
    else
        return character:FindFirstChild("HumanoidRootPart")
    end
end

RunService.RenderStepped:Connect(function()
    if not aimbotEnabled then return end

    local localChar = LP.Character
    if not localChar or not localChar:FindFirstChild("HumanoidRootPart") then return end

    local camera = workspace.CurrentCamera
    local mousePos = UIS:GetMouseLocation()
    local screenCenter = camera.ViewportSize / 2

    local closestDist = circleRadius
    local closestPlayer = nil
    local closestPart = nil

    -- Если есть залоченная цель
    if lockButtonEnabled and lockTarget and lockTarget.Parent and lockTarget.Parent:FindFirstChild("Humanoid") then
        local part = getTargetPart(lockTarget.Parent)
        if part and part:IsDescendantOf(workspace) then
            closestPlayer = lockTarget.Parent
            closestPart = part
        else
            lockTarget = nil
        end
    end

    -- Поиск цели
    if not closestPlayer then
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LP and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                local char = player.Character
                local humanoid = char:FindFirstChild("Humanoid")
                if humanoid and humanoid.Health > 0 then
                    local part = getTargetPart(char)
                    if part then
                        local pos, onScreen = camera:WorldToViewportPoint(part.Position)
                        if onScreen then
                            local dist = (Vector2.new(pos.X, pos.Y) - screenCenter).Magnitude
                            if dist < closestDist then
                                closestDist = dist
                                closestPlayer = player
                                closestPart = part
                            end
                        end
                    end
                end
            end
        end
    end

    if closestPlayer and closestPart then
        local targetPos = closestPart.Position

        -- Prediction
        local velocity = closestPart.Velocity or Vector3.new()
        targetPos = targetPos + (velocity * prediction)

        local screenPos, onScreen = camera:WorldToViewportPoint(targetPos)
        if onScreen then
            local smoothFactor = smoothness / 100
            local targetScreen = Vector2.new(screenPos.X, screenPos.Y)
            local currentMouse = UIS:GetMouseLocation()
            local newMouse = currentMouse:Lerp(targetScreen, math.min(smoothFactor, 1))

            if smoothFactor >= 0.99 then
                mousemoverel(targetScreen.X - currentMouse.X, targetScreen.Y - currentMouse.Y)
            else
                mousemoverel(newMouse.X - currentMouse.X, newMouse.Y - currentMouse.Y)
            end

            if lockButtonEnabled then
                lockTarget = closestPart
            else
                currentTarget = closestPlayer
            end
        end
    end

    -- Рисуем круг
    if aimbotCircleEnabled then
        -- Используем Drawing API для круга
        local circle = Drawing.new("Circle")
        circle.Radius = circleRadius
        circle.Position = screenCenter
        circle.Thickness = 2
        circle.Color = Color3.fromRGB(220, 50, 100)
        circle.Transparency = 1
        circle.Visible = true
        circle.Filled = false
        circle.NumSides = 60
        task.wait()
        circle:Remove()
    end
end)

-- ================================================================
--  HIDE / SHOW
-- ================================================================
local visible = true
UIS.InputBegan:Connect(function(i, gpe)
    if gpe then return end
    if i.KeyCode == Enum.KeyCode.Insert then
        visible = not visible
        Outer.Visible = visible
        if mobileButton then mobileButton.Visible = visible end
        if snowButtonObj then snowButtonObj.Visible = visible end
        if lockButtonObj then lockButtonObj.Visible = visible end
    end
end)

