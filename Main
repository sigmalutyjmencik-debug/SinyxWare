local function corner(f, r) Instance.new("UICorner", f).CornerRadius = UDim.new(0, r or 3) end

local function mkScroll(parent)
    local f = Instance.new("ScrollingFrame", parent)
    f.Size = UDim2.new(1, 0, 1, 0)
    f.BackgroundTransparency = 1
    f.BorderSizePixel = 0
    f.ScrollBarThickness = 2
    f.ScrollBarImageColor3 = C.pink2
    f.AutomaticCanvasSize = Enum.AutomaticSize.Y
    f.CanvasSize = UDim2.new()
    local l = Instance.new("UIListLayout", f)
    l.Padding = UDim.new(0, 6); l.SortOrder = Enum.SortOrder.LayoutOrder
    local p = Instance.new("UIPadding", f)
    p.PaddingTop = UDim.new(0, 8); p.PaddingLeft = UDim.new(0, 6); p.PaddingRight = UDim.new(0, 6)
    return f
end

-- РЎРµРєС†РёСЏ
local function mkSection(parent, title, lo)
    local wrap = Instance.new("Frame", parent)
    wrap.Size = UDim2.new(1, 0, 0, 0)
    wrap.AutomaticSize = Enum.AutomaticSize.Y
