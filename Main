-- ================================================================
--  КОНФИГИ
-- ================================================================
local configDir = "SinyxWare_Configs"

local function ensureConfigFolder()
    if not isfolder(configDir) then
        makefolder(configDir)
    end
end

local function saveConfig(name)
    ensureConfigFolder()
    local config = {
        aimbot = {
            enabled = aimbotEnabled,
            circleEnabled = aimbotCircleEnabled,
            circleRadius = circleRadius,
            smoothness = smoothness,
            prediction = prediction,
            targetPart = targetPart
        },
        esp = {
            enabled = espEnabled,
            showBox = espShowBox,
            showName = espShowName,
            showHP = espShowHP,
            showDist = espShowDist,
            showTracer = espShowTracer
        },
        misc = {
            speedEnabled = speedHackEnabled,
            speedValue = speedValue,
            infJumpEnabled = infJumpEnabled,
            noClipEnabled = noClipEnabled
        },
        visuals = {
            pulseEnabled = pulseEnabled,
            pulseSpeed = pulseSpeed,
            skyboxType = skyboxType,
            fogEnabled = fogEnabled,
            fogDistance = fogDistance,
            auraEnabled = auraEnabled,
            auraType = auraType,
            ambientEnabled = ambientEnabled,
            particlesEnabled = particlesEnabled,
            particleType = particleType
        }
    }
    
    local json = HttpService:JSONEncode(config)
    local path = configDir .. "/" .. name .. ".json"
    writefile(path, json)
    print("[SinyxWare] Config saved: " .. name)
end

local function loadConfig(name)
    local path = configDir .. "/" .. name .. ".json"
    if not isfile(path) then
        print("[SinyxWare] Config not found: " .. name)
        return false
    end
    
    local json = readfile(path)
    local config = HttpService:JSONDecode(json)
    
    if config.aimbot then
        aimbotEnabled = config.aimbot.enabled or false
        aimbotCircleEnabled = config.aimbot.circleEnabled or false
        circleRadius = config.aimbot.circleRadius or 50
        smoothness = config.aimbot.smoothness or 50
        prediction = config.aimbot.prediction or 0
        targetPart = config.aimbot.targetPart or "Head"
    end
    
    if config.esp then
        espEnabled = config.esp.enabled or false
        espShowBox = config.esp.showBox or true
        espShowName = config.esp.showName or true
        espShowHP = config.esp.showHP or true
        espShowDist = config.esp.showDist or true
        espShowTracer = config.esp.showTracer or true
    end
    
    if config.misc then
        speedHackEnabled = config.misc.speedEnabled or false
        speedValue = config.misc.speedValue or 50
        infJumpEnabled = config.misc.infJumpEnabled or false
        noClipEnabled = config.misc.noClipEnabled or false
    end
    
    if config.visuals then
        pulseEnabled = config.visuals.pulseEnabled or false
        pulseSpeed = config.visuals.pulseSpeed or 1
        skyboxType = config.visuals.skyboxType or "Default"
        fogEnabled = config.visuals.fogEnabled or false
        fogDistance = config.visuals.fogDistance or 500
        auraEnabled = config.visuals.auraEnabled or false
        auraType = config.visuals.auraType or "Edge"
        ambientEnabled = config.visuals.ambientEnabled or false
        particlesEnabled = config.visuals.particlesEnabled or false
        particleType = config.visuals.particleType or "Sparkles"
    end
    
    print("[SinyxWare] Config loaded: " .. name)
    return true
end

local function getConfigList()
    ensureConfigFolder()
    local files = listfiles(configDir)
    local names = {}
    for _, file in ipairs(files) do
        local name = file:match("([^/\\]+)%.json$")
        if name then
            table.insert(names, name)
        end
    end
    return names
end

local function deleteConfig(name)
    local path = configDir .. "/" .. name .. ".json"
    if isfile(path) then
        delfile(path)
        print("[SinyxWare] Config deleted: " .. name)
        return true
    end
    return false
end

local function updateAllUI()
    print("[SinyxWare] UI updated with loaded config")
end

updateConfigList()

-- ================================================================
--  АИМБОТ ЛОГИКА
-- ================================================================
local function getTargetPart(character)
    if targetPart == "Head" then
        return character:FindFirstChild("Head")
    elseif targetPart == "Torso" then
        return character:FindFirstChild("Torso") or character:FindFirstChild("UpperTorso")
    else
        return character:FindFirstChild("HumanoidRootPart")
    end
end

local aimbotCircle = nil

RunService.RenderStepped:Connect(function()
    -- Рисуем круг
    if aimbotCircleEnabled then
        if not aimbotCircle then
            aimbotCircle = Drawing.new("Circle")
            aimbotCircle.Thickness = 2
            aimbotCircle.Color = Color3.fromRGB(220, 50, 100)
            aimbotCircle.Transparency = 1
            aimbotCircle.Filled = false
            aimbotCircle.NumSides = 60
        end
        aimbotCircle.Radius = circleRadius
        aimbotCircle.Position = Camera.ViewportSize / 2
        aimbotCircle.Visible = true
    else
        if aimbotCircle then
            aimbotCircle.Visible = false
        end
    end
    
    -- Аимбот
    if not aimbotEnabled then return end

    local localChar = LP.Character
    if not localChar or not localChar:FindFirstChild("HumanoidRootPart") then return end

    local screenCenter = Camera.ViewportSize / 2

    local closestDist = circleRadius
    local closestPlayer = nil
    local closestPart = nil

    if lockButtonEnabled and lockTarget and lockTarget.Parent then
        local part = lockTarget
        if part and part:IsDescendantOf(workspace) then
            local pos, onScreen = Camera:WorldToViewportPoint(part.Position)
            if onScreen then
                closestPart = part
                closestPlayer = lockTarget.Parent
            else
                lockTarget = nil
            end
        else
            lockTarget = nil
        end
    end

    if not closestPlayer then
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LP and player.Character then
                local char = player.Character
                local humanoid = char:FindFirstChild("Humanoid")
                if humanoid and humanoid.Health > 0 then
                    local part = getTargetPart(char)
                    if part then
                        local pos, onScreen = Camera:WorldToViewportPoint(part.Position)
                        if onScreen then
                            local dist = (Vector2.new(pos.X, pos.Y) - screenCenter).Magnitude
                            if dist < closestDist then
                                closestDist = dist
                                closestPlayer = player
                                closestPart = part
                            end
                        end
                    end
                end
            end
        end
    end

    if closestPlayer and closestPart then
        local targetPos = closestPart.Position
        
        if prediction > 0 then
            local velocity = closestPart.Velocity or Vector3.new()
            targetPos = targetPos + (velocity * prediction)
        end
        
        local screenPos, onScreen = Camera:WorldToViewportPoint(targetPos)
        if onScreen then
            local smoothFactor = smoothness / 100
            
            if smoothFactor >= 0.95 then
                mousemoverel(screenPos.X - screenCenter.X, screenPos.Y - screenCenter.Y)
            else
                local currentMouse = UIS:GetMouseLocation()
                local targetScreen = Vector2.new(screenPos.X, screenPos.Y)
                local newMouse = currentMouse:Lerp(targetScreen, smoothFactor)
                mousemoverel(newMouse.X - currentMouse.X, newMouse.Y - currentMouse.Y)
            end
            
            if lockButtonEnabled then
                lockTarget = closestPart
            end
        end
    end
end)

-- ================================================================
--  MISC ЛОГИКА (Infinite Jump исправлен)
-- ================================================================
LP.CharacterAdded:Connect(function(char)
    task.wait(0.5)
    if speedHackEnabled then
        local humanoid = char:FindFirstChild("Humanoid")
        if humanoid then
            humanoid.WalkSpeed = speedValue
        end
    end
    if infJumpEnabled then
        local humanoid = char:FindFirstChild("Humanoid")
        if humanoid then
            originalJumpPower = humanoid.JumpPower
            humanoid.JumpPower = 9999
            humanoid:SetStateEnabled(Enum.HumanoidStateType.Jumping, true)
        end
    end
    if noClipEnabled then
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
            end
        end
    end
    if auraEnabled then
        setupAura()
    end
end)

-- Обработка прыжка для Infinite Jump
UIS.InputBegan:Connect(function(input, gpe)
    if gpe then return end
    if infJumpEnabled and input.UserInputType == Enum.UserInputType.Keyboard then
        if input.KeyCode == Enum.KeyCode.Space then
            local char = LP.Character
            if char and char:FindFirstChild("Humanoid") then
                local humanoid = char.Humanoid
                if humanoid:GetState() == Enum.HumanoidStateType.Landed then
                    humanoid.Jump = true
                    task.wait(0.1)
                    humanoid.Jump = false
                end
            end
        end
    end
end)

-- No Clip мониторинг
RunService.RenderStepped:Connect(function()
    if noClipEnabled then
        local char = LP.Character
        if char then
            for _, part in ipairs(char:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.CanCollide = false
                end
            end
        end
    end
end)

