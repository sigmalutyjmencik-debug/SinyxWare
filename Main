    end
end)

-- ================================================================
--  JUMP CIRCLE
-- ================================================================
local jumpCircleFolder = workspace:FindFirstChild("PureRingEffects")
if not jumpCircleFolder then
    jumpCircleFolder = Instance.new("Folder")
    jumpCircleFolder.Name = "PureRingEffects"
    jumpCircleFolder.Parent = workspace
end

local jcGlobalHue = 0
local jcHasBounced = false

RunService.Heartbeat:Connect(function(dt)
    jcGlobalHue = jcGlobalHue + 0.6 * dt
    if jcGlobalHue > 1 then jcGlobalHue = jcGlobalHue - 1 end
    if not jumpCircleEnabled then return end
    local char = LP.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local root = char:FindFirstChild("HumanoidRootPart")
    if not hum or not root or hum.Health <= 0 then return end
    if hum.FloorMaterial == Enum.Material.Air then
        if not jcHasBounced then
            jcHasBounced = true
            -- РЎРїР°РІРЅРёРј РєРѕР»СЊС†Рѕ
            local rp = RaycastParams.new()
            rp.FilterDescendantsInstances = {char, jumpCircleFolder}
            rp.FilterType = Enum.RaycastFilterType.Exclude
            local res = workspace:Raycast(root.Position, Vector3.new(0,-6,0), rp)
            local pos = res and res.Position + Vector3.new(0,0.05,0) or root.Position - Vector3.new(0,3,0)

            local part = Instance.new("Part")
            part.Size = Vector3.new(1,1,1)
            part.CFrame = CFrame.new(pos) * CFrame.Angles(math.rad(90),0,0)
            part.Material = Enum.Material.Neon
            part.Color = Color3.fromHSV(jcGlobalHue,1,1)
            part.Transparency = 0.1
            part.Anchored = true
            part.CanCollide = false
            part.CastShadow = false
            part.Parent = jumpCircleFolder

            local mesh = Instance.new("SpecialMesh", part)
            mesh.MeshType = Enum.MeshType.FileMesh
            mesh.MeshId = "rbxassetid://3270017"
            mesh.Scale = Vector3.new(5,5,0.2)

            local FRAMES = 30
            task.spawn(function()
                for i = 1, FRAMES do
                    if not part.Parent then break end
                    local prog = i / FRAMES
                    mesh.Scale = Vector3.new(5*(1-prog), 5*(1-prog), 0.2)
                    part.Transparency = 0.1 + 0.9 * prog
                    part.Color = Color3.fromHSV(jcGlobalHue,1,1)
                    task.wait(1.0 / FRAMES)
                end
                if part.Parent then part:Destroy() end
            end)
        end
    else
        jcHasBounced = false
    end
end)

-- ================================================================
--  COOBIK
-- ================================================================
local coobikFolder = workspace:FindFirstChild("BodyCubeEffects")
if not coobikFolder then
    coobikFolder = Instance.new("Folder")
    coobikFolder.Name = "BodyCubeEffects"
    coobikFolder.Parent = workspace
end

task.spawn(function()
    local lastSpawn = 0
    while true do
        task.wait(0.05)
        if coobikEnabled then
            local now = tick()
            if now - lastSpawn >= coobikDelay then
                lastSpawn = now
                local char = LP.Character
                if char then
                    local hum = char:FindFirstChildOfClass("Humanoid")
                    local root = char:FindFirstChild("HumanoidRootPart")
                    if hum and root and hum.Health > 0 then
                        local cube = Instance.new("Part")
                        cube.Shape = Enum.PartType.Block
                        cube.Size = Vector3.new(1,1,1)
                        cube.CFrame = root.CFrame
                        cube.Material = Enum.Material.Neon
                        cube.Color = Color3.fromRGB(255,255,255)
                        cube.Transparency = 0.3
                        cube.Anchored = true
                        cube.CanCollide = false
                        cube.CastShadow = false
                        cube.Parent = coobikFolder
                        task.delay(0.6, function()
                            if cube and cube.Parent then cube:Destroy() end
                        end)
                    end
                end
            end
        end
    end
end)

