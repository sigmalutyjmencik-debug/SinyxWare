    local cv=Instance.new("TextButton",hdr)
    cv.Size=UDim2.new(0,20,1,0); cv.Position=UDim2.new(1,-22,0,0)
    cv.BackgroundTransparency=1; cv.Text="в€Ё"
    cv.TextColor3=Color3.fromRGB(150,100,140); cv.Font=Enum.Font.GothamBold
    cv.TextSize=11; cv.AutoButtonColor=false

