    rgbLabel.ZIndex = 3

    local rgbBox = Instance.new("TextBox", win)
    rgbBox.Size = UDim2.new(1,-16,0,22)
    rgbBox.Position = UDim2.new(0,8,0,184)
    rgbBox.BackgroundColor3 = Color3.fromRGB(45,22,38)
    rgbBox.Text = ""
    rgbBox.PlaceholderText = "R, G, B (0-255)"
    rgbBox.PlaceholderColor3 = Color3.fromRGB(120,80,110)
    rgbBox.TextColor3 = Color3.fromRGB(220,200,215)
    rgbBox.Font = Enum.Font.Gotham
    rgbBox.TextSize = 8
    rgbBox.BorderSizePixel = 0
    rgbBox.ZIndex = 4
    corner(rgbBox, 4)

    local applyBtn = Instance.new("TextButton", win)
    applyBtn.Size = UDim2.new(1,-16,0,22)
    applyBtn.Position = UDim2.new(0,8,0,210)
    applyBtn.BackgroundColor3 = Color3.fromRGB(200,50,120)
    applyBtn.Text = "Apply"
    applyBtn.TextColor3 = Color3.fromRGB(255,255,255)
    applyBtn.Font = Enum.Font.GothamBold
    applyBtn.TextSize = 9
    applyBtn.BorderSizePixel = 0
    applyBtn.ZIndex = 4
    corner(applyBtn, 4)
    local apg = Instance.new("UIGradient", applyBtn)
    apg.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromRGB(255,100,180)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(160,30,90)),
    })
    applyBtn.MouseButton1Click:Connect(function()
        local r,g,b = rgbBox.Text:match("(%d+)%D+(%d+)%D+(%d+)")
        if r then
            local col = Color3.fromRGB(
                math.clamp(tonumber(r),0,255),
                math.clamp(tonumber(g),0,255),
                math.clamp(tonumber(b),0,255)
            )
            if colorPickerPreview then colorPickerPreview.BackgroundColor3 = col end
            if colorPickerCallback then colorPickerCallback(col) end
            colorPickerGui:Destroy(); colorPickerGui = nil
        end
    end)
end

local function mkColorPicker(parent, label, defaultColor, callback)
    local wrap = Instance.new("Frame", parent)
    wrap.Size = UDim2.new(1, 0, 0, 20)
    wrap.BackgroundTransparency = 1

    local lbl = Instance.new("TextLabel", wrap)
    lbl.Size = UDim2.new(0.55, 0, 1, 0)
    lbl.BackgroundTransparency = 1
    lbl.Text = label
    lbl.TextColor3 = C.text
    lbl.Font = Enum.Font.Gotham
    lbl.TextSize = 7
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Position = UDim2.new(0,5,0,0)

    local colorBtn = Instance.new("TextButton", wrap)
    colorBtn.Size = UDim2.new(0, 40, 0, 14)
    colorBtn.Position = UDim2.new(1, -44, 0.5, -7)
    colorBtn.BackgroundColor3 = defaultColor
    colorBtn.BorderSizePixel = 0
    colorBtn.Text = "в—Џ"
    colorBtn.TextColor3 = Color3.fromRGB(255,255,255)
    colorBtn.TextSize = 8
    colorBtn.Font = Enum.Font.GothamBold
    colorBtn.AutoButtonColor = false
    corner(colorBtn, 3)

    local currentColor = defaultColor
    colorBtn.MouseButton1Click:Connect(function()
        openColorPicker(colorBtn, function(col)
            currentColor = col
            colorBtn.BackgroundColor3 = col
            if callback then callback(col) end
        end)
    end)
    return wrap, function() return currentColor end
end

local function mkDropdown(parent, label, options, default, callback)
    local wrap = Instance.new("Frame", parent)
    wrap.Size = UDim2.new(1, 0, 0, 28)
    wrap.BackgroundTransparency = 1
    local lbl = Instance.new("TextLabel", wrap)
    lbl.Size = UDim2.new(1, -5, 0, 11)
    lbl.Position = UDim2.new(0, 5, 0, 1)
    lbl.BackgroundTransparency = 1
    lbl.Text = label
    lbl.TextColor3 = C.text
    lbl.Font = Enum.Font.Gotham
    lbl.TextSize = 7
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    local btn = Instance.new("TextButton", wrap)
    btn.Size = UDim2.new(1, -10, 0, 14)
    btn.Position = UDim2.new(0, 5, 0, 13)
    btn.BackgroundColor3 = C.section
    btn.BorderSizePixel = 0
    btn.AutoButtonColor = false
    corner(btn, 2)
    local cur = Instance.new("TextLabel", btn)
    cur.Size = UDim2.new(1, -16, 1, 0)
    cur.Position = UDim2.new(0, 5, 0, 0)
    cur.BackgroundTransparency = 1
    cur.Text = default
    cur.TextColor3 = C.text
    cur.Font = Enum.Font.Gotham
    cur.TextSize = 7
    cur.TextXAlignment = Enum.TextXAlignment.Left
    local arr = Instance.new("TextLabel", btn)
    arr.Size = UDim2.new(0, 12, 1, 0)
    arr.Position = UDim2.new(1, -14, 0, 0)
    arr.BackgroundTransparency = 1
    arr.Text = "в€§"
    arr.TextColor3 = C.dim
    arr.Font = Enum.Font.GothamBold
    arr.TextSize = 6
    local idx = 1
    for i,v in ipairs(options) do if v == default then idx = i end end
    btn.MouseButton1Click:Connect(function()
        idx = (idx % #options) + 1
        cur.Text = options[idx]
        if callback then callback(options[idx]) end
    end)
    return wrap, function() return options[idx] end
end

