local function getRainbowColor(speed)
    local t = tick() * (speed or 2)
    return Color3.fromRGB(
        math.sin(t + 0) * 127 + 128,
        math.sin(t + 2) * 127 + 128,
        math.sin(t + 4) * 127 + 128
    )
end

local function checkVisibility(targetCharacter)
    local localCharacter = LP.Character
    if not localCharacter or not localCharacter:FindFirstChild("HumanoidRootPart") then return false end
    if not targetCharacter or not targetCharacter:FindFirstChild("HumanoidRootPart") then return false end
    local origin = Camera.CFrame.Position
    local destination = targetCharacter.HumanoidRootPart.Position
    local raycastParams = RaycastParams.new()
    raycastParams.FilterType = Enum.RaycastFilterType.Exclude
    raycastParams.FilterDescendantsInstances = {localCharacter, targetCharacter, Camera}
    local result = workspace:Raycast(origin, destination - origin, raycastParams)
    return result == nil
end

local espObjects = {}

function createESP(player)
    if not hasDrawing then return end
    if player == LP then return end
    if espObjects[player] then return end

    local box = Drawing.new("Square")
    box.Thickness = 1.5; box.Filled = false; box.Transparency = 1; box.Visible = false

    local hpBg = Drawing.new("Square")
    hpBg.Thickness = 1; hpBg.Filled = true
    hpBg.Color = Color3.fromRGB(0,0,0); hpBg.Transparency = 1; hpBg.Visible = false

    local hpBar = Drawing.new("Square")
    hpBar.Thickness = 1; hpBar.Filled = true
    hpBar.Color = Color3.fromRGB(0,255,0); hpBar.Transparency = 1; hpBar.Visible = false

    local nameLabel = Drawing.new("Text")
    nameLabel.Size = 13; nameLabel.Center = true; nameLabel.Outline = true
    nameLabel.Transparency = 1; nameLabel.Visible = false

    local distLabel = Drawing.new("Text")
    distLabel.Size = 12; distLabel.Center = true; distLabel.Outline = true
    distLabel.Transparency = 1; distLabel.Visible = false

    local tracer = Drawing.new("Line")
    tracer.Thickness = 1.5; tracer.Transparency = 1; tracer.Visible = false

    espObjects[player] = {box=box, hpBg=hpBg, hpBar=hpBar, nameLabel=nameLabel, distLabel=distLabel, tracer=tracer}

    local connection
    connection = RunService.RenderStepped:Connect(function()
        if not espEnabled or not player:IsDescendantOf(Players) then
            box.Visible=false; hpBg.Visible=false; hpBar.Visible=false
            nameLabel.Visible=false; distLabel.Visible=false; tracer.Visible=false
            if not player:IsDescendantOf(Players) then
                box:Remove(); hpBg:Remove(); hpBar:Remove()
                nameLabel:Remove(); distLabel:Remove(); tracer:Remove()
                connection:Disconnect()
                espObjects[player] = nil
            end
            return
        end
        local character = player.Character
        if not character or not character:FindFirstChild("HumanoidRootPart") or not character:FindFirstChild("Humanoid") then
            box.Visible=false; hpBg.Visible=false; hpBar.Visible=false
            nameLabel.Visible=false; distLabel.Visible=false; tracer.Visible=false
            return
        end
        local rootPart = character.HumanoidRootPart
        local humanoid = character.Humanoid
        local headPos, headOn = Camera:WorldToViewportPoint((rootPart.CFrame * CFrame.new(0,3,0)).Position)
        local footPos, footOn = Camera:WorldToViewportPoint((rootPart.CFrame * CFrame.new(0,-3.5,0)).Position)
        local centerPos = Camera:WorldToViewportPoint(rootPart.Position)
        if headOn and footOn and humanoid.Health > 0 then
            local boxH = math.abs(headPos.Y - footPos.Y)
            local boxW = boxH * 0.6
            local boxX = headPos.X - boxW/2
            local boxY = headPos.Y
            local rainbow = getRainbowColor(2)
            if espShowBox then
                box.Size = Vector2.new(boxW, boxH)
                box.Position = Vector2.new(boxX, boxY)
                box.Color = rainbow; box.Visible = true
            else box.Visible = false end
            if espShowName then
                nameLabel.Text = player.Name
                nameLabel.Position = Vector2.new(centerPos.X, boxY - 16)
                nameLabel.Color = rainbow; nameLabel.Visible = true
            else nameLabel.Visible = false end
            if espShowDist then
                local d = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
                    and math.floor((rootPart.Position - LP.Character.HumanoidRootPart.Position).Magnitude) or "?"
                distLabel.Text = tostring(d) .. " studs"
                distLabel.Position = Vector2.new(centerPos.X, boxY + boxH + 4)
                distLabel.Color = rainbow; distLabel.Visible = true
            else distLabel.Visible = false end
            if espShowHP then
                local hpH = boxH * (humanoid.Health / humanoid.MaxHealth)
                hpBg.Size = Vector2.new(3, boxH); hpBg.Position = Vector2.new(boxX-6, boxY); hpBg.Visible = true
                hpBar.Size = Vector2.new(3, hpH); hpBar.Position = Vector2.new(boxX-6, boxY+(boxH-hpH)); hpBar.Visible = true
            else hpBg.Visible=false; hpBar.Visible=false end
            if espShowTracer then
                local isVis = checkVisibility(character)
                tracer.Color = isVis and Color3.fromRGB(0,255,0) or Color3.fromRGB(255,0,0)
                tracer.From = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y)
                tracer.To = Vector2.new(headPos.X, headPos.Y)
                tracer.Visible = true
            else tracer.Visible = false end
        else
            box.Visible=false; hpBg.Visible=false; hpBar.Visible=false
            nameLabel.Visible=false; distLabel.Visible=false; tracer.Visible=false
        end
    end)
end

Players.PlayerAdded:Connect(function(player)
    if espEnabled and hasDrawing then createESP(player) end
end)

for _, player in ipairs(Players:GetPlayers()) do
    if espEnabled and hasDrawing and player ~= LP then createESP(player) end
end

