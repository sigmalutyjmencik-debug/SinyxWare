    local hGrad = Instance.new("UIGradient", hdr)
    hGrad.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0,   Color3.fromRGB(50, 22, 65)),
        ColorSequenceKeypoint.new(1,   Color3.fromRGB(34, 16, 46)),
