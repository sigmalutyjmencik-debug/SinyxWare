local function crn(f,r) Instance.new("UICorner",f).CornerRadius=UDim.new(0,r or 4) end

-- РЎРєСЂРѕР»Р»-РєРѕРЅС‚РµР№РЅРµСЂ
local function mkScroll(parent)
    local s=Instance.new("ScrollingFrame",parent)
    s.Size=UDim2.new(1,0,1,0); s.BackgroundTransparency=1
    s.BorderSizePixel=0; s.ScrollBarThickness=3
    s.ScrollBarImageColor3=Color3.fromRGB(200,60,170)
    s.AutomaticCanvasSize=Enum.AutomaticSize.Y
    s.CanvasSize=UDim2.new()
    local l=Instance.new("UIListLayout",s)
    l.Padding=UDim.new(0,8); l.SortOrder=Enum.SortOrder.LayoutOrder
    local p=Instance.new("UIPadding",s)
    p.PaddingTop=UDim.new(0,10); p.PaddingLeft=UDim.new(0,8); p.PaddingRight=UDim.new(0,8)
    return s
end

