local C = {
    bg       = Color3.fromRGB(30, 15, 25),
    sidebar  = Color3.fromRGB(45, 20, 35),
    panel    = Color3.fromRGB(60, 25, 45),
    section  = Color3.fromRGB(75, 30, 55),
