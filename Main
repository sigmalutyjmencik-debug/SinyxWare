    hGrad.Rotation = 0

    local htxt = Instance.new("TextLabel", hdr)
    htxt.Size = UDim2.new(1,-20,1,0); htxt.Position = UDim2.new(0,8,0,0)
    htxt.BackgroundTransparency = 1; htxt.Text = title
    htxt.TextColor3 = C.pink1; htxt.Font = Enum.Font.GothamBold; htxt.TextSize = 8
    htxt.TextXAlignment = Enum.TextXAlignment.Left

    local htGrad = Instance.new("UIGradient", htxt)
    htGrad.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromRGB(255,150,230)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(180,60,150)),
    })

    local chev = Instance.new("TextButton", hdr)
    chev.Size = UDim2.new(0,16,1,0); chev.Position = UDim2.new(1,-18,0,0)
    chev.BackgroundTransparency = 1; chev.Text = "в€Ё"
    chev.TextColor3 = C.dim; chev.Font = Enum.Font.GothamBold; chev.TextSize = 9
    chev.AutoButtonColor = false

    local body = Instance.new("Frame", wrap)
    body.Size = UDim2.new(1,0,0,0); body.AutomaticSize = Enum.AutomaticSize.Y
    body.Position = UDim2.new(0,0,0,22)
