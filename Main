SearchBox:GetPropertyChangedSignal("Text"):Connect(function()
    local query = SearchBox.Text:lower()
    for _, tab in pairs(TabContents) do
        for _, child in ipairs(tab:GetDescendants()) do
            if child:IsA("TextLabel") and child.Text ~= "" and child.Text ~= "Search" and child.Text ~= "🔍" then
                local parent = child.Parent
                while parent and parent ~= tab do
                    if parent:IsA("Frame") then
                        parent.Visible = (query == "" or child.Text:lower():find(query) ~= nil)
                    end
                    parent = parent.Parent
                end
            end
        end
    end
end)

-- ================================================================
--  ESP И АИМБОТ (рисование)
-- ================================================================
local espData = {}
local rainbow = 0

-- Круг (полный)
local circle = Drawing.new("Circle")
circle.Thickness = 2
circle.NumSides = 64
circle.Filled = false
circle.Color = Color3.fromRGB(160, 32, 240)
circle.Radius = cfg.fovSize
circle.Visible = cfg.snowFov
circle.Transparency = 0.4
circle.ZIndex = 999

local function createESP(plr)
    if plr == LP or espData[plr] then return end
    local e = {
        Box = Drawing.new("Square"),
        Name = Drawing.new("Text"),
        Health = Drawing.new("Square"),
        Tracer = Drawing.new("Line"),
        Distance = Drawing.new("Text"),
    }
    e.Box.Filled = false
    e.Box.Thickness = 1.5
    e.Box.Visible = false
    e.Name.Size = 12
    e.Name.Center = true
    e.Name.Outline = true
    e.Name.OutlineColor = Color3.fromRGB(0,0,0)
    e.Name.Font = 3
    e.Name.Visible = false
    e.Health.Filled = true
    e.Health.Thickness = 1
    e.Health.Visible = false
    e.Tracer.Thickness = 1
    e.Tracer.Visible = false
    e.Distance.Size = 10
    e.Distance.Center = true
    e.Distance.Outline = true
    e.Distance.OutlineColor = Color3.fromRGB(0,0,0)
    e.Distance.Font = 3
    e.Distance.Visible = false
    espData[plr] = e
end

local function removeESP(plr)
    local e = espData[plr]
    if e then
        pcall(function()
            e.Box:Remove()
            e.Name:Remove()
            e.Health:Remove()
            e.Tracer:Remove()
            e.Distance:Remove()
        end)
        espData[plr] = nil
    end
end

for _, plr in pairs(Players:GetPlayers()) do createESP(plr) end
Players.PlayerAdded:Connect(createESP)
Players.PlayerRemoving:Connect(removeESP)

-- ================================================================
--  ФУНКЦИИ АИМБОТА
-- ================================================================
local function getClosest()
    local target = nil
    local minDist = cfg.fovSize
    for _, plr in pairs(Players:GetPlayers()) do
        if plr == LP then continue end
        if not plr.Character or not plr.Character:FindFirstChild("Head") then continue end
        local pos, onScreen = Camera:WorldToViewportPoint(plr.Character.Head.Position)
        if not onScreen then continue end
        local dist = (Vector2.new(pos.X, pos.Y) - Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)).Magnitude
        if dist < minDist then
            minDist = dist
            target = plr
        end
    end
    return target, minDist
end

local function aimAt(plr)
    if not plr or not plr.Character or not plr.Character:FindFirstChild("Head") then return end
    local head = plr.Character.Head
    local targetPos = head.Position
    if cfg.predict then
        local root = plr.Character:FindFirstChild("HumanoidRootPart")
        if root and root.AssemblyLinearVelocity then
            targetPos = targetPos + root.AssemblyLinearVelocity * (cfg.predictMs / 1000)
        end
    end
    local smooth = math.clamp(cfg.smooth / 100, 0.01, 1)
    local current = Camera.CFrame
    local targetCF = CFrame.new(current.Position, targetPos)
    Camera.CFrame = current:Lerp(targetCF, smooth)
end

-- ================================================================
--  МОБИЛЬНАЯ КНОПКА АИМБОТА
-- ================================================================
local function isMobile()
    return UIS.TouchEnabled and not UIS.MouseEnabled
end

local mobileAimBtn = nil
if isMobile() then
    local btnGui = Instance.new("ScreenGui")
    btnGui.Name = "SinyxWareButton"
    btnGui.ResetOnSpawn = false
    btnGui.Parent = CG

    mobileAimBtn = Instance.new("ImageButton")
    mobileAimBtn.Size = UDim2.new(0, 60, 0, 60)
    mobileAimBtn.Position = UDim2.new(1, -70, 0.5, -30)
    mobileAimBtn.Image = "rbxassetid://73073995075962"
    mobileAimBtn.BackgroundTransparency = 1
    mobileAimBtn.Parent = btnGui
    mobileAimBtn.ZIndex = 999

    local drag = {active=false, start=nil, offset=nil}
    mobileAimBtn.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.Touch then
            drag.active = true
            drag.start = i.Position
            drag.offset = mobileAimBtn.Position
        end
    end)
    mobileAimBtn.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.Touch then drag.active = false end
    end)
    UIS.InputChanged:Connect(function(i)
        if drag.active and i.UserInputType == Enum.UserInputType.Touch then
            local delta = i.Position - drag.start
            mobileAimBtn.Position = UDim2.new(
                drag.offset.X.Scale, drag.offset.X.Offset + delta.X,
                drag.offset.Y.Scale, drag.offset.Y.Offset + delta.Y
            )
        end
    end)

    mobileAimBtn.MouseButton1Click:Connect(function()
        if cfg.aimbot then
            local target = getClosest()
            if target then aimAt(target) end
        end
    end)
    mobileAimBtn.TouchTap:Connect(function()
        if cfg.aimbot then
            local target = getClosest()
            if target then aimAt(target) end
        end
    end)
end

-- ================================================================
--  ГЛАВНЫЙ ЦИКЛ (рендеринг)
-- ================================================================
RunService.RenderStepped:Connect(function()
    local center = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
    circle.Position = center
    circle.Radius = cfg.fovSize
    circle.Visible = cfg.snowFov

    -- Аимбот
    if cfg.aimbot then
        local target, dist = getClosest()
        local keyPressed = false
        local k = Enum.KeyCode[cfg.aimKey]
        if k then keyPressed = UIS:IsKeyDown(k) end

        if target and (keyPressed) then
            aimAt(target)
            circle.Color = Color3.fromRGB(0,255,0)
        else
            circle.Color = Color3.fromRGB(255,255,0)
        end
    else
        circle.Color = Color3.fromRGB(160,32,240)
    end

    -- ESP
    if cfg.espEnabled then
        rainbow = (rainbow + 0.005) % 1
        local col = Color3.fromHSV(rainbow, 1, 1)
        for plr, e in pairs(espData) do
            local char = plr.Character
            if not char or not char.Parent then
                e.Box.Visible = false
                e.Name.Visible = false
                e.Health.Visible = false
                e.Tracer.Visible = false
                e.Distance.Visible = false
                continue
            end
            local root = char:FindFirstChild("HumanoidRootPart")
            local head = char:FindFirstChild("Head")
            if not root or not head then
                e.Box.Visible = false
                e.Name.Visible = false
                e.Health.Visible = false
                e.Tracer.Visible = false
                e.Distance.Visible = false
                continue
            end
            local top = head.Position + Vector3.new(0, head.Size.Y/2, 0)
            local bottom = root.Position - Vector3.new(0, root.Size.Y/2, 0)
            local right = root.Position + root.CFrame:VectorToWorldSpace(Vector3.new(root.Size.X/2,0,0))
            local left = root.Position + root.CFrame:VectorToWorldSpace(Vector3.new(-root.Size.X/2,0,0))

            local topV, topOn = Camera:WorldToViewportPoint(top)
            local bottomV, bottomOn = Camera:WorldToViewportPoint(bottom)
            local rightV, rightOn = Camera:WorldToViewportPoint(right)
            local leftV, leftOn = Camera:WorldToViewportPoint(left)

            if not (topOn or bottomOn or rightOn or leftOn) then
                e.Box.Visible = false
                e.Name.Visible = false
                e.Health.Visible = false
                e.Tracer.Visible = false
                e.Distance.Visible = false
                continue
            end

            local height = math.abs(topV.Y - bottomV.Y)
            local width = math.abs(rightV.X - leftV.X)
            if height < 5 then height = 5 end
            if width < 5 then width = 5 end
            local centerX = (leftV.X + rightV.X)/2
            local centerY = (topV.Y + bottomV.Y)/2

            -- Box
            if cfg.showBoxes then
                e.Box.Visible = true
                e.Box.Size = Vector2.new(width, height)
                e.Box.Position = Vector2.new(centerX - width/2, centerY - height/2)
                e.Box.Color = col
            else
                e.Box.Visible = false
            end

            -- Name
            if cfg.showNames then
                e.Name.Visible = true
                e.Name.Text = plr.Name
                e.Name.Position = Vector2.new(centerX, topV.Y - 15)
                e.Name.Color = col
            else
                e.Name.Visible = false
            end

            -- Health
            if cfg.showHealth then
                local hum = char:FindFirstChildOfClass("Humanoid")
                if hum and hum.MaxHealth > 0 then
                    local hp = math.clamp(hum.Health/hum.MaxHealth, 0, 1)
                    e.Health.Visible = true
                    e.Health.Size = Vector2.new(2, height * hp)
                    e.Health.Position = Vector2.new(centerX - width/2 - 4, centerY + height/2 - height*hp)
                    e.Health.Color = Color3.fromRGB(255*(1-hp), 255*hp, 0)
                else
                    e.Health.Visible = false
                end
            else
                e.Health.Visible = false
            end

            -- Tracer (линия от центра экрана к игроку)
            if cfg.showTracers then
                e.Tracer.Visible = true
                local headPos, headOn = Camera:WorldToViewportPoint(head.Position)
                local from = center
                local to = Vector2.new(headPos.X, headPos.Y)
                e.Tracer.From = from
                e.Tracer.To = to
                e.Tracer.Color = headOn and Color3.fromRGB(0,255,0) or Color3.fromRGB(255,0,0)
            else
                e.Tracer.Visible = false
            end

            -- Distance
            if cfg.showDistance then
                e.Distance.Visible = true
                local dist = (Camera.CFrame.Position - root.Position).Magnitude
                e.Distance.Text = math.floor(dist) .. "m"
                e.Distance.Position = Vector2.new(centerX, bottomV.Y + 15)
                e.Distance.Color = col
            else
                e.Distance.Visible = false
            end
        end
    else
        for _, e in pairs(espData) do
            e.Box.Visible = false
            e.Name.Visible = false
            e.Health.Visible = false
            e.Tracer.Visible = false
            e.Distance.Visible = false
        end
    end
end)

-- ================================================================
--  MISC (Speed, Infinite Jump)
-- ================================================================
RunService.Heartbeat:Connect(function()
    if LP.Character then
        local hum = LP.Character:FindFirstChildOfClass("Humanoid")
        if hum then
            hum.WalkSpeed = cfg.speedHack and cfg.speedValue or 16
            if cfg.infiniteJump then
                hum.JumpPower = 50
                hum:SetStateEnabled(Enum.HumanoidStateType.Jumping, true)
            else
                hum.JumpPower = 50
            end
        end
    end
end)

UIS.InputBegan:Connect(function(i, gpe)
    if gpe then return end
    if i.KeyCode == Enum.KeyCode.Space and cfg.infiniteJump then
        local hum = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
        if hum then hum:ChangeState(Enum.HumanoidStateType.Jumping) end
    end
end)

-- ================================================================
--  HOTKEYS
-- ================================================================
UIS.InputBegan:Connect(function(i, gpe)
    if gpe then return end
    if i.KeyCode == Enum.KeyCode.Insert or i.KeyCode == Enum.KeyCode.LeftControl then
        Root.Enabled = not Root.Enabled
        circle.Visible = Root.Enabled and cfg.snowFov
    end
end)

-- ================================================================
--  ЗАГРУЗКА КОНФИГА
-- ================================================================
loadCfg()
Root.Enabled = true

print("SinyxWare v6.0 loaded. Press Insert or Ctrl to toggle GUI.")
