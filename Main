RS.RenderStepped:Connect(function()
    local vp = Camera.ViewportSize
    local r = AIM.FOV
    FOVFrame.Size = UDim2.new(0, r*2, 0, r*2)
    FOVFrame.Position = UDim2.new(0, vp.X/2-r, 0, vp.Y/2-r)
    FOVFrame.Visible = AIM.Enabled
    if AIM.Enabled then
        local t = getTarget()
        if t then
            local cf = Camera.CFrame
            local dir = (t.Position - cf.Position).Unit
            Camera.CFrame = CFrame.new(cf.Position, cf.Position + dir)
        end
    end
end)

