local TabBtns    = {}
local TabContent = {}
local curTab     = "Home"

local NavF = Instance.new("Frame", Sidebar)
NavF.Size = UDim2.new(1, 0, 1, -44)
NavF.Position = UDim2.new(0, 0, 0, 44)
NavF.BackgroundTransparency = 1

local NavL = Instance.new("UIListLayout", NavF)
NavL.Padding = UDim.new(0, 2); NavL.SortOrder = Enum.SortOrder.LayoutOrder

local function setTab(name)
    curTab = name
    for n, t in pairs(TabBtns) do
        local on = n == name
        t.bar.BackgroundTransparency = on and 0 or 1
        t.ico.TextColor3 = on and C.pink1 or C.dim
        t.lbl.TextColor3 = on and C.white or C.dim
        if on then
            TS:Create(t.bg, TweenInfo.new(0.15), {
                BackgroundTransparency = 0.85
            }):Play()
        else
            TS:Create(t.bg, TweenInfo.new(0.15), {
                BackgroundTransparency = 1
            }):Play()
        end
    end
    for n, f in pairs(TabContent) do f.Visible = n == name end
end

for i, tab in ipairs(TABS) do
    local btn = Instance.new("TextButton", NavF)
    btn.Size = UDim2.new(1, 0, 0, 30)
    btn.BackgroundTransparency = 1
    btn.Text = ""; btn.AutoButtonColor = false
    btn.LayoutOrder = i

    -- РђРєС‚РёРІРЅС‹Р№ С„РѕРЅ
    local bg = Instance.new("Frame", btn)
    bg.Size = UDim2.new(1, 0, 1, 0)
    bg.BackgroundColor3 = C.pink3
    bg.BackgroundTransparency = 1
    bg.BorderSizePixel = 0
    Instance.new("UICorner", bg).CornerRadius = UDim.new(0, 4)

    -- Р›РµРІС‹Р№ Р°РєС†РµРЅС‚ Р±Р°СЂ
    local bar = Instance.new("Frame", btn)
    bar.Size = UDim2.new(0, 2, 0.6, 0)
    bar.Position = UDim2.new(0, 0, 0.2, 0)
    bar.BackgroundColor3 = C.pink1
    bar.BorderSizePixel = 0
