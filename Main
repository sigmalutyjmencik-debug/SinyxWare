-- ================================================================
--  ESP И АИМБОТ
-- ================================================================
local espData = {}
local rainbow = 0

-- FOV круг
local circle = Drawing.new("Circle")
circle.Thickness = 2
circle.NumSides = 64
circle.Filled = false
circle.Color = Pink.medium
circle.Radius = cfg.fovSize
circle.Visible = cfg.showCircle
circle.Transparency = 0.4
circle.ZIndex = 999

local function createESP(plr)
    if plr == LP or espData[plr] then return end
    local e = {
        Box = Drawing.new("Square"),
        Name = Drawing.new("Text"),
    }
    e.Box.Filled = false
    e.Box.Thickness = 1.5
    e.Box.Visible = false
    e.Name.Size = 12
    e.Name.Center = true
    e.Name.Outline = true
    e.Name.OutlineColor = Color3.fromRGB(0,0,0)
    e.Name.Font = 3
    e.Name.Visible = false
    espData[plr] = e
end

local function removeESP(plr)
    local e = espData[plr]
    if e then
        pcall(function()
            e.Box:Remove()
            e.Name:Remove()
        end)
        espData[plr] = nil
    end
end

for _, plr in pairs(Players:GetPlayers()) do createESP(plr) end
Players.PlayerAdded:Connect(createESP)
Players.PlayerRemoving:Connect(removeESP)

-- Аимбот функция
local function getClosest()
    local target = nil
    local minDist = cfg.fovSize
    for _, plr in pairs(Players:GetPlayers()) do
        if plr == LP then continue end
        if not plr.Character or not plr.Character:FindFirstChild("Head") then continue end
        local pos, onScreen = Camera:WorldToViewportPoint(plr.Character.Head.Position)
        if not onScreen then continue end
        local dist = (Vector2.new(pos.X, pos.Y) - Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)).Magnitude
        if dist < minDist then
            minDist = dist
            target = plr
        end
    end
    return target, minDist
end

local function aimAt(plr)
    if not plr or not plr.Character or not plr.Character:FindFirstChild("Head") then return end
    local head = plr.Character.Head
    Camera.CFrame = CFrame.new(Camera.CFrame.Position, head.Position)
end

-- Главный цикл
RunService.RenderStepped:Connect(function()
    local center = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
    circle.Position = center
    circle.Radius = cfg.fovSize
    circle.Visible = cfg.showCircle
    
    -- Аимбот
    if cfg.aimbot then
        local target, dist = getClosest()
        if target then
            local keyPressed = false
            local k = Enum.KeyCode[cfg.aimKey]
            if k then keyPressed = UIS:IsKeyDown(k) end
            if keyPressed then
                aimAt(target)
                circle.Color = Color3.fromRGB(0,255,0)
            else
                circle.Color = Pink.medium
            end
        else
            circle.Color = Pink.medium
        end
    else
        circle.Color = Pink.medium
    end
    
    -- ESP (простой)
    rainbow = (rainbow + 0.005) % 1
    local col = Color3.fromHSV(rainbow, 1, 1)
    for plr, e in pairs(espData) do
        local char = plr.Character
        if not char or not char.Parent then
            e.Box.Visible = false
            e.Name.Visible = false
            continue
        end
        local root = char:FindFirstChild("HumanoidRootPart")
        local head = char:FindFirstChild("Head")
        if not root or not head then
            e.Box.Visible = false
            e.Name.Visible = false
            continue
        end
        local top = head.Position + Vector3.new(0, head.Size.Y/2, 0)
        local bottom = root.Position - Vector3.new(0, root.Size.Y/2, 0)
        local right = root.Position + root.CFrame:VectorToWorldSpace(Vector3.new(root.Size.X/2,0,0))
        local left = root.Position + root.CFrame:VectorToWorldSpace(Vector3.new(-root.Size.X/2,0,0))
        
        local topV, topOn = Camera:WorldToViewportPoint(top)
        local bottomV, bottomOn = Camera:WorldToViewportPoint(bottom)
        local rightV, rightOn = Camera:WorldToViewportPoint(right)
        local leftV, leftOn = Camera:WorldToViewportPoint(left)
        
        if not (topOn or bottomOn or rightOn or leftOn) then
            e.Box.Visible = false
            e.Name.Visible = false
            continue
        end
        
        local height = math.abs(topV.Y - bottomV.Y)
        local width = math.abs(rightV.X - leftV.X)
        if height < 5 then height = 5 end
        if width < 5 then width = 5 end
        local centerX = (leftV.X + rightV.X)/2
        local centerY = (topV.Y + bottomV.Y)/2
        
        e.Box.Visible = true
        e.Box.Size = Vector2.new(width, height)
        e.Box.Position = Vector2.new(centerX - width/2, centerY - height/2)
        e.Box.Color = col
        
        e.Name.Visible = true
        e.Name.Text = plr.Name
        e.Name.Position = Vector2.new(centerX, topV.Y - 15)
        e.Name.Color = col
    end
end)

