mkSlider(mainSection, "FOV Radius", 10, 500, 50, function(val) circleRadius = val end)
mkDropdown(mainSection, "Aim Mode", {"Instant", "Smooth"}, "Smooth", function(val) aimMode = val end)
mkSlider(mainSection, "Smoothness", 1, 100, 50, function(val) smoothness = val end)

local extraSection = mkSection(CR, "Targeting", 1)
