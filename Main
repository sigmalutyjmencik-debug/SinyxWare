local function isMobile()
    return UIS.TouchEnabled and not UIS.MouseEnabled
end
local deviceType = isMobile() and "Mobile" or "PC"

-- ================================================================
--  ДЕТЕКТОР ЭКЗЕКУТОРА
-- ================================================================
local function DetectExecutor()
    if identifyexecutor then
        local name, version = identifyexecutor()
        return tostring(name) .. (version and (" " .. tostring(version)) or "")
    end
    local genv = getgenv and getgenv() or _G
    if genv.wave or genv.Wave then return "Wave" end
    if genv.solara or genv.Solara then return "Solara" end
    if genv.celery or genv.Celery then return "Celery" end
    if genv.electron or genv.Electron then return "Electron" end
    if genv.syn or genv.synapse then return "Synapse X" end
    if genv.KRNL_LOADED then return "Krnl" end
    if genv.fluxus then return "Fluxus" end
    if genv.S_EXECUTOR then return "Swift" end
    if checkclosure or isourclosure then return "Advanced Executor" end
    if getrawmetatable then return "Medium Tier Executor" end
    return "Unknown / External Emulator"
end
local currentExecutor = DetectExecutor()

