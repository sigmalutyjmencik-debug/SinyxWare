-- ================================================================
--  HIDE / SHOW (Insert)
-- ================================================================
local visible = true
UIS.InputBegan:Connect(function(i, gpe)
    if gpe then return end
    if i.KeyCode == Enum.KeyCode.Insert then
        visible = not visible
        Outer.Visible = visible
        -- скрываем также мобильную кнопку? Покажем всегда, но можно синхронизировать
        if mobileButton then mobileButton.Visible = visible end
    end
end)

-- ================================================================
--  МОБИЛЬНАЯ КНОПКА (если устройство мобильное)
-- ================================================================
local mobileButton = nil
if isMobile() then
    local btnGui = Instance.new("ScreenGui")
    btnGui.Name = "SinyxWareButton"
    btnGui.ResetOnSpawn = false
    btnGui.Parent = CG

    mobileButton = Instance.new("ImageButton")
    mobileButton.Size = UDim2.new(0, 50, 0, 50)
    mobileButton.Position = UDim2.new(1, -60, 0.5, -25)
    mobileButton.Image = "rbxassetid://73073995075962" -- можно заменить на свой ID
    mobileButton.BackgroundTransparency = 1
    mobileButton.Parent = btnGui
    mobileButton.ZIndex = 999

    -- Перетаскивание
    local dragMob = {active = false, start = nil, offset = nil}
    mobileButton.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch then
            dragMob.active = true
            dragMob.start = input.Position
            dragMob.offset = mobileButton.Position
        end
    end)
    mobileButton.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch then
            dragMob.active = false
        end
    end)
    UIS.InputChanged:Connect(function(input)
        if dragMob.active and input.UserInputType == Enum.UserInputType.Touch then
            local delta = input.Position - dragMob.start
            mobileButton.Position = UDim2.new(
                dragMob.offset.X.Scale,
                dragMob.offset.X.Offset + delta.X,
                dragMob.offset.Y.Scale,
                dragMob.offset.Y.Offset + delta.Y
            )
        end
    end)

    -- Открытие/закрытие GUI по нажатию
    local function toggleGUI()
        visible = not visible
        Outer.Visible = visible
    end
    mobileButton.MouseButton1Click:Connect(toggleGUI)
    mobileButton.TouchTap:Connect(toggleGUI)
end

print("[RusHack] ✓ Insert = скрыть/показать, мобильная кнопка активна")
