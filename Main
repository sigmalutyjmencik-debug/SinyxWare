-- ================================================================
--  HIDE / SHOW вЂ” РєР»Р°РІРёС€Р° Insert
-- ================================================================
local visible = true
UIS.InputBegan:Connect(function(i, gpe)
    if gpe then return end
    if i.KeyCode == Enum.KeyCode.Insert then
        visible = not visible
        Outer.Visible = visible
    end
end)

