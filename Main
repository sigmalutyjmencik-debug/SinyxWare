local function isMobile()
    return UIS.TouchEnabled and not UIS.MouseEnabled
end

local function isTablet()
    return UIS.TouchEnabled and UIS.MouseEnabled
end

-- ================================================================
--  ОПРЕДЕЛЕНИЕ ЭКЗЕКУТОРА
-- ================================================================
local function DetectExecutor()
    local genv = getgenv and getgenv() or _G
    if identifyexecutor then
        local name, version = identifyexecutor()
        return tostring(name) .. (version and (" " .. tostring(version)) or "")
    end
    if genv.wave or genv.Wave then return "Wave"
    elseif genv.solara or genv.Solara then return "Solara"
    elseif genv.celery or genv.Celery then return "Celery"
    elseif genv.electron or genv.Electron then return "Electron"
    elseif genv.syn or genv.synapse then return "Synapse X"
    elseif genv.KRNL_LOADED then return "Krnl"
    elseif genv.fluxus then return "Fluxus"
    elseif genv.S_EXECUTOR then return "Swift"
    end
    if checkclosure or isourclosure then return "Advanced Executor"
    elseif getrawmetatable then return "Medium Tier Executor" end
    return "Unknown / External"
end

local executor = DetectExecutor()

