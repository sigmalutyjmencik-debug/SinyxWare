local function corner(f, r)
    Instance.new("UICorner", f).CornerRadius = UDim.new(0, r or 2)
end

local function mkToggle(parent, label, default, callback)
    local row = Instance.new("Frame", parent)
    row.Size = UDim2.new(1, 0, 0, 16)
    row.BackgroundTransparency = 1

    local lbl = Instance.new("TextLabel", row)
    lbl.Size = UDim2.new(1, -30, 1, 0)
    lbl.Position = UDim2.new(0, 5, 0, 0)
    lbl.BackgroundTransparency = 1
    lbl.Text = label
    lbl.TextColor3 = C.text
    lbl.Font = Enum.Font.Gotham
    lbl.TextSize = 7
    lbl.TextXAlignment = Enum.TextXAlignment.Left

    local pill = Instance.new("TextButton", row)
    pill.Size = UDim2.new(0, 22, 0, 12)
    pill.Position = UDim2.new(1, -26, 0.5, -6)
    pill.BackgroundColor3 = default and C.red or C.togOff
    pill.BorderSizePixel = 0
    pill.Text = ""
    pill.AutoButtonColor = false
    corner(pill, 6)

    local knob = Instance.new("Frame", pill)
    knob.Size = UDim2.new(0, 8, 0, 8)
    knob.Position = default and UDim2.new(1, -10, 0.5, -4) or UDim2.new(0, 2, 0.5, -4)
    knob.BackgroundColor3 = C.white
    knob.BorderSizePixel = 0
    corner(knob, 4)

    local val = default
    local function toggle()
        val = not val
        TS:Create(pill, TweenInfo.new(0.12), { BackgroundColor3 = val and C.red or C.togOff }):Play()
        TS:Create(knob, TweenInfo.new(0.12), {
            Position = val and UDim2.new(1, -10, 0.5, -4) or UDim2.new(0, 2, 0.5, -4)
        }):Play()
        if callback then callback(val) end
        return val
    end

    pill.MouseButton1Click:Connect(toggle)
    return row, function() return val end, toggle
end

local function mkSlider(parent, label, mn, mx, def, callback)
    local wrap = Instance.new("Frame", parent)
    wrap.Size = UDim2.new(1, 0, 0, 26)
    wrap.BackgroundTransparency = 1

    local lbl = Instance.new("TextLabel", wrap)
    lbl.Size = UDim2.new(1, -5, 0, 11)
    lbl.Position = UDim2.new(0, 5, 0, 1)
    lbl.BackgroundTransparency = 1
    lbl.Text = label
    lbl.TextColor3 = C.text
    lbl.Font = Enum.Font.Gotham
    lbl.TextSize = 7
    lbl.TextXAlignment = Enum.TextXAlignment.Left

    local track = Instance.new("TextButton", wrap)
    track.Size = UDim2.new(1, -10, 0, 12)
    track.Position = UDim2.new(0, 5, 0, 13)
    track.BackgroundColor3 = C.redDark
    track.BorderSizePixel = 0
    track.Text = ""
    track.AutoButtonColor = false
    corner(track, 2)

    local fill = Instance.new("Frame", track)
    fill.Size = UDim2.new((def - mn) / (mx - mn), 0, 1, 0)
    fill.BackgroundColor3 = C.red
    fill.BorderSizePixel = 0
    corner(fill, 2)

    local valLbl = Instance.new("TextLabel", track)
    valLbl.Size = UDim2.new(1, 0, 1, 0)
    valLbl.BackgroundTransparency = 1
    valLbl.Text = tostring(def)
    valLbl.TextColor3 = C.white
    valLbl.Font = Enum.Font.GothamBold
    valLbl.TextSize = 7
    valLbl.ZIndex = 3

    local val = def
    local sliding = false

    local function upd(ax)
        local rx = math.clamp(ax - track.AbsolutePosition.X, 0, track.AbsoluteSize.X)
        local pct = rx / track.AbsoluteSize.X
        val = math.floor(mn + (mx - mn) * pct + 0.5)
        fill.Size = UDim2.new(pct, 0, 1, 0)
        valLbl.Text = tostring(val)
        if callback then callback(val) end
    end

    track.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            sliding = true
            upd(i.Position.X)
        end
    end)
    UIS.InputChanged:Connect(function(i)
        if sliding and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
            upd(i.Position.X)
        end
    end)
    UIS.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            sliding = false
        end
    end)

    return wrap, function() return val end
end

local function mkDropdown(parent, label, options, default, callback)
    local wrap = Instance.new("Frame", parent)
    wrap.Size = UDim2.new(1, 0, 0, 28)
    wrap.BackgroundTransparency = 1

    local lbl = Instance.new("TextLabel", wrap)
    lbl.Size = UDim2.new(1, -5, 0, 11)
    lbl.Position = UDim2.new(0, 5, 0, 1)
    lbl.BackgroundTransparency = 1
    lbl.Text = label
    lbl.TextColor3 = C.text
    lbl.Font = Enum.Font.Gotham
    lbl.TextSize = 7
    lbl.TextXAlignment = Enum.TextXAlignment.Left

    local btn = Instance.new("TextButton", wrap)
    btn.Size = UDim2.new(1, -10, 0, 14)
    btn.Position = UDim2.new(0, 5, 0, 13)
    btn.BackgroundColor3 = C.section
    btn.BorderSizePixel = 0
    btn.AutoButtonColor = false
    corner(btn, 2)

    local cur = Instance.new("TextLabel", btn)
    cur.Size = UDim2.new(1, -16, 1, 0)
    cur.Position = UDim2.new(0, 5, 0, 0)
    cur.BackgroundTransparency = 1
    cur.Text = default
    cur.TextColor3 = C.text
    cur.Font = Enum.Font.Gotham
    cur.TextSize = 7
    cur.TextXAlignment = Enum.TextXAlignment.Left

    local arr = Instance.new("TextLabel", btn)
    arr.Size = UDim2.new(0, 12, 1, 0)
    arr.Position = UDim2.new(1, -14, 0, 0)
    arr.BackgroundTransparency = 1
    arr.Text = "∧"
    arr.TextColor3 = C.dim
    arr.Font = Enum.Font.GothamBold
    arr.TextSize = 6

    local idx = 1
    for i, v in ipairs(options) do
        if v == default then idx = i end
    end

    btn.MouseButton1Click:Connect(function()
        idx = (idx % #options) + 1
        cur.Text = options[idx]
        if callback then callback(options[idx]) end
    end)

    return wrap, function() return options[idx] end
end

local function mkSection(parent, title, lo)
    local wrap = Instance.new("Frame", parent)
    wrap.Size = UDim2.new(1, -6, 0, 0)
    wrap.AutomaticSize = Enum.AutomaticSize.Y
    wrap.Position = UDim2.new(0, 3, 0, 0)
    wrap.BackgroundTransparency = 1
    wrap.LayoutOrder = lo or 1

    local hdr = Instance.new("Frame", wrap)
    hdr.Size = UDim2.new(1, 0, 0, 17)
    hdr.BackgroundColor3 = C.section
    hdr.BorderSizePixel = 0
    corner(hdr, 2)

    local htxt = Instance.new("TextLabel", hdr)
    htxt.Size = UDim2.new(1, -22, 1, 0)
    htxt.Position = UDim2.new(0, 6, 0, 0)
    htxt.BackgroundTransparency = 1
    htxt.Text = title
    htxt.TextColor3 = C.text
    htxt.Font = Enum.Font.GothamBold
    htxt.TextSize = 7
    htxt.TextXAlignment = Enum.TextXAlignment.Left

    local chevron = Instance.new("TextButton", hdr)
    chevron.Size = UDim2.new(0, 16, 1, 0)
    chevron.Position = UDim2.new(1, -18, 0, 0)
    chevron.BackgroundTransparency = 1
    chevron.Text = "∨"
    chevron.TextColor3 = C.dim
    chevron.Font = Enum.Font.GothamBold
    chevron.TextSize = 8
    chevron.AutoButtonColor = false

    local body = Instance.new("Frame", wrap)
    body.Size = UDim2.new(1, 0, 0, 0)
    body.AutomaticSize = Enum.AutomaticSize.Y
    body.Position = UDim2.new(0, 0, 0, 19)
    body.BackgroundColor3 = C.panel
    body.BorderSizePixel = 0
    corner(body, 2)

    local bl = Instance.new("UIListLayout", body)
    bl.Padding = UDim.new(0, 1)
    bl.SortOrder = Enum.SortOrder.LayoutOrder

    local bp = Instance.new("UIPadding", body)
    bp.PaddingTop = UDim.new(0, 3)
    bp.PaddingBottom = UDim.new(0, 3)

    local collapsed = false
    chevron.MouseButton1Click:Connect(function()
        collapsed = not collapsed
        body.Visible = not collapsed
        chevron.Text = collapsed and ">" or "∨"
    end)

    return body
end

local function mkTabContent(name)
    local f = Instance.new("ScrollingFrame", ContentArea)
    f.Size = UDim2.new(1, 0, 1, -23)
    f.Position = UDim2.new(0, 0, 0, 22)
    f.BackgroundTransparency = 1
    f.BorderSizePixel = 0
    f.ScrollBarThickness = 2
    f.ScrollBarImageColor3 = C.red
    f.AutomaticCanvasSize = Enum.AutomaticSize.Y
    f.CanvasSize = UDim2.new()
    f.Visible = name == "Home"

    local colL = Instance.new("Frame", f)
    colL.Size = UDim2.new(0.5, -2, 1, 0)
    colL.BackgroundTransparency = 1
    local llout = Instance.new("UIListLayout", colL)
    llout.Padding = UDim.new(0, 4)
    llout.SortOrder = Enum.SortOrder.LayoutOrder
    local lpad = Instance.new("UIPadding", colL)
    lpad.PaddingTop = UDim.new(0, 4)
    lpad.PaddingLeft = UDim.new(0, 2)

    local colR = Instance.new("Frame", f)
    colR.Size = UDim2.new(0.5, -2, 1, 0)
    colR.Position = UDim2.new(0.5, 2, 0, 0)
    colR.BackgroundTransparency = 1
    local rlout = Instance.new("UIListLayout", colR)
    rlout.Padding = UDim.new(0, 4)
    rlout.SortOrder = Enum.SortOrder.LayoutOrder
    local rpad = Instance.new("UIPadding", colR)
    rpad.PaddingTop = UDim.new(0, 4)
    rpad.PaddingRight = UDim.new(0, 2)

    TabContents[name] = f
    return colL, colR
end

