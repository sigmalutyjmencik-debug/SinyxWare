    redDark  = Color3.fromRGB(150, 20, 60),
    redBord  = Color3.fromRGB(200, 40, 80),
    text     = Color3.fromRGB(235, 220, 230),
    dim      = Color3.fromRGB(180, 150, 170),
    white    = Color3.fromRGB(255, 255, 255),
    border   = Color3.fromRGB(80, 35, 65),
    togOff   = Color3.fromRGB(70, 40, 60),
    green    = Color3.fromRGB(0, 255, 0),
    yellow   = Color3.fromRGB(255, 255, 0),
}

-- ================================================================
--  ХЕЛПЕРЫ
