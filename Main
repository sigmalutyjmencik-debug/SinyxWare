local function mkRow(parent,k,v,lo)
    local rH=MOBILE and 22 or 18
    local row=Instance.new("Frame",parent)
    row.Size=UDim2.new(1,0,0,rH); row.BackgroundTransparency=1; row.LayoutOrder=lo

    local kl=Instance.new("TextLabel",row)
    kl.Size=UDim2.new(0.4,0,1,0); kl.BackgroundTransparency=1; kl.Text=k
    kl.TextColor3=Color3.fromRGB(255,130,215)
    kl.Font=Enum.Font.GothamBold
    kl.TextSize=MOBILE and 11 or 9
    kl.TextXAlignment=Enum.TextXAlignment.Left
    local kg=Instance.new("UIGradient",kl)
    kg.Color=ColorSequence.new({
        ColorSequenceKeypoint.new(0,Color3.fromRGB(255,160,235)),
        ColorSequenceKeypoint.new(1,Color3.fromRGB(190,60,160)),
    })

    local vl=Instance.new("TextLabel",row)
    vl.Size=UDim2.new(0.6,0,1,0); vl.Position=UDim2.new(0.4,0,0,0)
    vl.BackgroundTransparency=1; vl.Text=v
    vl.TextColor3=Color3.fromRGB(210,195,208)
    vl.Font=Enum.Font.Gotham
    vl.TextSize=MOBILE and 11 or 9
    vl.TextXAlignment=Enum.TextXAlignment.Left
    return vl
end

