    if drag and not resizing and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
        local d = i.Position - dstart
        Outer.Position = UDim2.new(ostart.X.Scale, ostart.X.Offset + d.X, ostart.Y.Scale, ostart.Y.Offset + d.Y)
    end
end)

