-- ================================================================
local C = {
    bg       = Color3.fromRGB(18, 12, 12),
    sidebar  = Color3.fromRGB(24, 15, 15),
    panel    = Color3.fromRGB(30, 19, 19),
    section  = Color3.fromRGB(36, 22, 22),
    red      = Color3.fromRGB(210, 30, 30),
    redDark  = Color3.fromRGB(130, 12, 12),
    redBord  = Color3.fromRGB(180, 25, 25),
    text     = Color3.fromRGB(218, 212, 212),
    dim      = Color3.fromRGB(120, 110, 110),
    white    = Color3.fromRGB(255, 255, 255),
    border   = Color3.fromRGB(50, 28, 28),
    togOff   = Color3.fromRGB(60, 38, 38),
    blue     = Color3.fromRGB(0, 191, 255),
}

-- размеры ×1.2
local W, H = 390 * 1.2, 270 * 1.2
local SW = 90 * 1.2

pcall(function() CG:FindFirstChild("SinyxWare"):Destroy() end)
pcall(function() CG:FindFirstChild("SinyxWareButton"):Destroy() end)

-- ================================================================
--  КОНФИГ (сохраняется)
-- ================================================================
local cfg = {
    aimbot = false,
    aimKey = "Q",
    snowFov = true,
    fovSize = 80,
    smooth = 50,
    predict = false,
    predictMs = 14,
    espEnabled = true,
    showBoxes = true,
    showNames = true,
    showHealth = true,
    showTracers = false,
    showDistance = true,
    speedHack = false,
    speedValue = 50,
    infiniteJump = false,
}

local function saveCfg()
    local json = HttpService:JSONEncode(cfg)
    writefile("SinyxWare.json", json)
end

local function loadCfg()
    if isfile("SinyxWare.json") then
        local data = HttpService:JSONDecode(readfile("SinyxWare.json"))
        for k, v in pairs(data) do cfg[k] = v end
        updateUI()
    end
end

local function updateUI()
    -- обновит все кнопки и слайдеры по cfg
    for _, btn in ipairs(allToggles) do
        local key = btn:GetAttribute("key")
        if key and cfg[key] ~= nil then
            btn.BackgroundColor3 = cfg[key] and C.red or C.togOff
            btn.Text = cfg[key] and "ON" or "OFF"
        end
    end
    for _, slider in ipairs(allSliders) do
        local key = slider:GetAttribute("key")
        if key and cfg[key] ~= nil then
            local fill = slider:FindFirstChild("Fill")
            local valLbl = slider:FindFirstChild("ValueLabel")
            if fill and valLbl then
                local min = slider:GetAttribute("min") or 0
                local max = slider:GetAttribute("max") or 100
                local val = cfg[key]
                fill.Size = UDim2.new((val-min)/(max-min), 0, 1, 0)
                valLbl.Text = tostring(val)
            end
        end
    end
end

