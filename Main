mkSlider(MBody, "Speed", 16, 200, 50)

local KL, KR = mkTabContent("Config")
local KBody = mkSection(KL, "Configs", 1)
mkToggle(KBody, "Auto Load", false)
mkToggle(KBody, "Save on Exit", false)

local aimCircleSize = 80
local aimPart = "Head"
local smoothness = 1
local predictMs = 14
local usePredict = false
local useSnowFov = true

local aimData = {}
local rainbowOffset = 0

local function GetRainbowColor()
    rainbowOffset = (rainbowOffset + 0.005) % 1
    return Color3.fromHSV(rainbowOffset, 1, 1)
end

local function CreateESP(player)
    if player == LP or aimData[player] then return end
    local e = {
        Box = Drawing.new("Square"),
        Name = Drawing.new("Text"),
        Health = Drawing.new("Square"),
        Dist = Drawing.new("Text"),
    }
    e.Box.Filled = false
    e.Box.Thickness = 1.5
    e.Box.Visible = false
    e.Name.Size = 12
    e.Name.Center = true
    e.Name.Outline = true
    e.Name.OutlineColor = Color3.fromRGB(0, 0, 0)
    e.Name.Font = 3
    e.Name.Visible = false
    e.Health.Filled = true
    e.Health.Thickness = 1
    e.Health.Visible = false
    e.Dist.Size = 10
    e.Dist.Center = true
    e.Dist.Outline = true
    e.Dist.OutlineColor = Color3.fromRGB(0, 0, 0)
    e.Dist.Font = 3
    e.Dist.Visible = false
    aimData[player] = e
end

local function RemoveESP(player)
    local e = aimData[player]
    if e then
        pcall(function()
            e.Box:Remove()
            e.Name:Remove()
            e.Health:Remove()
            e.Dist:Remove()
        end)
        aimData[player] = nil
    end
end

for _, plr in pairs(Players:GetPlayers()) do CreateESP(plr) end
Players.PlayerAdded:Connect(CreateESP)
Players.PlayerRemoving:Connect(RemoveESP)

local espEnabled = true
local showBox = true
local showName = true
local showHealth = true
local showTracers = false

local function getToggleState(parent, label)
    for _, child in ipairs(parent:GetChildren()) do
        if child:IsA("Frame") then
            local lbl = child:FindFirstChildOfClass("TextLabel")
            if lbl and lbl.Text == label then
                local pill = child:FindFirstChildOfClass("TextButton")
                if pill then
                    return pill.BackgroundColor3 == C.red
                end
            end
        end
    end
    return false
end

local ScreenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
local Circle = Drawing.new("Circle")
Circle.Thickness = 2
Circle.NumSides = 32
Circle.Visible = true
Circle.Color = Color3.fromRGB(160, 32, 240)
Circle.Radius = aimCircleSize
Circle.Filled = false
Circle.Position = ScreenCenter

local Circle2 = Drawing.new("Circle")
Circle2.Thickness = 2
Circle2.NumSides = 32
Circle2.Visible = true
Circle2.Color = Color3.fromRGB(255, 255, 255)
Circle2.Radius = aimCircleSize + 10
Circle2.Filled = false
Circle2.Position = ScreenCenter
Circle2.Transparency = 0.3

local function GetClosestPlayer()
    local closest = nil
    local closestDist = aimCircleSize

    for _, plr in pairs(Players:GetPlayers()) do
        if plr == LP then continue end
        if not plr.Character or not plr.Character:FindFirstChild("Head") then continue end

        local part = plr.Character.Head
        local pos, onScreen = Camera:WorldToViewportPoint(part.Position)

        if not onScreen then continue end

        local dist = (Vector2.new(pos.X, pos.Y) - ScreenCenter).Magnitude

        if dist < closestDist then            closestDist = dist
            closest = plr
        end
    end

    return closest, closestDist
end

local function AimAt(target)
    if not target or not target.Character or not target.Character:FindFirstChild("Head") then return end

    local part = target.Character.Head
    local targetPos = part.Position

    if usePredict then
        local vel = target.Character:FindFirstChild("HumanoidRootPart")
        if vel and vel.AssemblyLinearVelocity then
            targetPos = targetPos + (vel.AssemblyLinearVelocity * (predictMs / 1000))
        end
    end

    Camera.CFrame = CFrame.new(Camera.CFrame.Position, targetPos)
end

UIS.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement then
    end
end)

local currentAimTarget = nil

RunService.RenderStepped:Connect(function()
    ScreenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    Circle.Position = ScreenCenter
    Circle2.Position = ScreenCenter

    local aimOn = aimEnabled()
    local snowOn = snowFov()
    local predOn = predictEnabled()

    usePredict = predOn
    useSnowFov = snowOn

    local target, dist = GetClosestPlayer()

    if aimOn and target and (not useSnowFov or dist <= aimCircleSize) then
        currentAimTarget = target
        local keyPressed = false
        if aimKey ~= "" then
            local keyEnum = Enum.KeyCode[aimKey]
            if keyEnum then
                keyPressed = UIS:IsKeyDown(keyEnum)
            end
        end
        if keyPressed or not useSnowFov then
            AimAt(target)
            Circle.Color = Color3.fromRGB(0, 255, 0)
            Circle2.Color = Color3.fromRGB(0, 255, 0)
        else
            Circle.Color = Color3.fromRGB(255, 255, 0)
            Circle2.Color = Color3.fromRGB(255, 255, 0)
        end
    else
        currentAimTarget = nil
        Circle.Color = Color3.fromRGB(160, 32, 240)
        Circle2.Color = Color3.fromRGB(255, 255, 255)
    end

    if not aimOn then
        Circle.Color = Color3.fromRGB(160, 32, 240)
        Circle2.Color = Color3.fromRGB(255, 255, 255)
    end

    if not espEnabled then
        for _, e in pairs(aimData) do
            e.Box.Visible = false
            e.Name.Visible = false
            e.Health.Visible = false
            e.Dist.Visible = false
        end
        return
    end

    local rainbow = GetRainbowColor()
    for plr, e in pairs(aimData) do
        local char = plr.Character
        if not char or not char.Parent then
            e.Box.Visible = false
            e.Name.Visible = false
            e.Health.Visible = false
            e.Dist.Visible = false
            continue
        end

        local root = char:FindFirstChild("HumanoidRootPart")
        local head = char:FindFirstChild("Head")
        if not root or not head then
            e.Box.Visible = false
            e.Name.Visible = false
            e.Health.Visible = false
            e.Dist.Visible = false
            continue
        end

        local topPos = head.Position + Vector3.new(0, head.Size.Y / 2, 0)
        local bottomPos = root.Position - Vector3.new(0, root.Size.Y / 2, 0)
        local rightOffset = root.CFrame:VectorToWorldSpace(Vector3.new(root.Size.X / 2, 0, 0))
        local leftOffset = root.CFrame:VectorToWorldSpace(Vector3.new(-root.Size.X / 2, 0, 0))
        local rightPos = root.Position + rightOffset
        local leftPos = root.Position + leftOffset

        local topV, topOn = Camera:WorldToViewportPoint(topPos)
        local bottomV, bottomOn = Camera:WorldToViewportPoint(bottomPos)
        local rightV, rightOn = Camera:WorldToViewportPoint(rightPos)
        local leftV, leftOn = Camera:WorldToViewportPoint(leftPos)

        if not (topOn or bottomOn or rightOn or leftOn) then
            e.Box.Visible = false
            e.Name.Visible = false
            e.Health.Visible = false
            e.Dist.Visible = false
            continue
        end

        local height = math.abs(topV.Y - bottomV.Y)
        local width = math.abs(rightV.X - leftV.X)
        if height < 5 then height = 5 end
        if width < 5 then width = 5 end

        local centerX = (leftV.X + rightV.X) / 2
        local centerY = (topV.Y + bottomV.Y) / 2
        local dist = (Camera.CFrame.Position - root.Position).Magnitude

        if showBox then
            e.Box.Visible = true
            e.Box.Size = Vector2.new(width, height)
            e.Box.Position = Vector2.new(centerX - width / 2, centerY - height / 2)
            e.Box.Color = rainbow
        else
            e.Box.Visible = false
        end

        if showName then
            e.Name.Visible = true
            e.Name.Text = plr.Name
            e.Name.Position = Vector2.new(centerX, topV.Y - 15)
            e.Name.Color = rainbow
        else
            e.Name.Visible = false
        end

        if showHealth then
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum and hum.MaxHealth > 0 then
                local hp = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
                e.Health.Visible = true
                e.Health.Size = Vector2.new(2, height * hp)
                e.Health.Position = Vector2.new(centerX - width / 2 - 4, centerY + height / 2 - height * hp)
                e.Health.Color = Color3.fromRGB(255 * (1 - hp), 255 * hp, 0)
            else
                e.Health.Visible = false
            end
        else
            e.Health.Visible = false
        end

        if showTracers then
            e.Dist.Visible = true
            e.Dist.Text = math.floor(dist) .. "m"
            e.Dist.Position = Vector2.new(centerX, bottomV.Y + 15)
            e.Dist.Color = rainbow
        else
            e.Dist.Visible = false
        end
    end
end)

local function isMobile()
    return UIS.TouchEnabled and not UIS.MouseEnabled
end

local function isTablet()
    return UIS.TouchEnabled and UIS.MouseEnabled
end

local mobileButton = nil

if isMobile() or isTablet() then
    local btnGui = Instance.new("ScreenGui")
    btnGui.Parent = CG
    btnGui.Name = "SinyxWareButton"
    btnGui.ResetOnSpawn = false

    mobileButton = Instance.new("ImageButton")
    mobileButton.Size = UDim2.new(0, 50, 0, 50)
    mobileButton.Position = UDim2.new(1, -60, 0.5, -25)
    mobileButton.Image = "rbxassetid://73073995075962"
    mobileButton.BackgroundTransparency = 1
    mobileButton.Parent = btnGui

    local btnDrag = {active = false, start = nil, offset = nil}

    mobileButton.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            btnDrag.active = true
            btnDrag.start = input.Position
            btnDrag.offset = mobileButton.Position
        end
    end)

    mobileButton.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            btnDrag.active = false
        end
    end)

    UIS.InputChanged:Connect(function(input)
        if btnDrag.active and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - btnDrag.start
            mobileButton.Position = UDim2.new(
                btnDrag.offset.X.Scale,
                btnDrag.offset.X.Offset + delta.X,
                btnDrag.offset.Y.Scale,
                btnDrag.offset.Y.Offset + delta.Y
            )
        end
    end)

    local function toggleGUI()
        Root.Enabled = not Root.Enabled
        if Circle then Circle.Visible = Root.Enabled end
        if Circle2 then Circle2.Visible = Root.Enabled end
    end

    mobileButton.MouseButton1Click:Connect(toggleGUI)
    mobileButton.TouchTap:Connect(toggleGUI)
end

local function toggleGUI()
    Root.Enabled = not Root.Enabled
    if Circle then Circle.Visible = Root.Enabled end
    if Circle2 then Circle2.Visible = Root.Enabled end
end

UIS.InputBegan:Connect(function(i, gpe)
    if gpe then return end
    if i.KeyCode == Enum.KeyCode.LeftControl or i.KeyCode == Enum.KeyCode.RightControl then
        toggleGUI()
    end
    if i.KeyCode == Enum.KeyCode.Insert then
        toggleGUI()
    end
end)

local infiniteJump = false
local speedHack = false
local noClip = false
local speedValue = 50

local function getMiscState()
    for _, child in ipairs(MBody:GetChildren()) do
        if child:IsA("Frame") then
            local lbl = child:FindFirstChildOfClass("TextLabel")
            if lbl then
                local pill = child:FindFirstChildOfClass("TextButton")
                if pill then
                    if lbl.Text == "Infinite Jump" then
                        infiniteJump = pill.BackgroundColor3 == C.red
                    elseif lbl.Text == "Speed Hack" then
                        speedHack = pill.BackgroundColor3 == C.red
                    elseif lbl.Text == "No Clip" then
                        noClip = pill.BackgroundColor3 == C.red
                    end
                end
            end
        end
    end
end

RunService.Heartbeat:Connect(function()
    getMiscState()

    if infiniteJump and LP.Character and LP.Character:FindFirstChildOfClass("Humanoid") then
        local hum = LP.Character:FindFirstChildOfClass("Humanoid")
        hum:SetStateEnabled(Enum.HumanoidStateType.Jumping, true)
    end

    if speedHack and LP.Character and LP.Character:FindFirstChild("HumanoidRootPart") then
        local root = LP.Character.HumanoidRootPart
        local vel = root.AssemblyLinearVelocity
        local newVel = vel
        if vel.Magnitude > 0 then
            newVel = vel.Unit * speedValue
            root.AssemblyLinearVelocity = newVel
        end
    end

    if noClip and LP.Character then
        for _, part in ipairs(LP.Character:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
            end
        end
    end
end)

UIS.InputBegan:Connect(function(i, gpe)
    if gpe then return end
    if i.KeyCode == Enum.KeyCode.Space and infiniteJump and LP.Character and LP.Character:FindFirstChildOfClass("Humanoid") then
        local hum = LP.Character:FindFirstChildOfClass("Humanoid")
        hum:ChangeState(Enum.HumanoidStateType.Jumping)
    end
end)

Root.Enabled = true
