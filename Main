    infJumpEnabled = val
    if val then
        local c = LP.Character
        if c and c:FindFirstChild("Humanoid") then
            originalJumpPower = c.Humanoid.JumpPower
            c.Humanoid.JumpPower = 9999
            c.Humanoid:SetStateEnabled(Enum.HumanoidStateType.Jumping, true)
        end
    else
        local c = LP.Character
        if c and c:FindFirstChild("Humanoid") then c.Humanoid.JumpPower = originalJumpPower end
    end
end)
mkToggle(moveSection, "No Clip", false, function(val)
    noClipEnabled = val
    local c = LP.Character
    if c then
        for _,part in ipairs(c:GetDescendants()) do
            if part:IsA("BasePart") then part.CanCollide = not val end
        end
    end
end)

