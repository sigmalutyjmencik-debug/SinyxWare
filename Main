-- ---- AURA ----
local function applyPerfectAura(part)
    if part:FindFirstChild("EdgeAura") then
        part.EdgeAura:Destroy()
    end
    local particles = Instance.new("ParticleEmitter")
    particles.Name = "EdgeAura"
    particles.Color = ColorSequence.new(Color3.fromRGB(148, 0, 211))
    particles.LightEmission = 1
    particles.LightInfluence = 0
    particles.LockedToPart = true
    particles.Rate = 40
    particles.Lifetime = NumberRange.new(0.4, 0.6)
    particles.Speed = NumberRange.new(0, 0.2)
    particles.SpreadAngle = Vector2.new(180, 180)
    particles.Size = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 0.4),
        NumberSequenceKeypoint.new(0.4, 1.5),
        NumberSequenceKeypoint.new(1, 3.5)
    })
    particles.Transparency = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 0.1),
        NumberSequenceKeypoint.new(1, 1)
    })
    particles.Parent = part
    table.insert(activeEmitters, particles)
end

local function setupAura()
    for _, emitter in pairs(activeEmitters) do
        pcall(function() emitter:Destroy() end)
    end
    activeEmitters = {}
    local char = LP.Character
    if not char then return end
    auraCharacter = char
    for _, obj in pairs(char:GetDescendants()) do
        if obj:IsA("BasePart") and obj.Name ~= "HumanoidRootPart" then
            applyPerfectAura(obj)
        end
    end
end

local function removeAura()
    for _, emitter in pairs(activeEmitters) do
        pcall(function() emitter:Destroy() end)
    end
    activeEmitters = {}
end

-- Aura first/third person tracker
RunService.RenderStepped:Connect(function()
    if not auraEnabled or not auraCharacter then return end
    local head = auraCharacter:FindFirstChild("Head")
    if not head then return end
    local dist = (Camera.CFrame.Position - head.Position).Magnitude
    local shouldShow = dist >= 2
    for _, emitter in pairs(activeEmitters) do
        if emitter and emitter.Parent then
            emitter.Enabled = shouldShow
        end
    end
end)

-- Aura respawn support
LP.CharacterAdded:Connect(function(newChar)
    auraCharacter = newChar
    task.wait(0.5)
    if auraEnabled then
        setupAura()
    end
end)

-- ---- SKYBOX ----
local function applySkybox()
    for _, child in ipairs(Lighting:GetChildren()) do
        if child:IsA("Sky") then child:Destroy() end
    end
    galaxySkyObj = Instance.new("Sky")
    galaxySkyObj.Name = "PinkGalaxySky"
    local assetId = "rbxassetid://159454299"
    galaxySkyObj.SkyboxBk = assetId
    galaxySkyObj.SkyboxDn = assetId
    galaxySkyObj.SkyboxFt = assetId
    galaxySkyObj.SkyboxLf = assetId
    galaxySkyObj.SkyboxRt = assetId
    galaxySkyObj.SkyboxUp = assetId
    galaxySkyObj.Parent = Lighting
end

local function removeSkybox()
    if galaxySkyObj and galaxySkyObj.Parent then
        galaxySkyObj:Destroy()
        galaxySkyObj = nil
    end
end

-- ---- FOG ----
local function applyFog()
    if fogEnabled then
        Lighting.FogEnd = fogDistance
        Lighting.FogStart = fogDistance * 0.1
        Lighting.FogColor = Color3.fromRGB(200, 150, 200)
        Lighting.Fog = true
    end
end

local function removeFog()
    Lighting.Fog = false
end

-- ---- PULSE ----
local function createPulse()
    if pulseObject then
        pulseObject:Destroy()
        pulseObject = nil
    end
    if not pulseEnabled then return end
    
    pulseObject = Instance.new("Part")
    pulseObject.Name = "PulseEffect"
    pulseObject.Anchored = true
    pulseObject.CanCollide = false
    pulseObject.Material = Enum.Material.Neon
    pulseObject.Shape = Enum.PartType.Ball
    pulseObject.Color = Color3.fromRGB(255, 100, 200)
    pulseObject.Transparency = 0.5
    pulseObject.Size = Vector3.new(pulseSize, pulseSize, pulseSize)
    pulseObject.Parent = workspace
    
    local char = LP.Character
    if char and char:FindFirstChild("HumanoidRootPart") then
        pulseObject.Position = char.HumanoidRootPart.Position
    end
end

local function updatePulse()
    if pulseObject then
        pulseObject.Size = Vector3.new(pulseSize, pulseSize, pulseSize)
    end
end

local function removePulse()
    if pulseObject then
        pulseObject:Destroy()
        pulseObject = nil
    end
end

-- Pulse position update
RunService.RenderStepped:Connect(function()
    if pulseEnabled and pulseObject then
        local char = LP.Character
        if char and char:FindFirstChild("HumanoidRootPart") then
            pulseObject.Position = char.HumanoidRootPart.Position
        end
    end
end)

-- ---- PARTICLES ----
local function getParticleDelay()
    return 0.25 / particleMultiplier
end

local function spawnParticle(rootPart)
    if not ParticleFolder or not ParticleFolder.Parent then
        ParticleFolder = workspace:FindFirstChild("GlobalPinkParticles")
        if not ParticleFolder then
            ParticleFolder = Instance.new("Folder")
            ParticleFolder.Name = "GlobalPinkParticles"
            ParticleFolder.Parent = workspace
        end
    end
    local angle = math.rad(math.random(0, 360))
    local distance = math.random(5, 60)
    local spawnPos = rootPart.Position + Vector3.new(
        math.cos(angle) * distance,
        math.random(-10, 25),
        math.sin(angle) * distance
    )
    local sz = math.random(4, 12) / 10
    local p = Instance.new("Part")
    p.Shape = Enum.PartType.Ball
    p.Size = Vector3.new(sz, sz, sz)
    p.Position = spawnPos
    p.Material = Enum.Material.Neon
    p.Color = Color3.fromRGB(255, math.random(80, 180), math.random(150, 220))
    p.Transparency = 0.2
    p.Anchored = true
    p.CanCollide = false
    p.CastShadow = false
    p.Parent = ParticleFolder

    local targetPos = p.Position + Vector3.new(0, math.random(5, 15), 0)
    local tween = TS:Create(p, TweenInfo.new(3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        Position = targetPos,
        Transparency = 1,
        Size = Vector3.new(0.01, 0.01, 0.01)
    })
    tween:Play()
    tween.Completed:Connect(function() p:Destroy() end)
end

-- Particles loop
task.spawn(function()
    while true do
        local delay = getParticleDelay()
        task.wait(delay)
        if particlesEnabled then
            local char = LP.Character
            if char then
                local rootPart = char:FindFirstChild("HumanoidRootPart")
                if rootPart then
                    spawnParticle(rootPart)
                end
            end
        end
    end
end)

-- ================================================================
--  КОНФИГИ (ПОЛНОСТЬЮ ПЕРЕРАБОТАНЫ)
-- ================================================================
local configDir = "SinyxWare_Configs"
local configCache = {}

local function ensureConfigFolder()
    if not isfolder(configDir) then makefolder(configDir) end
end

local function getConfigList()
    ensureConfigFolder()
    local files = listfiles(configDir)
    local names = {}
    for _, file in ipairs(files) do
        local name = file:match("([^/\\]+)%.json$")
        if name then table.insert(names, name) end
    end
    return names
end

local function saveConfig(name)
    ensureConfigFolder()
    local config = {
        aimbot = {
            enabled = aimbotEnabled,
            circleEnabled = aimbotCircleEnabled,
            circleRadius = circleRadius,
            smoothness = smoothness,
            prediction = prediction,
            targetPart = targetPart,
            wallCheck = wallCheckEnabled
        },
        esp = {
            enabled = espEnabled,
            showBox = espShowBox,
            showName = espShowName,
            showHP = espShowHP,
            showDist = espShowDist,
            showTracer = espShowTracer
        },
        misc = {
            speedEnabled = speedHackEnabled,
            speedValue = speedValue,
            infJumpEnabled = infJumpEnabled,
            noClipEnabled = noClipEnabled
        },
        visuals = {
            auraEnabled = auraEnabled,
            skyboxEnabled = skyboxEnabled,
            particlesEnabled = particlesEnabled,
            particleMultiplier = particleMultiplier,
            fogEnabled = fogEnabled,
            fogDistance = fogDistance,
            pulseEnabled = pulseEnabled,
            pulseSize = pulseSize
        }
    }
    local path = configDir .. "/" .. name .. ".json"
    writefile(path, HttpService:JSONEncode(config))
    configCache[name] = config
    print("[SinyxWare] Config saved: " .. name)
    return true
end

local function loadConfig(name)
    local path = configDir .. "/" .. name .. ".json"
    if not isfile(path) then 
        print("[SinyxWare] Config not found: " .. name)
        return false 
    end
    
    local json = readfile(path)
    local config = HttpService:JSONDecode(json)
    configCache[name] = config
    
    -- Aimbot
    if config.aimbot then
        aimbotEnabled = config.aimbot.enabled or false
        aimbotCircleEnabled = config.aimbot.circleEnabled or false
        circleRadius = config.aimbot.circleRadius or 50
        smoothness = config.aimbot.smoothness or 50
        prediction = config.aimbot.prediction or 0
        targetPart = config.aimbot.targetPart or "Head"
        wallCheckEnabled = config.aimbot.wallCheck or false
    end
    
    -- ESP
    if config.esp then
        espEnabled = config.esp.enabled or false
        espShowBox = config.esp.showBox ~= false
        espShowName = config.esp.showName ~= false
        espShowHP = config.esp.showHP ~= false
        espShowDist = config.esp.showDist ~= false
        espShowTracer = config.esp.showTracer ~= false
    end
    
    -- Misc
    if config.misc then
        speedHackEnabled = config.misc.speedEnabled or false
        speedValue = config.misc.speedValue or 50
        infJumpEnabled = config.misc.infJumpEnabled or false
        noClipEnabled = config.misc.noClipEnabled or false
    end
    
    -- Visuals
    if config.visuals then
        auraEnabled = config.visuals.auraEnabled or false
        skyboxEnabled = config.visuals.skyboxEnabled or false
        particlesEnabled = config.visuals.particlesEnabled or false
        particleMultiplier = config.visuals.particleMultiplier or 5
        fogEnabled = config.visuals.fogEnabled or false
        fogDistance = config.visuals.fogDistance or 500
        pulseEnabled = config.visuals.pulseEnabled or false
        pulseSize = config.visuals.pulseSize or 5
    end
    
    -- Применяем загруженные настройки
    applyLoadedSettings()
    
    print("[SinyxWare] Config loaded: " .. name)
    return true
end

local function deleteConfig(name)
    local path = configDir .. "/" .. name .. ".json"
    if isfile(path) then
        delfile(path)
        configCache[name] = nil
        print("[SinyxWare] Config deleted: " .. name)
        return true
    end
    return false
end

local function applyLoadedSettings()
    -- Применяем Aimbot
    if aimbotEnabled then
        -- Аимбот уже включен через переменную
    end
    
    -- Применяем ESP
    if espEnabled then
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LP then createESP(player) end
        end
    end
    
    -- Применяем Visuals
    if auraEnabled then
        setupAura()
    else
        removeAura()
    end
    
    if skyboxEnabled then
        applySkybox()
    else
        removeSkybox()
    end
    
    if particlesEnabled then
        -- Particles already running in loop
    end
    
    if fogEnabled then
        applyFog()
    else
        removeFog()
    end
    
    if pulseEnabled then
        createPulse()
    else
        removePulse()
    end
    
    -- Применяем Misc
    if speedHackEnabled then
        local char = LP.Character
        if char and char:FindFirstChild("Humanoid") then
            char.Humanoid.WalkSpeed = speedValue
        end
    end
    
    if infJumpEnabled then
        local char = LP.Character
        if char and char:FindFirstChild("Humanoid") then
            originalJumpPower = char.Humanoid.JumpPower
            char.Humanoid.JumpPower = 9999
        end
    end
    
    if noClipEnabled then
        local char = LP.Character
        if char then
            for _, part in ipairs(char:GetDescendants()) do
                if part:IsA("BasePart") then part.CanCollide = false end
            end
        end
    end
end

