-- ================================================================
--  CROSSHAIR ФУНКЦИИ (встроены в Misc)
-- ================================================================
local function createCrosshair()
    removeCrosshair()
    local pg = LP:FindFirstChildOfClass("PlayerGui")
    if not pg then return end
    crosshairGui = Instance.new("ScreenGui")
    crosshairGui.Name = "CrossEffectGui"
    crosshairGui.ResetOnSpawn = false
    crosshairGui.Parent = pg

    local MainAnchor = Instance.new("Frame", crosshairGui)
    MainAnchor.Size = UDim2.new(0,0,0,0)
    MainAnchor.Position = UDim2.new(0.5,0,0.45,0)
    MainAnchor.AnchorPoint = Vector2.new(0.5,0.5)
    MainAnchor.BackgroundTransparency = 1

    local THICKNESS = 1.5
    local LENGTH = crosshairSize
    local FLAPS = crosshairSize
    local function createBranch(rotationAngle, isSwastika)
        local BranchAnchor = Instance.new("Frame", MainAnchor)
        BranchAnchor.Size = UDim2.new(0,0,0,0)
        BranchAnchor.BackgroundTransparency = 1
        BranchAnchor.Rotation = rotationAngle

        local MainLine = Instance.new("Frame", BranchAnchor)
        MainLine.Size = UDim2.new(0, LENGTH, 0, THICKNESS)
        MainLine.Position = UDim2.new(0,0,0,0)
        MainLine.AnchorPoint = Vector2.new(0,0.5)
        MainLine.BorderSizePixel = 0

        local FlapLine = nil
        if isSwastika then
            -- Свастика: дополнительная линия перпендикулярно в конце
            FlapLine = Instance.new("Frame", BranchAnchor)
            FlapLine.Size = UDim2.new(0, FLAPS, 0, THICKNESS)
            FlapLine.Position = UDim2.new(0, LENGTH, 0, -THICKNESS/2)
            FlapLine.AnchorPoint = Vector2.new(0,0.5)
            FlapLine.BorderSizePixel = 0
        end
        return MainLine, FlapLine
    end

    local isSwastika = (crosshairType == "Swastika")
    local lines = {}
    for _, angle in ipairs({0,90,180,270}) do
        local ml, fl = createBranch(angle, isSwastika)
        table.insert(lines, ml)
        if fl then table.insert(lines, fl) end
    end

    -- Цвет и вращение как в примере
    local currentRotation = 0
    local hue = 0
    if crosshairConnection then crosshairConnection:Disconnect() end
    crosshairConnection = RunService.RenderStepped:Connect(function(deltaTime)
        if not crosshairGui or not crosshairGui.Parent then
            crosshairConnection:Disconnect()
            return
        end
        currentRotation = currentRotation + (150 * deltaTime)
        if currentRotation >= 360 then currentRotation = currentRotation - 360 end
        MainAnchor.Rotation = currentRotation
        hue = hue + (0.1 * deltaTime)
        if hue > 1 then hue = hue - 1 end
        local col = Color3.fromHSV(hue, 1, 1)
        for _,line in ipairs(lines) do
            line.BackgroundColor3 = col
        end
    end)
end

local function removeCrosshair()
    if crosshairConnection then
        crosshairConnection:Disconnect()
        crosshairConnection = nil
    end
    if crosshairGui then
        crosshairGui:Destroy()
        crosshairGui = nil
    end
end

