-- РЎРєСЂС‹РІР°РµРј РЅР° РџРљ
if not MOBILE then mBtn.Visible=false end

-- Drag + toggle РєРЅРѕРїРєРё
local mbDrag={active=false,start=nil,offset=nil,moved=false}
mBtn.InputBegan:Connect(function(i)
    if i.UserInputType==Enum.UserInputType.Touch
    or i.UserInputType==Enum.UserInputType.MouseButton1 then
        mbDrag.active=true; mbDrag.start=i.Position
        mbDrag.offset=mBtn.Position; mbDrag.moved=false
    end
end)
mBtn.InputEnded:Connect(function(i)
    if i.UserInputType==Enum.UserInputType.Touch
    or i.UserInputType==Enum.UserInputType.MouseButton1 then
        mbDrag.active=false
        if not mbDrag.moved then
            Outer.Visible=not Outer.Visible
        end
    end
end)
UIS.InputChanged:Connect(function(i)
    if mbDrag.active and (i.UserInputType==Enum.UserInputType.Touch
    or i.UserInputType==Enum.UserInputType.MouseMovement) then
        local d=i.Position-mbDrag.start
        if d.Magnitude>6 then mbDrag.moved=true end
        mBtn.Position=UDim2.new(
            mbDrag.offset.X.Scale, mbDrag.offset.X.Offset+d.X,
            mbDrag.offset.Y.Scale, mbDrag.offset.Y.Offset+d.Y
        )
    end
end)

-- РџРљ: Insert
UIS.InputBegan:Connect(function(i,gpe)
    if gpe then return end
    if i.KeyCode==Enum.KeyCode.Insert then
        Outer.Visible=not Outer.Visible
    end
end)
