local function createButton(parent, text, pos, callback)
    local btn = Instance.new("TextButton", parent)
    btn.Size = UDim2.new(0, 70, 1, 0)
    btn.Position = UDim2.new(pos, 0, 0, 0)
    btn.BackgroundColor3 = C.red
    btn.Text = text
    btn.TextColor3 = C.white
    btn.Font = Enum.Font.Gotham
    btn.TextSize = 7
    btn.BorderSizePixel = 0
    corner(btn,2)
    btn.MouseButton1Click:Connect(callback)
    return btn
end
local listScrolling
local function updateConfigList()
    if not listScrolling then return end
    for _,child in ipairs(listScrolling:GetChildren()) do if child:IsA("TextButton") then child:Destroy() end end
    for _,name in ipairs(getConfigList()) do
        local btn = Instance.new("TextButton", listScrolling)
        btn.Size = UDim2.new(1,0,0,16)
        btn.BackgroundColor3 = C.panel
        btn.Text = name
        btn.TextColor3 = C.text
        btn.Font = Enum.Font.Gotham
        btn.TextSize = 7
        btn.BorderSizePixel = 0
        btn.TextXAlignment = Enum.TextXAlignment.Left
        btn.TextTruncate = Enum.TextTruncate.AtEnd
        corner(btn,1)
        btn.MouseButton1Click:Connect(function() nameInput.Text = name end)
    end
end

-- Р РѕРІРЅС‹Рµ РєРЅРѕРїРєРё: РѕРґРёРЅР°РєРѕРІС‹Р№ СЂР°Р·РјРµСЂ Рё РѕС‚СЃС‚СѓРїС‹
