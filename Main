-- ================================================================
--  ESP ЛОГИКА
-- ================================================================
local function getRainbowColor(speed)
    local frequency = speed or 2
    local time = tick() * frequency
    local r = math.sin(time + 0) * 127 + 128
    local g = math.sin(time + 2) * 127 + 128
    local b = math.sin(time + 4) * 127 + 128
    return Color3.fromRGB(r, g, b)
end

local function checkVisibility(targetCharacter)
    local localCharacter = LP.Character
    if not localCharacter or not localCharacter:FindFirstChild("HumanoidRootPart") then return false end
    if not targetCharacter or not targetCharacter:FindFirstChild("HumanoidRootPart") then return false end

    local origin = Camera.CFrame.Position
    local destination = targetCharacter.HumanoidRootPart.Position

    local raycastParams = RaycastParams.new()
    raycastParams.FilterType = Enum.RaycastFilterType.Exclude
    raycastParams.FilterDescendantsInstances = {localCharacter, targetCharacter, Camera}

    local result = workspace:Raycast(origin, destination - origin, raycastParams)
    return result == nil
end

local espObjects = {}

local function createESP(player)
    if player == LP then return end
    if espObjects[player] then return end

    local box = Drawing.new("Square")
    box.Thickness = 1.5
    box.Filled = false
    box.Transparency = 1
    box.Visible = false

    local hpBg = Drawing.new("Square")
    hpBg.Thickness = 1
    hpBg.Filled = true
    hpBg.Color = Color3.fromRGB(0, 0, 0)
    hpBg.Transparency = 1
    hpBg.Visible = false

    local hpBar = Drawing.new("Square")
    hpBar.Thickness = 1
    hpBar.Filled = true
    hpBar.Color = Color3.fromRGB(0, 255, 0)
    hpBar.Transparency = 1
    hpBar.Visible = false

    local nameLabel = Drawing.new("Text")
    nameLabel.Size = 13
    nameLabel.Center = true
    nameLabel.Outline = true
    nameLabel.Transparency = 1
    nameLabel.Visible = false

    local distLabel = Drawing.new("Text")
    distLabel.Size = 12
    distLabel.Center = true
    distLabel.Outline = true
    distLabel.Transparency = 1
    distLabel.Visible = false

    local tracer = Drawing.new("Line")
    tracer.Thickness = 1.5
    tracer.Transparency = 1
    tracer.Visible = false

    espObjects[player] = {box = box, hpBg = hpBg, hpBar = hpBar, nameLabel = nameLabel, distLabel = distLabel, tracer = tracer}

    local connection
    connection = RunService.RenderStepped:Connect(function()
        if not espEnabled or not player:IsDescendantOf(Players) then
            box.Visible = false
            hpBg.Visible = false
            hpBar.Visible = false
            nameLabel.Visible = false
            distLabel.Visible = false
            tracer.Visible = false
            if not player:IsDescendantOf(Players) then
                box:Remove()
                hpBg:Remove()
                hpBar:Remove()
                nameLabel:Remove()
                distLabel:Remove()
                tracer:Remove()
                connection:Disconnect()
                espObjects[player] = nil
            end
            return
        end

        local character = player.Character
        if not character or not character:FindFirstChild("HumanoidRootPart") or not character:FindFirstChild("Humanoid") then
            box.Visible = false
            hpBg.Visible = false
            hpBar.Visible = false
            nameLabel.Visible = false
            distLabel.Visible = false
            tracer.Visible = false
            return
        end

        local rootPart = character.HumanoidRootPart
        local humanoid = character.Humanoid

        local headCFrame = rootPart.CFrame * CFrame.new(0, 3, 0)
        local footCFrame = rootPart.CFrame * CFrame.new(0, -3.5, 0)

        local headPos, headOnScreen = Camera:WorldToViewportPoint(headCFrame.Position)
        local footPos, footOnScreen = Camera:WorldToViewportPoint(footCFrame.Position)
        local centerPos, centerOnScreen = Camera:WorldToViewportPoint(rootPart.Position)

        if headOnScreen and footOnScreen and humanoid.Health > 0 then
            local boxHeight = math.abs(headPos.Y - footPos.Y)
            local boxWidth = boxHeight * 0.6

            local boxX = headPos.X - (boxWidth / 2)
            local boxY = headPos.Y

            local rainbow = getRainbowColor(2)

            if espShowBox then
                box.Size = Vector2.new(boxWidth, boxHeight)
                box.Position = Vector2.new(boxX, boxY)
                box.Color = rainbow
                box.Visible = true
            else
                box.Visible = false
            end

            if espShowName then
                nameLabel.Text = player.Name
                nameLabel.Position = Vector2.new(centerPos.X, boxY - 16)
                nameLabel.Color = rainbow
                nameLabel.Visible = true
            else
                nameLabel.Visible = false
            end

            if espShowDist then
                if LP.Character and LP.Character:FindFirstChild("HumanoidRootPart") then
                    local distance = (rootPart.Position - LP.Character.HumanoidRootPart.Position).Magnitude
                    distLabel.Text = math.floor(distance) .. " studs"
                else
                    distLabel.Text = "--- studs"
                end
                distLabel.Position = Vector2.new(centerPos.X, boxY + boxHeight + 4)
                distLabel.Color = rainbow
                distLabel.Visible = true
            else
                distLabel.Visible = false
            end

            if espShowHP then
                local hpHeight = boxHeight * (humanoid.Health / humanoid.MaxHealth)
                hpBg.Size = Vector2.new(3, boxHeight)
                hpBg.Position = Vector2.new(boxX - 6, boxY)
                hpBg.Visible = true

                hpBar.Size = Vector2.new(3, hpHeight)
                hpBar.Position = Vector2.new(boxX - 6, boxY + (boxHeight - hpHeight))
                hpBar.Visible = true
            else
                hpBg.Visible = false
                hpBar.Visible = false
            end

            if espShowTracer then
                local isVisible = checkVisibility(character)
                tracer.Color = isVisible and Color3.fromRGB(0, 255, 0) or Color3.fromRGB(255, 0, 0)
                tracer.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                tracer.To = Vector2.new(headPos.X, headPos.Y)
                tracer.Visible = true
            else
                tracer.Visible = false
            end
        else
            box.Visible = false
            hpBg.Visible = false
            hpBar.Visible = false
            nameLabel.Visible = false
            distLabel.Visible = false
            tracer.Visible = false
        end
    end)
end

Players.PlayerAdded:Connect(function(player)
    if espEnabled then
        task.wait(0.5)
        createESP(player)
    end
end)

for _, player in ipairs(Players:GetPlayers()) do
    if espEnabled and player ~= LP then
        createESP(player)
    end
end

-- ================================================================
--  ВИЗУАЛЬНЫЕ ЭФФЕКТЫ
-- ================================================================
-- Pulse Effect
local pulseObjects = {}

local function startPulseEffect()
    if pulseObjects then
        for _, obj in ipairs(pulseObjects) do
            pcall(function() obj:Destroy() end)
        end
        pulseObjects = {}
    end
    
    if not pulseEnabled then return end
    
    local function createPulse()
        if not pulseEnabled then return end
        
        local pulse = Instance.new("Part")
        pulse.Name = "PulseEffect"
        pulse.Anchored = true
        pulse.CanCollide = false
        pulse.Transparency = 0.8
        pulse.Material = Enum.Material.Neon
        pulse.Shape = Enum.PartType.Ball
        pulse.Size = Vector3.new(1, 1, 1)
        pulse.Parent = workspace
        
        local color = getPulseColor()
        pulse.Color = color
        
        local startSize = 1
        local endSize = 20
        
        local tweenInfo = TweenInfo.new(pulseSpeed * 2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
        
        local tweenSize = TS:Create(pulse, tweenInfo, {Size = Vector3.new(endSize, endSize, endSize)})
        local tweenTrans = TS:Create(pulse, tweenInfo, {Transparency = 1})
        
        tweenSize:Play()
        tweenTrans:Play()
        
        tweenSize.Completed:Connect(function()
            pulse:Destroy()
        end)
        
        table.insert(pulseObjects, pulse)
    end
    
    task.spawn(function()
        while pulseEnabled do
            if LP.Character and LP.Character:FindFirstChild("HumanoidRootPart") then
                local pos = LP.Character.HumanoidRootPart.Position
                local pulse = Instance.new("Part")
                pulse.Name = "PulseEffect"
                pulse.Anchored = true
                pulse.CanCollide = false
                pulse.Transparency = 0.7
                pulse.Material = Enum.Material.Neon
                pulse.Shape = Enum.PartType.Ball
                pulse.Size = Vector3.new(1, 1, 1)
                pulse.Position = pos + Vector3.new(0, 1, 0)
                pulse.Parent = workspace
                
                local color = getPulseColor()
                pulse.Color = color
                
                local endSize = 30
                local tweenInfo = TweenInfo.new(pulseSpeed * 1.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
                local tweenSize = TS:Create(pulse, tweenInfo, {Size = Vector3.new(endSize, endSize, endSize)})
                local tweenTrans = TS:Create(pulse, tweenInfo, {Transparency = 1})
                
                tweenSize:Play()
                tweenTrans:Play()
                
                tweenSize.Completed:Connect(function()
                    pulse:Destroy()
                end)
                
                table.insert(pulseObjects, pulse)
            end
            task.wait(0.5)
        end
    end)
end

-- Skybox
local function applySkybox()
    local sky = Lighting:FindFirstChild("Sky")
    if not sky then
        sky = Instance.new("Sky", Lighting)
    end
    
    local id = skyboxes[skyboxType] or skyboxes.Default
    sky.SkyboxBk = id
    sky.SkyboxDn = id
    sky.SkyboxFt = id
    sky.SkyboxLf = id
    sky.SkyboxRt = id
    sky.SkyboxUp = id
end

local function resetSkybox()
    local sky = Lighting:FindFirstChild("Sky")
    if sky then
        sky:Destroy()
    end
end

-- Fog
local function applyFog()
    if fogEnabled then
        Lighting.FogEnd = fogDistance
        Lighting.FogStart = fogDistance * 0.1
        Lighting.FogColor = fogColor
        Lighting.Fog = true
    end
end

local function resetFog()
    Lighting.Fog = false
end

-- Aura
local activeEmitters = {}

local function applyPerfectAura(part)
    if part:FindFirstChild("EdgeAura") then
        part.EdgeAura:Destroy()
    end

    local particles = Instance.new("ParticleEmitter")
    particles.Name = "EdgeAura"
    particles.Color = ColorSequence.new(auraColor)
    particles.LightEmission = 1
    particles.LightInfluence = 0
    particles.LockedToPart = true
    particles.Rate = 40 
    particles.Lifetime = NumberRange.new(0.4, 0.6)
    particles.Speed = NumberRange.new(0, 0.2)
    particles.SpreadAngle = Vector2.new(180, 180)
    particles.Size = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 0.4),
        NumberSequenceKeypoint.new(0.4, 1.5),
        NumberSequenceKeypoint.new(1, 3.5)
    })
    particles.Transparency = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 0.1),
        NumberSequenceKeypoint.new(1, 1)
    })
    particles.Parent = part
    table.insert(activeEmitters, particles)
end

local function setupAura()
    local char = LP.Character
    if not char then return end
    
    -- Удаляем старые
    for _, emitter in ipairs(activeEmitters) do
        pcall(function() emitter:Destroy() end)
    end
    activeEmitters = {}
    
    if not auraEnabled then return end
    
    for _, obj in pairs(char:GetDescendants()) do
        if obj:IsA("BasePart") and obj.Name ~= "HumanoidRootPart" then
            applyPerfectAura(obj)
        end
    end
end

local function removeAura()
    for _, emitter in ipairs(activeEmitters) do
        pcall(function() emitter:Destroy() end)
    end
    activeEmitters = {}
end

-- Ambient
local function applyAmbient()
    if ambientEnabled then
        Lighting.Ambient = ambientColor
        Lighting.Brightness = 1.5
        Lighting.OutdoorAmbient = ambientColor
    end
end

local function resetAmbient()
    Lighting.Ambient = Color3.fromRGB(127, 127, 127)
    Lighting.Brightness = 1
    Lighting.OutdoorAmbient = Color3.fromRGB(127, 127, 127)
end

-- Particles
local particleObjects = {}

local function spawnParticles()
    if particleObjects then
        for _, obj in ipairs(particleObjects) do
            pcall(function() obj:Destroy() end)
        end
        particleObjects = {}
    end
    
    if not particlesEnabled then return end
    
    task.spawn(function()
        while particlesEnabled do
            local char = LP.Character
            if char and char:FindFirstChild("HumanoidRootPart") then
                local pos = char.HumanoidRootPart.Position
                
                local particle = Instance.new("Part")
                particle.Anchored = true
                particle.CanCollide = false
                particle.Size = Vector3.new(0.5, 0.5, 0.5)
                particle.Transparency = 0.5
                particle.Material = Enum.Material.Neon
                particle.Position = pos + Vector3.new(
                    math.random(-20, 20),
                    math.random(0, 10),
                    math.random(-20, 20)
                )
                
                if particleType == "Sparkles" then
                    particle.Color = Color3.fromRGB(255, 255, 255)
                    particle.Shape = Enum.PartType.Ball
                elseif particleType == "Stars" then
                    particle.Color = Color3.fromRGB(255, 255, 0)
                    particle.Shape = Enum.PartType.Block
                elseif particleType == "Flames" then
                    particle.Color = Color3.fromRGB(255, 100, 0)
                    particle.Shape = Enum.PartType.Ball
                elseif particleType == "Bubbles" then
                    particle.Color = Color3.fromRGB(0, 150, 255)
                    particle.Transparency = 0.8
                    particle.Shape = Enum.PartType.Ball
                elseif particleType == "Snow" then
                    particle.Color = Color3.fromRGB(255, 255, 255)
                    particle.Shape = Enum.PartType.Ball
                end
                
                particle.Parent = workspace
                table.insert(particleObjects, particle)
                
                task.wait(0.05)
            end
            task.wait(0.1)
        end
    end)
end

local function removeParticles()
    for _, obj in ipairs(particleObjects) do
        pcall(function() obj:Destroy() end)
    end
    particleObjects = {}
end

