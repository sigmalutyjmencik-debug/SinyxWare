KeyBtn.MouseButton1Click:Connect(function()
    keyAwait = true
    KeyBtn.Text = "..."
end)
KeyBtn.TouchTap:Connect(function()
    keyAwait = true
    KeyBtn.Text = "..."
end)

UIS.InputBegan:Connect(function(i, gpe)
    if gpe then return end
    if keyAwait and i.KeyCode ~= Enum.KeyCode.Unknown then
        cfg.aimKey = tostring(i.KeyCode):gsub("Enum.KeyCode.", "")
        KeyBtn.Text = cfg.aimKey
        keyAwait = false
    end
end)

