-- Табы
local TABS = {
    { n = "Combat",  ico = "✖" },
    { n = "Visuals", ico = "◎" },
    { n = "Misc",    ico = "◉" },
    { n = "Config",  ico = "≡" },
}

local TabBtns = {}
local currentTab = "Combat"
local TabContents = {}

local NavF = Instance.new("Frame", Sidebar)
NavF.Size = UDim2.new(1, 0, 1, -(26 * 1.2))
NavF.Position = UDim2.new(0, 0, 0, 26 * 1.2)
NavF.BackgroundTransparency = 1

local NavL = Instance.new("UIListLayout", NavF)
NavL.Padding = UDim.new(0, 0)
NavL.SortOrder = Enum.SortOrder.LayoutOrder

local function setTab(name)
    currentTab = name
    for n, t in pairs(TabBtns) do
        local on = n == name
        t.bar.BackgroundTransparency = on and 0 or 1
        t.ico.TextColor3  = on and C.red  or C.dim
        t.lbl.TextColor3  = on and C.white or C.dim
    end
    for n, f in pairs(TabContents) do
        f.Visible = n == name
    end
end

for i, tab in ipairs(TABS) do
    local btn = Instance.new("TextButton", NavF)
    btn.Size = UDim2.new(1, 0, 0, 22 * 1.2)
    btn.BackgroundTransparency = 1
    btn.Text = ""
    btn.AutoButtonColor = false
    btn.LayoutOrder = i

    local bar = Instance.new("Frame", btn)
    bar.Size = UDim2.new(0, 2, 0.65, 0)
    bar.Position = UDim2.new(0, 0, 0.175, 0)
    bar.BackgroundColor3 = C.red
    bar.BorderSizePixel  = 0
    bar.BackgroundTransparency = tab.n == "Combat" and 0 or 1
    Instance.new("UICorner", bar).CornerRadius = UDim.new(0, 1)

    local ico = Instance.new("TextLabel", btn)
    ico.Size = UDim2.new(0, 18 * 1.2, 1, 0)
    ico.Position = UDim2.new(0, 8 * 1.2, 0, 0)
    ico.BackgroundTransparency = 1
    ico.Text = tab.ico
    ico.Font = Enum.Font.GothamBold
    ico.TextSize = 8 * 1.2
    ico.TextColor3 = tab.n == "Combat" and C.red or C.dim

    local lbl = Instance.new("TextLabel", btn)
    lbl.Size = UDim2.new(1, -(28 * 1.2), 1, 0)
    lbl.Position = UDim2.new(0, 26 * 1.2, 0, 0)
    lbl.BackgroundTransparency = 1
    lbl.Text = tab.n
    lbl.Font = Enum.Font.Gotham
    lbl.TextSize = 7 * 1.2
    lbl.TextColor3 = tab.n == "Combat" and C.white or C.dim
    lbl.TextXAlignment = Enum.TextXAlignment.Left

    TabBtns[tab.n] = { bar = bar, ico = ico, lbl = lbl }

    btn.MouseButton1Click:Connect(function() setTab(tab.n) end)
end

